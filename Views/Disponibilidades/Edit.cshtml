@model TropiNailsPro.Models.Disponibilidad

@{
    ViewData["Title"] = "Editar horario";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-md-8 col-lg-6">

            <div class="card border-0 shadow rounded-4">

                <div class="card-body p-4 p-md-5">


                    <div class="text-center mb-4">

                        <div class="display-4">
                            ✏️
                        </div>

                        <h2 class="fw-bold mt-2">
                            Editar horario
                        </h2>

                        <p class="text-muted">
                            Actualiza la información de tu disponibilidad.
                        </p>

                    </div>



                    <form asp-action="Edit" method="post">


                        <input type="hidden" asp-for="Id" />


                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>




                        <!-- Fecha -->

                        <div class="mb-3">


                            <label asp-for="Fecha"
                                   class="form-label fw-semibold">

                                📅 Fecha disponible

                            </label>


                            <input asp-for="Fecha"
                                   id="Fecha"
                                   type="date"
                                   class="form-control rounded-3"
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")" />


                            <span asp-validation-for="Fecha"
                                  class="text-danger">
                            </span>


                        </div>




                        <!-- NUEVO SELECTOR DE HORA -->

                        <div class="mb-3">


                            @await Html.PartialAsync(
                                "_HoraPicker",
                                Model.Hora
                            )


                            <span asp-validation-for="Hora"
                                  class="text-danger">
                            </span>


                        </div>





                        <!-- Estado -->

                        <div class="form-check form-switch mb-4">


                            <input asp-for="Disponible"
                                   class="form-check-input" />


                            <label asp-for="Disponible"
                                   class="form-check-label fw-semibold">

                                Mantener horario activo

                            </label>


                        </div>






                        <!-- Nota -->

                        <div class="mb-4">


                            <label asp-for="Nota"
                                   class="form-label fw-semibold">

                                📝 Nota para clientas

                            </label>


                            <textarea asp-for="Nota"
                                      class="form-control rounded-3"
                                      rows="4"></textarea>


                            <span asp-validation-for="Nota"
                                  class="text-danger">
                            </span>


                        </div>






                        <div class="d-flex justify-content-between">


                            <a asp-action="Index"
                               class="btn btn-outline-secondary rounded-pill px-4">

                                ← Volver

                            </a>




                            <button type="submit"
                                    class="btn btn-primary rounded-pill px-4">

                                💾 Guardar cambios

                            </button>


                        </div>



                    </form>


                </div>

            </div>

        </div>

    </div>

</div>




@section Scripts {


    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <!-- CSS del selector -->

    <link rel="stylesheet"
          href="~/css/horaPicker.css" />



    <!-- JS del selector -->

    <script src="~/js/horaPicker.js"></script>



}