@model TropiNailsPro.Models.Disponibilidad

@{
    ViewData["Title"] = "Eliminar horario";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-md-7 col-lg-5">

            <div class="card border-0 shadow rounded-4">

                <div class="card-body p-4 p-md-5 text-center">

                    <div class="display-3 mb-3">
                        ⚠️
                    </div>

                    <h2 class="fw-bold text-danger">
                        Eliminar horario
                    </h2>

                    <p class="text-muted">
                        ¿Estás segura que deseas eliminar este horario disponible?
                    </p>

                    <div class="bg-light rounded-4 p-4 text-start my-4">

                        <div class="mb-3">

                            <small class="text-muted">
                                📅 Fecha
                            </small>

                            <div class="fw-bold">

                                @Model.Fecha.ToString(
                                    "dddd dd MMMM yyyy",
                                    new System.Globalization.CultureInfo("es-DO"))

                            </div>

                        </div>

                        <div class="mb-3">

                            <small class="text-muted">
                                ⏰ Hora
                            </small>

                            <div class="fw-bold">

                                @(DateTime.Today.Add(Model.Hora).ToString("hh:mm tt"))

                            </div>

                        </div>

                        <div>

                            <small class="text-muted">
                                Estado
                            </small>

                            @if (Model.Disponible)
                            {

                                <div class="text-success fw-bold">

                                    🟢 Disponible

                                </div>

                            }
                            else
                            {

                                <div class="text-danger fw-bold">

                                    🔴 No disponible

                                </div>

                            }

                        </div>

                    </div>

                    <form asp-action="Delete"
                          method="post">

                        <input type="hidden"
                               asp-for="Id" />

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary rounded-pill px-4">

                                Cancelar

                            </a>

                            <button type="submit"
                                    class="btn btn-danger rounded-pill px-4">

                                🗑 Eliminar

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>