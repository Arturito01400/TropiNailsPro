@model TropiNailsPro.Models.Disponibilidad

@{
    ViewData["Title"] = "Crear disponibilidad";
}


<div class="container py-5">


    <div class="row justify-content-center">


        <div class="col-12 col-md-8 col-lg-6">


            <div class="card border-0 shadow rounded-4">


                <div class="card-body p-4 p-md-5">


                    <div class="text-center mb-4">

                        <div class="display-4">
                            💅
                        </div>


                        <h2 class="fw-bold mt-2">
                            Nuevo horario disponible
                        </h2>


                        <p class="text-muted">
                            Agrega un espacio donde tus clientas puedan reservar una cita.
                        </p>

                    </div>



                    <form asp-action="Create" method="post">


                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>



                        <!-- Fecha -->

                        <div class="mb-3">

                            <label asp-for="Fecha"
                                   class="form-label fw-semibold">

                                📅 Fecha disponible

                            </label>


                            <input asp-for="Fecha"
                                   type="date"
                                   class="form-control rounded-3" />


                            <span asp-validation-for="Fecha"
                                  class="text-danger">
                            </span>

                        </div>




                        <!-- Hora -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">

                                ⏰ Hora disponible

                            </label>

                            <div class="row">

                                <div class="col-4">

                                    <select id="hora" class="form-select rounded-3">

                                        @for (int i = 1; i <= 12; i++)
                                        {
                                            <option value="@i">@i</option>
                                        }

                                    </select>

                                </div>

                                <div class="col-4">

                                    <select id="minuto" class="form-select rounded-3">

                                        @for (int i = 0; i < 60; i += 5)
                                        {
                                            <option value="@i.ToString("D2")">
                                                @i.ToString("D2")
                                            </option>
                                        }

                                    </select>

                                </div>

                                <div class="col-4">

                                    <select id="periodo" class="form-select rounded-3">

                                        <option value="AM">AM</option>
                                        <option value="PM">PM</option>

                                    </select>

                                </div>

                            </div>

                            <input asp-for="Hora"
                                   id="HoraHidden"
                                   type="hidden" />

                            <span asp-validation-for="Hora"
                                  class="text-danger">
                            </span>

                        </div>





                        <!-- Disponible -->


                        <div class="form-check form-switch mb-4">


                            <input asp-for="Disponible"
                                   class="form-check-input"
                                   checked />


                            <label asp-for="Disponible"
                                   class="form-check-label fw-semibold">

                                Horario activo para clientas

                            </label>


                        </div>





                        <!-- Nota -->

                        <div class="mb-4">


                            <label asp-for="Nota"
                                   class="form-label fw-semibold">

                                📝 Nota para la clienta

                            </label>


                            <textarea asp-for="Nota"
                                      class="form-control rounded-3"
                                      rows="4"
                                      placeholder="Ejemplo: Diseños personalizados, traer referencia, etc."></textarea>


                            <span asp-validation-for="Nota"
                                  class="text-danger">
                            </span>


                        </div>





                        <div class="d-flex justify-content-between">


                            <a asp-action="Index"
                               class="btn btn-outline-secondary rounded-pill px-4">

                                ← Volver

                            </a>




                            <button type="submit"
                                    class="btn btn-primary rounded-pill px-4 shadow-sm">

                                💾 Guardar horario

                            </button>


                        </div>



                    </form>


                </div>


            </div>


        </div>


    </div>


</div>




@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document.querySelector("form").addEventListener("submit", function () {

            let hora = parseInt(document.getElementById("hora").value);

            let minuto = document.getElementById("minuto").value;

            let periodo = document.getElementById("periodo").value;

            if (periodo === "PM" && hora < 12)
                hora += 12;

            if (periodo === "AM" && hora === 12)
                hora = 0;

            let hora24 = hora.toString().padStart(2, '0');

            document.getElementById("HoraHidden").value = hora24 + ":" + minuto + ":00";

        });

    </script>

}