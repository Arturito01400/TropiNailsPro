@model TropiNailsPro.Models.Usuario
@using System.Security.Claims

@{
    var usuarioActual = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    string foto = Model?.FotoPerfilUrl ?? "/img/user-default.png";

    if (string.IsNullOrWhiteSpace(foto))
    {
        foto = "/img/user-default.png";
    }

    string nombre = !string.IsNullOrWhiteSpace(Model?.Nombre)
        ? Model.Nombre
        : "Usuario";

    int usuarioId = Model?.Id ?? 0;

    var publicaciones =
        ViewBag.CatalogoPersonal
        as List<TropiNailsPro.Models.Publicacion>
        ?? new List<TropiNailsPro.Models.Publicacion>();


    // =========================================================
    // REDES SOCIALES
    // Convierte automáticamente usuario, @usuario o URL
    // en un enlace real.
    // =========================================================

    string instagramUrl = null;

    if (!string.IsNullOrWhiteSpace(Model?.Instagram))
    {
        string instagram = Model.Instagram.Trim();

        if (instagram.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            instagram.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            instagramUrl = instagram;
        }
        else
        {
            instagram = instagram.Trim();

            if (instagram.StartsWith("@"))
            {
                instagram = instagram.Substring(1);
            }

            instagram = instagram.Trim('/');

            if (instagram.Contains("instagram.com/", StringComparison.OrdinalIgnoreCase))
            {
                instagramUrl = "https://" + instagram;
            }
            else
            {
                instagramUrl = "https://www.instagram.com/" + instagram;
            }
        }
    }


    string tiktokUrl = null;

    if (!string.IsNullOrWhiteSpace(Model?.TikTok))
    {
        string tiktok = Model.TikTok.Trim();

        if (tiktok.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            tiktok.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            tiktokUrl = tiktok;
        }
        else
        {
            if (tiktok.StartsWith("@"))
            {
                tiktok = tiktok.Substring(1);
            }

            tiktok = tiktok.Trim('/');

            if (tiktok.Contains("tiktok.com/", StringComparison.OrdinalIgnoreCase))
            {
                tiktokUrl = "https://" + tiktok;
            }
            else
            {
                tiktokUrl = "https://www.tiktok.com/@" + tiktok;
            }
        }
    }


    string facebookUrl = null;

    if (!string.IsNullOrWhiteSpace(Model?.Facebook))
    {
        string facebook = Model.Facebook.Trim();

        if (facebook.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            facebook.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            facebookUrl = facebook;
        }
        else
        {
            facebook = facebook.Trim('/');

            if (facebook.Contains("facebook.com/", StringComparison.OrdinalIgnoreCase))
            {
                facebookUrl = "https://" + facebook;
            }
            else
            {
                facebookUrl = "https://www.facebook.com/" + facebook;
            }
        }
    }


    string whatsappUrl = null;

    if (!string.IsNullOrWhiteSpace(Model?.WhatsApp))
    {
        string whatsapp = Model.WhatsApp.Trim();

        if (whatsapp.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            whatsapp.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            whatsappUrl = whatsapp;
        }
        else
        {
            string numeroWhatsApp = new string(
                whatsapp.Where(char.IsDigit).ToArray()
            );

            if (!string.IsNullOrWhiteSpace(numeroWhatsApp))
            {
                string mensajeWhatsApp =
                    "Hola, vi tu perfil en TropiNails Pro y me gustaría reservar una cita. 💅";

                whatsappUrl =
                    $"https://wa.me/{numeroWhatsApp}?text={Uri.EscapeDataString(mensajeWhatsApp)}";
            }
        }
    }
}


<!-- ================= PERFIL ================= -->

<div class="perfil-header">

    <div class="foto-wrapper">

        <img src="@foto"
             class="foto-perfil"
             onclick="abrirFotoPerfil('@foto')"
             onerror="this.src='/img/user-default.png'" />

    </div>


    <h3>@nombre</h3>

    <p class="estado">
        🟢 Activo
    </p>


    <!-- ================= DATOS ================= -->

    <div class="datos-perfil">

        <p>
            <b>Usuario:</b>

            @(Model?.UsuarioLogin ?? "No definido")
        </p>


        <!-- INSTAGRAM -->

        <p>
            <b>Instagram:</b>

            @if (!string.IsNullOrWhiteSpace(instagramUrl))
            {
                <a href="@instagramUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="red-social-link instagram-link">

                    📸 Instagram

                </a>
            }
            else
            {
                <span>No registrado</span>
            }
        </p>


        <!-- TIKTOK -->

        <p>
            <b>TikTok:</b>

            @if (!string.IsNullOrWhiteSpace(tiktokUrl))
            {
                <a href="@tiktokUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="red-social-link tiktok-link">

                    🎵 TikTok

                </a>
            }
            else
            {
                <span>No registrado</span>
            }
        </p>


        <!-- FACEBOOK -->

        <p>
            <b>Facebook:</b>

            @if (!string.IsNullOrWhiteSpace(facebookUrl))
            {
                <a href="@facebookUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="red-social-link facebook-link">

                    📘 Facebook

                </a>
            }
            else
            {
                <span>No registrado</span>
            }
        </p>


        <!-- WHATSAPP -->

        <p>
            <b>WhatsApp:</b>

            @if (!string.IsNullOrWhiteSpace(whatsappUrl))
            {
                <a href="@whatsappUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="red-social-link whatsapp-link">

                    💬 Enviar mensaje

                </a>
            }
            else
            {
                <span>No registrado</span>
            }
        </p>


        <!-- TELÉFONO -->

        <p>
            <b>Teléfono:</b>

            @(Model?.Telefono ?? "No registrado")
        </p>

    </div>


    <!-- ================= STATS ================= -->

    <div class="stats">

        <a href="/Seguidores/Lista/@usuarioId">

            <b id="contadorSeguidores">0</b>

            <br />

            Seguidores

        </a>


        <a href="/Seguidores/VistaSiguiendo"
           class="stat-box">

            <b id="contadorSiguiendo">0</b>

            <br />

            Siguiendo

        </a>


        <div>

            <b id="contadorCatalogos">
                @publicaciones.Count
            </b>

            <br />

            Publicaciones

        </div>

    </div>

</div>


<!-- ================= TITULO ================= -->

<h2 class="titulo">

    🌸 Publicaciones

</h2>


<!-- ================= GRID ================= -->

<div class="grid-catalogo">

@foreach (var post in publicaciones)
{
    string mediaUrl =
        string.IsNullOrWhiteSpace(post?.MediaUrl)
        ? "/img/user-default.png"
        : post.MediaUrl;


    string tipoMedia =
        string.IsNullOrWhiteSpace(post?.TipoMedia)
        ? "imagen"
        : post.TipoMedia.ToLower();


    <div class="post-card">

        <div class="post-media">

            @if (tipoMedia.Contains("video"))
            {
                <video controls
                       muted
                       class="media">

                    <source src="@mediaUrl"
                            type="video/mp4" />

                </video>
            }
            else
            {
                <img src="@mediaUrl"
                     class="media"
                     onclick="abrirVisor('@mediaUrl')"
                     onerror="this.src='/img/user-default.png'" />
            }

        </div>


        <div class="post-body">

            <a href="/Catalogos/Perfil/@post.UsuarioId"
               class="usuario-link">

                @(post?.Usuario?.Nombre ?? nombre)

            </a>


            <div class="fecha">

                @(post?.Fecha.ToString("dd/MM/yyyy HH:mm")
                    ?? "Sin fecha")

            </div>


            <!-- ================= REACCIONES ================= -->

            <div class="reacciones">

                <button class="btn-react like"
                        onclick="darLike(@post.Id, this)">

                    ❤️ <span>Like</span>

                </button>


                <button class="btn-react comment"
                        onclick="verComentarios(@post.Id)">

                    💬 <span>Comentar</span>

                </button>


                <button class="btn-react share"
                        onclick="compartir('@mediaUrl')">

                    🔗 <span>Compartir</span>

                </button>

            </div>


            <div class="stats-post"
                 id="stats-@post.Id">

                ❤️ @(post?.Likes?.Count ?? 0)

                •

                💬 @(post?.Comentarios?.Count ?? 0)

            </div>

        </div>

    </div>
}

</div>


<!-- ================= VISOR ================= -->

<div id="visorMedia"
     class="visor-media"
     onclick="cerrarVisor()">

    <img id="visorImg" />

</div>


<!-- ================= FOTO PERFIL ================= -->

<div id="visorFotoPerfil"
     class="visor-historias"
     onclick="cerrarFotoPerfil()">

    <img id="fotoPerfilGrande">

</div>


<style>

/* =========================================================
   PERFIL
   ========================================================= */

body{
    background:#f5f7fb;
    font-family:Segoe UI;
}


.perfil-header{
    text-align:center;
    max-width:750px;
    margin:25px auto;
    padding:20px;
    background:#fff;
    border-radius:18px;
    box-shadow:0 4px 18px rgba(0,0,0,.08);
}


.foto-wrapper{
    display:flex;
    justify-content:center;
}


.foto-perfil{
    width:135px;
    height:135px;
    border-radius:50%;
    object-fit:cover;
    border:4px solid #ff4da6;
    cursor:pointer;
    transition:.3s;
}


.foto-perfil:hover{
    transform:scale(1.05);
}


.estado{
    color:#12a150;
    font-weight:600;
}


/* =========================================================
   DATOS
   ========================================================= */

.datos-perfil{
    text-align:left;
    margin-top:15px;
}


.datos-perfil p{
    margin-bottom:14px;
}


.datos-perfil a{
    color:#ff4da6;
    font-weight:600;
    text-decoration:none;
}


/* =========================================================
   REDES SOCIALES
   ========================================================= */

.red-social-link{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:7px 13px;
    border-radius:12px;
    transition:.2s;
}


.red-social-link:hover{
    transform:translateY(-2px);
    text-decoration:none;
}


.instagram-link{
    background:#fff0f7;
    color:#d62978 !important;
}


.tiktok-link{
    background:#f2f2f2;
    color:#111 !important;
}


.facebook-link{
    background:#edf4ff;
    color:#1877f2 !important;
}


.whatsapp-link{
    background:#e9fff0;
    color:#159447 !important;
}


/* =========================================================
   STATS
   ========================================================= */

.stats{
    display:flex;
    justify-content:center;
    gap:25px;
    flex-wrap:wrap;
    margin-top:10px;
}


.stats a,
.stats > div{
    text-decoration:none;
    color:#333;
}


.stats b{
    color:#ff4da6;
    font-size:20px;
}


/* =========================================================
   GRID
   ========================================================= */

.grid-catalogo{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
    max-width:1200px;
    margin:auto;
    padding:15px;
}


.post-card{
    background:#fff;
    border-radius:15px;
    overflow:hidden;
    box-shadow:0 4px 15px rgba(0,0,0,.08);
}


.media{
    width:100%;
    height:380px;
    object-fit:cover;
    cursor:pointer;
}


.reacciones{
    display:flex;
    justify-content:space-around;
    padding:12px;
    gap:8px;
    flex-wrap:wrap;
}


.btn-react{
    border:none;
    padding:8px 12px;
    border-radius:20px;
    cursor:pointer;
    background:#f2f2f2;
    transition:.2s;
}


.btn-react:hover{
    transform:scale(1.05);
}


.like{
    background:#ffe6ef;
}


.comment{
    background:#e6f0ff;
}


.share{
    background:#e6ffe9;
}


/* =========================================================
   VISOR
   ========================================================= */

.visor-media,
.visor-historias{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.95);
    justify-content:center;
    align-items:center;
    z-index:9999;
}


.visor-media img,
#fotoPerfilGrande{
    max-width:90%;
    max-height:90%;
    border-radius:12px;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@@media(max-width:992px){

    .grid-catalogo{
        grid-template-columns:repeat(2,1fr);
    }

}


@@media(max-width:600px){

    .grid-catalogo{
        grid-template-columns:1fr;
    }


    .perfil-header{
        margin:15px 10px;
        padding:18px 14px;
    }


    .foto-perfil{
        width:120px;
        height:120px;
    }


    .red-social-link{
        padding:6px 10px;
    }

}

</style>


<script>

const usuarioId = parseInt("@usuarioId") || 0;


/* =========================================================
   LIKE
   ========================================================= */

async function darLike(id, btn){

    try{

        const res = await fetch(
            "/Publicaciones/Like/" + id,
            {
                method:"POST"
            }
        );


        if(!res.ok) return;


        const statsRes =
            await fetch(
                "/Publicaciones/Stats/" + id
            );


        const post =
            await statsRes.json();


        const stats =
            document.getElementById(
                "stats-" + id
            );


        if(post && stats){

            stats.innerText =
                `❤️ ${post.likes} • 💬 ${post.comentarios}`;

        }


        if(btn){

            btn.disabled = true;


            setTimeout(() => {

                btn.disabled = false;

            }, 800);

        }

    }catch(e){

        console.log(e);

    }

}


/* =========================================================
   COMENTARIOS
   ========================================================= */

function verComentarios(id){

    window.location.href =
        "/Comentarios/Ver/" + id;

}


/* =========================================================
   COMPARTIR
   ========================================================= */

function compartir(url){

    let enlace = url;


    if(!url.startsWith("http")){

        enlace =
            window.location.origin +
            (url.startsWith("/") ? url : "/" + url);

    }


    if(navigator.clipboard){

        navigator.clipboard.writeText(enlace);

        alert("Link copiado");

    }else{

        alert(enlace);

    }

}


/* =========================================================
   SEGUIDORES
   ========================================================= */

async function cargarSeguidores(){

    try{

        const res =
            await fetch(
                `/Seguidores/Resumen?usuarioId=${usuarioId}`
            );


        if(!res.ok) return;


        const data =
            await res.json();


        document.getElementById(
            "contadorSeguidores"
        ).innerText =
            data.seguidores || 0;


        document.getElementById(
            "contadorSiguiendo"
        ).innerText =
            data.siguiendo || 0;

    }catch(e){

        console.log(e);

    }

}


/* =========================================================
   VISOR
   ========================================================= */

function abrirVisor(url){

    const visor =
        document.getElementById(
            "visorMedia"
        );


    const img =
        document.getElementById(
            "visorImg"
        );


    if(!visor || !img) return;


    img.src = url;

    visor.style.display = "flex";

}


function cerrarVisor(){

    const visor =
        document.getElementById(
            "visorMedia"
        );


    if(visor){

        visor.style.display = "none";

    }

}


/* =========================================================
   FOTO PERFIL
   ========================================================= */

function abrirFotoPerfil(url){

    const visor =
        document.getElementById(
            "visorFotoPerfil"
        );


    const img =
        document.getElementById(
            "fotoPerfilGrande"
        );


    if(!visor || !img) return;


    img.src = url;

    visor.style.display = "flex";

}


function cerrarFotoPerfil(){

    const visor =
        document.getElementById(
            "visorFotoPerfil"
        );


    if(visor){

        visor.style.display = "none";

    }

}


/* =========================================================
   INICIO
   ========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    function(){

        cargarSeguidores();

    }
);

</script>