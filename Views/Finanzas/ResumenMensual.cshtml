@model List<TropiNailsPro.ViewModels.ResumenMensualViewModel>

@{
    ViewData["Title"] = "Resumen Financiero";

    decimal totalIngresos = Model.Sum(x => x.TotalIngresos);
    decimal totalGastosNegocio = Model.Sum(x => x.TotalGastosNegocio);
    decimal totalGastosPersonales = Model.Sum(x => x.TotalGastosPersonales);
    decimal gananciaTotal = Model.Sum(x => x.Ganancia);
    decimal promedioGanancia = 
    Model.Count > 0 
    ? Model.Sum(x => x.Ganancia) / Model.Count 
    : 0;


var mejorMes = Model
    .OrderByDescending(x => x.Ganancia)
    .FirstOrDefault();


var mesMayorIngreso = Model
    .OrderByDescending(x => x.TotalIngresos)
    .FirstOrDefault();
}


<style>

    .finanzas-container {
        padding: 35px 15px;
    }


    .finanzas-title {
        text-align:center;
        font-size:38px;
        font-weight:800;
        margin-bottom:10px;
        background:linear-gradient(
            45deg,
            #ff4da6,
            #8a2be2
        );
        -webkit-background-clip:text;
        -webkit-text-fill-color:transparent;
    }


    .finanzas-subtitle {
        text-align:center;
        color:#777;
        margin-bottom:35px;
        font-size:18px;
    }



    .resumen-grid {

        display:grid;
        grid-template-columns:repeat(
            auto-fit,
            minmax(230px,1fr)
        );

        gap:25px;
        margin-bottom:45px;

    }



    .resumen-card {

        border-radius:30px;
        padding:30px;
        color:white;
        min-height:170px;
        position:relative;
        overflow:hidden;
        box-shadow:
        0 15px 35px rgba(0,0,0,.15);

        transition:.35s;

    }


    .resumen-card:hover {

        transform:translateY(-8px);

        box-shadow:
        0 25px 50px rgba(0,0,0,.25);

    }



    .resumen-card h5 {

        font-size:18px;
        opacity:.9;
        margin-bottom:15px;

    }



    .resumen-card h2 {

        font-size:32px;
        font-weight:800;

    }



    .resumen-icon {

        position:absolute;
        right:25px;
        top:20px;
        font-size:45px;
        opacity:.25;

    }




    .card-ingresos {

        background:
        linear-gradient(
        135deg,
        #ff4da6,
        #ff85c2);

    }


    .card-negocio {

        background:
        linear-gradient(
        135deg,
        #667eea,
        #764ba2);

    }



    .card-personal {

        background:
        linear-gradient(
        135deg,
        #11998e,
        #38ef7d);

    }



    .card-ganancia {

        background:
        linear-gradient(
        135deg,
        #f7971e,
        #ffd200);

    }

    .dashboard-final {

    margin-top:60px;

    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(300px,1fr));

    gap:30px;

}



.final-card {

    border-radius:35px;

    padding:35px;

    color:white;

    position:relative;

    overflow:hidden;

    box-shadow:
    0 20px 50px rgba(0,0,0,.15);

    transition:.4s;

}



.final-card:hover {

    transform:translateY(-10px);

}



.final-card::after {

    content:"";

    position:absolute;

    width:200px;

    height:200px;

    background:white;

    opacity:.12;

    border-radius:50%;

    right:-70px;

    bottom:-70px;

}



.final-icon {

    font-size:45px;

    margin-bottom:15px;

}



.final-card h3 {

    font-size:18px;

    opacity:.9;

}



.final-card h1 {

    font-size:35px;

    font-weight:900;

}



.mejor-mes {

    background:
    linear-gradient(135deg,#f7971e,#ffd200);

}



.promedio {

    background:
    linear-gradient(135deg,#667eea,#764ba2);

}



.mayor-ingreso {

    background:
    linear-gradient(135deg,#11998e,#38ef7d);

}



.mensaje-financiero {

    margin-top:40px;

    padding:35px;

    border-radius:35px;

    background:
    linear-gradient(
    135deg,
    #ff4da6,
    #8a2be2
    );

    color:white;

    text-align:center;

    box-shadow:
    0 20px 50px rgba(0,0,0,.2);

}



.mensaje-financiero h2 {

    font-size:32px;

    font-weight:900;

}


.mensaje-financiero p {

    font-size:18px;

}



    @@media(max-width:600px){

        .finanzas-title{

            font-size:30px;

        }


        .resumen-card h2{

            font-size:25px;

        }

    }


</style>



<div class="container finanzas-container">


    <h1 class="finanzas-title">
        📊 Resumen Financiero
    </h1>


    <p class="finanzas-subtitle">
        Controla tus ingresos, gastos y ganancias de tu negocio
    </p>



    <div class="resumen-grid">



        <div class="resumen-card card-ingresos">

            <div class="resumen-icon">
                💰
            </div>

            <h5>
                Total Ingresos
            </h5>

            <h2>
                @totalIngresos.ToString("C")
            </h2>

        </div>




        <div class="resumen-card card-negocio">

            <div class="resumen-icon">
                💼
            </div>

            <h5>
                Gastos Negocio
            </h5>

            <h2>
                @totalGastosNegocio.ToString("C")
            </h2>

        </div>




        <div class="resumen-card card-personal">

            <div class="resumen-icon">
                👤
            </div>

            <h5>
                Gastos Personales
            </h5>

            <h2>
                @totalGastosPersonales.ToString("C")
            </h2>

        </div>




        <div class="resumen-card card-ganancia">

            <div class="resumen-icon">
                🏆
            </div>

            <h5>
                Ganancia Total
            </h5>

            <h2>
                @gananciaTotal.ToString("C")
            </h2>

        </div>


    </div>

    <style>

    .meses-title {

        text-align:center;
        font-size:30px;
        font-weight:800;
        margin:40px 0 30px;
        color:#444;

    }



    .meses-grid {

        display:grid;

        grid-template-columns:
        repeat(auto-fit,minmax(300px,1fr));

        gap:30px;

    }



    .mes-card {

        border-radius:35px;

        padding:30px;

        color:white;

        position:relative;

        overflow:hidden;

        min-height:330px;

        box-shadow:
        0 18px 45px rgba(0,0,0,.18);

        transition:.4s;

    }



    .mes-card:hover {

        transform:
        translateY(-12px)
        scale(1.02);

    }



    .mes-card::before {

        content:"";

        position:absolute;

        width:180px;

        height:180px;

        background:white;

        opacity:.12;

        border-radius:50%;

        right:-50px;

        top:-50px;

    }



    .mes-nombre {

        font-size:28px;

        font-weight:900;

        text-transform:uppercase;

        margin-bottom:25px;

    }



    .dato-finanza {

        display:flex;

        justify-content:space-between;

        margin-bottom:12px;

        font-size:16px;

    }



    .dato-finanza strong {

        font-size:17px;

    }



    .ganancia-box {

        margin-top:25px;

        padding:18px;

        border-radius:25px;

        background:
        rgba(255,255,255,.18);

        backdrop-filter:blur(10px);

        text-align:center;

    }



    .ganancia-box span {

        display:block;

        font-size:14px;

        opacity:.9;

    }



    .ganancia-box h3 {

        margin:5px 0;

        font-size:30px;

        font-weight:900;

    }



    /* COLORES POR MES */


    .enero {

        background:
        linear-gradient(135deg,#ff758c,#ff7eb3);

    }


    .febrero {

        background:
        linear-gradient(135deg,#667eea,#764ba2);

    }


    .marzo {

        background:
        linear-gradient(135deg,#11998e,#38ef7d);

    }


    .abril {

        background:
        linear-gradient(135deg,#f7971e,#ffd200);

    }


    .mayo {

        background:
        linear-gradient(135deg,#00c6ff,#0072ff);

    }


    .junio {

        background:
        linear-gradient(135deg,#fc466b,#3f5efb);

    }


    .julio {

        background:
        linear-gradient(135deg,#8360c3,#2ebf91);

    }


    .agosto {

        background:
        linear-gradient(135deg,#ee9ca7,#ffdde1);

    }


    .septiembre {

        background:
        linear-gradient(135deg,#614385,#516395);

    }


    .octubre {

        background:
        linear-gradient(135deg,#f12711,#f5af19);

    }


    .noviembre {

        background:
        linear-gradient(135deg,#c471f5,#fa71cd);

    }


    .diciembre {

        background:
        linear-gradient(135deg,#141e30,#243b55);

    }

    .indicadores-financieros {

    margin-top:25px;

}



.estado-negocio {

    text-align:center;

    margin-bottom:15px;

    font-weight:800;

    font-size:18px;

}



.estado-excelente {

    color:#d4ffda;

}



.estado-bueno {

    color:#fff4b0;

}



.estado-cuidado {

    color:#ffd0d0;

}



.barra-fondo {

    width:100%;

    height:12px;

    background:rgba(255,255,255,.25);

    border-radius:20px;

    overflow:hidden;

    margin-top:8px;

}



.barra-progreso {

    height:100%;

    border-radius:20px;

    background:white;

    transition:1s;

}



.porcentaje {

    text-align:right;

    margin-top:5px;

    font-size:14px;

    font-weight:bold;

}



.finanzas-mini {

    margin-top:15px;

    font-size:14px;

    opacity:.95;

}


</style>



<h2 class="meses-title">
    📅 Rendimiento por Mes
</h2>



<div class="meses-grid">


@foreach(var mes in Model)
{
    

    decimal porcentajeGanancia = 0;

    if(mes.TotalIngresos > 0)
    {
        porcentajeGanancia =
        (mes.Ganancia / mes.TotalIngresos) * 100;
    }


    string estado = "⚠️ Revisar gastos";

    string claseEstado = "estado-cuidado";


    if(porcentajeGanancia >= 50)
    {
        estado = "🏆 Excelente";
        claseEstado = "estado-excelente";
    }
    else if(porcentajeGanancia >= 25)
    {
        estado = "👍 Buen rendimiento";
        claseEstado = "estado-bueno";
    }
    
    

    var claseMes = mes.NombreMes
        .ToLower()
        .Replace("á","a")
        .Replace("é","e")
        .Replace("í","i")
        .Replace("ó","o")
        .Replace("ú","u");



    <div class="mes-card @claseMes">


        <div class="mes-nombre">

            @mes.NombreMes

        </div>



        <div class="dato-finanza">

            <span>
                💰 Ingresos
            </span>

            <strong>
                @mes.TotalIngresos.ToString("C")
            </strong>

        </div>



        <div class="dato-finanza">

            <span>
                💼 Negocio
            </span>

            <strong>
                @mes.TotalGastosNegocio.ToString("C")
            </strong>

        </div>




        <div class="dato-finanza">

            <span>
                👤 Personal
            </span>

            <strong>
                @mes.TotalGastosPersonales.ToString("C")
            </strong>

        </div>



        <div class="ganancia-box">


    <span>
        🏆 Ganancia real
    </span>


    <h3>
        @mes.Ganancia.ToString("C")
    </h3>


    <div class="estado-negocio @claseEstado">

        @estado

    </div>


<div class="indicadores-financieros">


    <div>

        Margen de ganancia

    </div>


    <div class="barra-fondo">

        <div class="barra-progreso"
             style="width:@Math.Min(porcentajeGanancia,100)%">

        </div>

    </div>


    <div class="porcentaje">

        @porcentajeGanancia.ToString("0.0")%

    </div>


    <div class="finanzas-mini">

        Cada RD$100 generado:
        <br />

        RD$
        @((mes.Ganancia / (mes.TotalIngresos == 0 ? 1 : mes.TotalIngresos) * 100)
        .ToString("0.00"))

        quedan libres.

    </div>


</div> <!-- Cierra indicadores-financieros -->


</div> <!-- Cierra ganancia-box -->


</div> <!-- Cierra mes-card -->


} <!-- Cierra foreach -->


<div class="dashboard-final">


    <div class="final-card mejor-mes">


        <div class="final-icon">
            🏆
        </div>


        <h3>
            Mejor mes en ganancias
        </h3>


        @if(mejorMes != null)
        {

            <h1>
                @mejorMes.NombreMes
            </h1>


            <p>
                @mejorMes.Ganancia.ToString("C")
            </p>

        }


    </div>




    <div class="final-card promedio">


        <div class="final-icon">
            📈
        </div>


        <h3>
            Ganancia promedio mensual
        </h3>


        <h1>
            @promedioGanancia.ToString("C")
        </h1>


    </div>




    <div class="final-card mayor-ingreso">


        <div class="final-icon">
            💎
        </div>


        <h3>
            Mayor ingreso registrado
        </h3>


        @if(mesMayorIngreso != null)
        {

            <h1>
                @mesMayorIngreso.NombreMes
            </h1>


            <p>
                @mesMayorIngreso.TotalIngresos.ToString("C")
            </p>

        }


    </div>


</div>



<div class="mensaje-financiero">


    <h2>
        🌸 Tu negocio, tus números, tu crecimiento
    </h2>


    <p>
        TropiNails Pro te ayuda a entender
        cuánto ganas realmente,
        controlar tus gastos y tomar mejores decisiones.
    </p>


</div>