</style>



<script>

const manicuristaId=parseInt("@manicuristaId") || 0;
const fotoPerfil="@foto";
const nombreUsuario="@nombreCompleto";

let mediaList=[];
let mediaActual=0;


/* =========================================================
   CARGAR FEED DE CATÁLOGOS
   ========================================================= */

async function cargarFeedCatalogos(){

    const cont=document.getElementById("feedCatalogos");

    if(!manicuristaId){

        cont.innerHTML=
        "No se pudo identificar el usuario";

        return;
    }

    cont.innerHTML="Cargando catálogos...";

    try{

        const res=await fetch(
            `/Publicaciones/ObtenerPorUsuario?usuarioId=${manicuristaId}`
        );

        const catalogos=await res.json();


        document.getElementById(
            "contadorCatalogos"
        ).innerText=catalogos.length;


        if(!catalogos || catalogos.length===0){

            cont.innerHTML=
            "<p style='text-align:center'>No hay catálogos</p>";

            return;
        }


        cont.innerHTML="";
        mediaList=[];


        catalogos.forEach((c,index)=>{

            let media="";
            let tipo=(c.tipoMedia || "imagen").toLowerCase();

            mediaList.push(c);


            if(tipo==="video"){

                media=`
                <video
                    class="post-video"
                    controls
                    preload="metadata">

                    <source
                        src="${c.mediaUrl}"
                        type="video/mp4">

                </video>
                `;

            }else{

                media=`
                <img
                    src="${c.mediaUrl}"
                    class="post-img"
                    loading="lazy"
                    onclick="abrirVisor(${index})">
                `;

            }


            cont.innerHTML +=`

            <div class="post-card">

                <div class="post-header">

                    <img
                        src="${fotoPerfil}"
                        class="avatar-img"/>


                    <div class="user-info">

                        <div class="user-name">
                            ${nombreUsuario}
                        </div>


                        <div class="post-date">
                            ${new Date(c.fecha).toLocaleString()}
                        </div>

                    </div>


                    <div class="menu-post"
                         onclick="eliminarPost(${c.id})">

                        ⋮

                    </div>

                </div>


                ${media}


                <div class="post-actions">

                    <button
                        class="action"
                        onclick="darLike(${c.id})">

                        ❤️ Me encanta

                    </button>


                    <button
                        class="action"
                        onclick="verComentarios(${c.id})">

                        💬 Comentar

                    </button>


                    <button
                        class="action"
                        onclick="compartir('${c.mediaUrl}')">

                        🔗 Compartir

                    </button>

                </div>


                <div
                    class="stats"
                    id="stats-${c.id}">

                    ❤️ ${c.likes || 0}
                    Likes •
                    💬 ${c.comentarios || 0}
                    Comentarios

                </div>

            </div>

            `;

        });


    }catch(e){

        console.error(e);

        cont.innerHTML=
        "Error cargando catálogos";

    }

}



/* =========================================================
   SEGUIDORES
   ========================================================= */

async function cargarSeguidores(){

    try{

        const res=await fetch(
            `/Seguidores/Resumen?usuarioId=${manicuristaId}`
        );


        if(!res.ok) return;


        const data=await res.json();


        document.getElementById(
            "contadorSeguidores"
        ).innerText=
        data.seguidores || 0;


        document.getElementById(
            "contadorSiguiendo"
        ).innerText=
        data.siguiendo || 0;


    }catch(e){

        console.log(
            "No se cargaron seguidores"
        );

    }

}



/* =========================================================
   VISOR
   ========================================================= */

function abrirVisor(index){

    mediaActual=index;

    const pub=mediaList[index];

    const img=
    document.getElementById("mediaImagen");

    const vid=
    document.getElementById("mediaVideo");


    img.style.display="none";
    vid.style.display="none";


    if(pub.tipoMedia==="video"){

        vid.src=pub.mediaUrl;
        vid.style.display="block";

    }else{

        img.src=pub.mediaUrl;
        img.style.display="block";

    }


    document.getElementById(
        "visorMedia"
    ).style.display="flex";

}



function cerrarVisor(){

    document.getElementById(
        "visorMedia"
    ).style.display="none";


    let vid=document.getElementById(
        "mediaVideo"
    );


    vid.pause();
    vid.src="";

}



function siguienteMedia(){

    mediaActual++;


    if(mediaActual>=mediaList.length){
        mediaActual=0;
    }


    abrirVisor(mediaActual);

}



function anteriorMedia(){

    mediaActual--;


    if(mediaActual<0){
        mediaActual=mediaList.length-1;
    }


    abrirVisor(mediaActual);

}



/* =========================================================
   LIKES
   ========================================================= */

async function darLike(id){

    await fetch(
        "/Publicaciones/Like/"+id,
        {
            method:"POST"
        }
    );


    actualizarStats(id);

}



async function actualizarStats(id){

    const res=
    await fetch(
        "/Publicaciones/ObtenerFeed"
    );


    const posts=
    await res.json();


    const post=
    posts.find(p=>p.id===id);


    if(post){

        document.getElementById(
            "stats-"+id
        ).innerText=
        `❤️ ${post.likes} Likes • 💬 ${post.comentarios} Comentarios`;

    }

}



/* =========================================================
   ACCIONES
   ========================================================= */

function verComentarios(id){

    window.location.href=
    "/Comentarios/Ver/"+id;

}



function compartir(url){

    navigator.clipboard.writeText(
        window.location.origin + url
    );


    alert(
        "Link copiado para compartir"
    );

}



/* =========================================================
   ELIMINAR PUBLICACIÓN
   ========================================================= */

async function eliminarPost(id){

    if(!confirm(
        "¿Quieres eliminar esta publicación?"
    )){
        return;
    }


    try{

        const res=await fetch(
            `/Publicaciones/Eliminar?id=${id}`,
            {
                method:"POST"
            }
        );


        if(res.ok){

            location.reload();

        }else{

            alert(
                "No se pudo eliminar la publicación"
            );

        }


    }catch(e){

        console.error(e);

        alert(
            "Error eliminando publicación"
        );

    }

}



/* =========================================================
   FOTO PERFIL
   ========================================================= */

function abrirFotoPerfil(url){

    const fp=
    document.getElementById(
        "fotoPerfilGrande"
    );


    fp.src=url;


    document.getElementById(
        "visorFotoPerfil"
    ).style.display="flex";

}



function cerrarFotoPerfil(){

    document.getElementById(
        "visorFotoPerfil"
    ).style.display="none";

}



/* =========================================================
   INICIO
   ========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    function(){

        cargarFeedCatalogos();
        cargarSeguidores();

    }
);

</script>