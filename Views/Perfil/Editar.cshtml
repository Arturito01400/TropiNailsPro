    color:white;
}


/* ================================================= */
/* RESPONSIVE */
/* ================================================= */

@@media(max-width:576px){

    .perfil-header h2{
        font-size:24px;
    }

    .foto-negocio{
        height:190px;
    }

    .ubicacion-box{
        align-items:flex-start;
    }

    .mapa-google{
        height:280px;
    }

    .mapa-header{
        align-items:flex-start;
        flex-direction:column;
    }

    .acciones-mapa{
        flex-direction:column;
    }

    .acciones-mapa a{
        width:100%;
        text-align:center;
    }

}

</style>


<script>

/* ================================================= */
/* PREVIEW FOTO PERFIL */
/* ================================================= */

function previewImagen(event){

    const file =
        event.target.files[0];

    if(!file) return;

    const reader =
        new FileReader();

    reader.onload =
        function(e){

            document.getElementById(
                "previewFoto"
            ).src = e.target.result;

        };

    reader.readAsDataURL(file);
}


/* ================================================= */
/* PREVIEW FOTO NEGOCIO */
/* ================================================= */

function previewFotoNegocio(event){

    const file =
        event.target.files[0];

    if(!file) return;

    const reader =
        new FileReader();

    reader.onload =
        function(e){

            document.getElementById(
                "previewFotoNegocio"
            ).src = e.target.result;

        };

    reader.readAsDataURL(file);
}


/* ================================================= */
/* CREAR MAPA */
/* ================================================= */

function mostrarMapa(lat, lon){

    const mapa =
        document.getElementById("mapaGoogle");

    const placeholder =
        document.getElementById("mapaPlaceholder");

    const acciones =
        document.getElementById("accionesMapa");

    const estadoMapa =
        document.getElementById("estadoMapa");

    if(!lat || !lon){

        return;
    }


    /*
     * Google Maps puede mostrar la ubicación
     * mediante esta URL sin necesidad de
     * colocar una API Key dentro del código.
     */

    const mapaUrl =
        "https://www.google.com/maps?q=" +
        encodeURIComponent(lat + "," + lon) +
        "&output=embed";


    const googleMapsUrl =
        "https://www.google.com/maps/search/?api=1&query=" +
        encodeURIComponent(lat + "," + lon);


    const comoLlegarUrl =
        "https://www.google.com/maps/dir/?api=1&destination=" +
        encodeURIComponent(lat + "," + lon);


    mapa.innerHTML =
        '<iframe ' +
        'src="' + mapaUrl + '" ' +
        'loading="lazy" ' +
        'referrerpolicy="no-referrer-when-downgrade" ' +
        'allowfullscreen>' +
        '</iframe>';


    document.getElementById(
        "btnGoogleMaps"
    ).href = googleMapsUrl;


    document.getElementById(
        "btnComoLlegar"
    ).href = comoLlegarUrl;


    acciones.style.display =
        "flex";


    estadoMapa.innerText =
        "✓ Ubicación activa";

    estadoMapa.classList.add(
        "activo"
    );
}


/* ================================================= */
/* DETECTAR UBICACIÓN */
/* ================================================= */

function obtenerUbicacion(){

    const estado =
        document.getElementById(
            "estadoUbicacion"
        );


    if(!navigator.geolocation){

        estado.innerText =
            "❌ Tu navegador no permite obtener la ubicación.";

        estado.style.color =
            "#dc3545";

        return;
    }


    estado.innerText =
        "📍 Detectando ubicación...";

    estado.style.color =
        "#666";


    navigator.geolocation.getCurrentPosition(

        function(position){

            const lat =
                position.coords.latitude;

            const lon =
                position.coords.longitude;


            document.getElementById(
                "Latitud"
            ).value =
                lat.toFixed(7);


            document.getElementById(
                "Longitud"
            ).value =
                lon.toFixed(7);


            document.getElementById(
                "UbicacionActiva"
            ).value =
                "true";


            mostrarMapa(
                lat,
                lon
            );


            estado.innerText =
                "✅ Ubicación detectada correctamente. Guarda los cambios para conservarla.";

            estado.style.color =
                "#12a150";

        },


        function(error){

            console.error(error);

            estado.innerText =
                "❌ No pudimos obtener tu ubicación. Revisa los permisos del navegador.";

            estado.style.color =
                "#dc3545";

        },


        {
            enableHighAccuracy:true,
            timeout:10000,
            maximumAge:0
        }

    );

}


/* ================================================= */
/* CARGAR MAPA SI YA EXISTE UBICACIÓN */
/* ================================================= */

document.addEventListener(
    "DOMContentLoaded",
    function(){

        const lat =
            document.getElementById(
                "Latitud"
            ).value;

        const lon =
            document.getElementById(
                "Longitud"
            ).value;


        if(
            lat &&
            lon &&
            !isNaN(parseFloat(lat)) &&
            !isNaN(parseFloat(lon))
        ){

            mostrarMapa(
                parseFloat(lat),
                parseFloat(lon)
            );

        }

    }
);

</script>