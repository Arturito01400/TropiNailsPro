@model TropiNailsPro.Models.Usuario

@{
    ViewData["Title"] = "Editar Perfil";
    Layout = "_Layout";

    var negocio = ViewBag.Manicurista as TropiNailsPro.Models.Manicurista;

    string fotoBase = "/img/user-default.png";

    if (!string.IsNullOrWhiteSpace(Model?.FotoPerfil))
    {
        fotoBase = Model.FotoPerfil;

        if (!fotoBase.StartsWith("/") &&
            !fotoBase.StartsWith("http://") &&
            !fotoBase.StartsWith("https://"))
        {
            fotoBase = "/" + fotoBase;
        }
    }

    string fotoFinal =
        fotoBase + "?v=" + DateTime.Now.Ticks;

    string fotoNegocio =
        "/img/user-default.png";

    if (!string.IsNullOrWhiteSpace(negocio?.FotoNegocio))
    {
        fotoNegocio = negocio.FotoNegocio;

        if (!fotoNegocio.StartsWith("/") &&
            !fotoNegocio.StartsWith("http://") &&
            !fotoNegocio.StartsWith("https://"))
        {
            fotoNegocio = "/" + fotoNegocio;
        }
    }

    string whatsappValor =
        Model?.WhatsApp ?? "";

    string whatsappPlaceholder =
        "Ej: 18095551234";
}

<div class="container mt-4 mb-5 perfil-editar">

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

        <!-- ================================================= -->
        <!-- CABECERA -->
        <!-- ================================================= -->

        <div class="perfil-header text-center">

            <h2 class="fw-bold mb-2">
                ✨ Personaliza tu perfil
            </h2>

            <p class="mb-0">
                Completa tu información para que tus clientes
                puedan conocerte y contactarte.
            </p>

        </div>


        <div class="card-body p-4 p-md-5">

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success text-center rounded-3">
                    @TempData["Mensaje"]
                </div>
            }


            <form asp-controller="Perfil"
                  asp-action="Guardar"
                  method="post"
                  enctype="multipart/form-data">

                <input type="hidden"
                       asp-for="Id" />


                <!-- ================================================= -->
                <!-- INFORMACIÓN PERSONAL -->
                <!-- ================================================= -->

                <div class="seccion-perfil">

                    <div class="seccion-titulo">
                        <span>👤</span>
                        <div>
                            <h4>Mi información</h4>
                            <small>
                                Información que verán tus clientes.
                            </small>
                        </div>
                    </div>


                    <!-- FOTO PERFIL -->

                    <div class="foto-contenedor text-center mb-4">

                        <img id="previewFoto"
                             src="@fotoFinal"
                             class="foto-perfil"
                             onerror="this.src='/img/user-default.png'" />

                        <div class="mt-3">

                            <label class="btn btn-outline-pink">
                                📷 Cambiar foto de perfil

                                <input type="file"
                                       name="foto"
                                       accept="image/*"
                                       hidden
                                       onchange="previewImagen(event)" />
                            </label>

                        </div>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Nombre
                        </label>

                        <input asp-for="Nombre"
                               class="form-control form-control-lg"
                               placeholder="Tu nombre completo" />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Teléfono personal
                        </label>

                        <input asp-for="Telefono"
                               class="form-control form-control-lg"
                               placeholder="Ej: 8095551234" />

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- NEGOCIO -->
                <!-- ================================================= -->

                <div class="seccion-perfil">

                    <div class="seccion-titulo">

                        <span>🏪</span>

                        <div>

                            <h4>Mi negocio</h4>

                            <small>
                                Presenta tu negocio profesionalmente.
                            </small>

                        </div>

                    </div>


                    <div class="foto-negocio-box text-center mb-4">

                        <img id="previewFotoNegocio"
                             src="@fotoNegocio"
                             class="foto-negocio"
                             onerror="this.src='/img/user-default.png'" />

                        <div class="mt-3">

                            <label class="btn btn-outline-pink">

                                📸 Foto del negocio

                                <input type="file"
                                       name="fotoNegocio"
                                       accept="image/*"
                                       hidden
                                       onchange="previewFotoNegocio(event)" />

                            </label>

                        </div>

                        <small class="text-muted d-block mt-2">
                            Esta imagen aparecerá en tu perfil público.
                        </small>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Nombre del negocio
                        </label>

                        <input type="text"
                               name="NombreNegocio"
                               class="form-control form-control-lg"
                               value="@negocio?.NombreNegocio"
                               placeholder="Ej: Beauty Studio RD" />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Teléfono del negocio
                        </label>

                        <input type="text"
                               name="TelefonoNegocio"
                               class="form-control form-control-lg"
                               value="@negocio?.TelefonoNegocio"
                               placeholder="Ej: 8095551234" />

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- REDES SOCIALES -->
                <!-- ================================================= -->

                <div class="seccion-perfil">

                    <div class="seccion-titulo">

                        <span>📱</span>

                        <div>

                            <h4>Mis redes sociales</h4>

                            <small>
                                Permite que tus clientes conozcan tu trabajo.
                            </small>

                        </div>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            📸 Instagram
                        </label>

                        <input asp-for="Instagram"
                               class="form-control form-control-lg"
                               placeholder="https://instagram.com/tuusuario" />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            🎵 TikTok
                        </label>

                        <input asp-for="TikTok"
                               class="form-control form-control-lg"
                               placeholder="https://tiktok.com/@@tuusuario" />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            📘 Facebook
                        </label>

                        <input asp-for="Facebook"
                               class="form-control form-control-lg"
                               placeholder="https://facebook.com/tuusuario" />

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- WHATSAPP -->
                <!-- ================================================= -->

                <div class="seccion-perfil">

                    <div class="seccion-titulo">

                        <span>💬</span>

                        <div>

                            <h4>WhatsApp</h4>

                            <small>
                                Tus clientes podrán contactarte directamente.
                            </small>

                        </div>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Número de WhatsApp
                        </label>

                        <input asp-for="WhatsApp"
                               class="form-control form-control-lg"
                               placeholder="@whatsappPlaceholder"
                               value="@whatsappValor" />

                        <div class="form-text">
                            Escribe el número con código de país,
                            sin espacios ni símbolos.
                            Ejemplo: <strong>18095551234</strong>
                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- UBICACIÓN -->
                <!-- ================================================= -->

                <div class="seccion-perfil">

                    <div class="seccion-titulo">

                        <span>📍</span>

                        <div>

                            <h4>Ubicación de mi negocio</h4>

                            <small>
                                Ayuda a tus clientes a encontrarte.
                            </small>

                        </div>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Dirección
                        </label>

                        <input type="text"
                               name="DireccionNegocio"
                               class="form-control form-control-lg"
                               value="@negocio?.DireccionNegocio"
                               placeholder="Ej: Calle Principal #25" />

                    </div>


                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Ciudad
                            </label>

                            <input type="text"
                                   name="Ciudad"
                                   class="form-control form-control-lg"
                                   value="@negocio?.Ciudad"
                                   placeholder="Santo Domingo" />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Provincia
                            </label>

                            <input type="text"
                                   name="Provincia"
                                   class="form-control form-control-lg"
                                   value="@negocio?.Provincia"
                                   placeholder="Santo Domingo" />

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- COORDENADAS -->
                    <!-- ================================================= -->

                    <input type="hidden"
                           id="Latitud"
                           name="Latitud"
                           value="@negocio?.Latitud" />

                    <input type="hidden"
                           id="Longitud"
                           name="Longitud"
                           value="@negocio?.Longitud" />


                    <!-- ================================================= -->
                    <!-- MAPA -->
                    <!-- ================================================= -->

                    <div class="mapa-contenedor mb-3">

                        <div class="mapa-header">

                            <div>

                                <strong>
                                    🗺️ Ubicación de tu negocio
                                </strong>

                                <small>
                                    Esta será la ubicación que verán tus clientes.
                                </small>

                            </div>

                            <span id="estadoMapa"
                                  class="estado-mapa">
                                Sin ubicación
                            </span>

                        </div>


                        <div id="mapaGoogle"
                             class="mapa-google">

                            <div id="mapaPlaceholder"
                                 class="mapa-placeholder">

                                <div class="mapa-placeholder-icon">
                                    📍
                                </div>

                                <strong>
                                    Aún no has seleccionado una ubicación
                                </strong>

                                <span>
                                    Presiona "Detectar mi ubicación"
                                    para colocar tu negocio en el mapa.
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- ACCIONES DEL MAPA -->
                    <!-- ================================================= -->

                    <div id="accionesMapa"
                         class="acciones-mapa"
                         style="display:none;">

                        <a id="btnGoogleMaps"
                           href="#"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-google-maps">

                            🗺️ Abrir en Google Maps

                        </a>


                        <a id="btnComoLlegar"
                           href="#"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-como-llegar">

                            🚗 Cómo llegar

                        </a>

                    </div>


                    <!-- ================================================= -->
                    <!-- DETECTAR UBICACIÓN -->
                    <!-- ================================================= -->

                    <div class="ubicacion-box">

                        <div class="ubicacion-icon">
                            📍
                        </div>

                        <div class="flex-grow-1">

                            <strong>
                                Ubicación exacta
                            </strong>

                            <p class="mb-2 text-muted">
                                Permite que TropiNails Pro detecte
                                automáticamente dónde está tu negocio.
                            </p>

                            <button type="button"
                                    class="btn btn-pink"
                                    onclick="obtenerUbicacion()">

                                📍 Detectar mi ubicación

                            </button>

                            <span id="estadoUbicacion"
                                  class="d-block mt-2 small">
                            </span>

                        </div>

                    </div>


                    <input type="hidden"
                           id="UbicacionActiva"
                           name="UbicacionActiva"
                           value="@(negocio?.UbicacionActiva == true ? "true" : "false")" />

                </div>


                <!-- ================================================= -->
                <!-- BOTONES -->
                <!-- ================================================= -->

                <div class="d-grid gap-3 mt-4">

                    <button type="submit"
                            class="btn btn-lg text-white btn-guardar">

                        💾 Guardar cambios

                    </button>


                    <a asp-controller="Perfil"
                       asp-action="Index"
                       class="btn btn-outline-secondary btn-lg">

                        Cancelar

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


<style>

.perfil-editar{
    max-width:800px;
}

.perfil-header{
    background:linear-gradient(
        135deg,
        #ff4da6,
        #e91e63
    );
    color:white;
    padding:35px 20px;
}

.perfil-header h2{
    font-size:30px;
}

.seccion-perfil{
    margin-bottom:35px;
    padding-bottom:30px;
    border-bottom:1px solid #eee;
}

.seccion-titulo{
    display:flex;
    align-items:center;
    gap:15px;
    margin-bottom:25px;
}

.seccion-titulo > span{
    font-size:32px;
}

.seccion-titulo h4{
    margin:0;
    font-weight:700;
}

.seccion-titulo small{
    color:#777;
}

.form-label{
    font-weight:600;
}

.form-control{
    border-radius:12px;
}

.form-control:focus{
    border-color:#ff4da6;
    box-shadow:0 0 0 .2rem rgba(255,77,166,.15);
}

.foto-perfil{
    width:160px;
    height:160px;
    object-fit:cover;
    border-radius:50%;
    border:5px solid #ff4da6;
    box-shadow:0 8px 25px rgba(0,0,0,.15);
}

.foto-negocio{
    width:100%;
    max-width:500px;
    height:230px;
    object-fit:cover;
    border-radius:20px;
    border:4px solid #ff4da6;
    box-shadow:0 8px 25px rgba(0,0,0,.12);
}

.btn-outline-pink{
    color:#ff4da6;
    border:2px solid #ff4da6;
    border-radius:12px;
    font-weight:600;
}

.btn-outline-pink:hover{
    background:#ff4da6;
    color:white;
}

.btn-pink{
    background:#ff4da6;
    border:none;
    color:white;
    border-radius:12px;
    font-weight:600;
    padding:10px 18px;
}

.btn-pink:hover{
    background:#e91e63;
    color:white;
}

.btn-guardar{
    background:#ff4da6;
    border-radius:14px;
    font-weight:700;
}

.btn-guardar:hover{
    background:#e91e63;
}

.ubicacion-box{
    display:flex;
    gap:18px;
    align-items:center;
    background:#fff5fa;
    border:1px solid #ffd1e5;
    padding:20px;
    border-radius:18px;
}

.ubicacion-icon{
    font-size:35px;
}


/* ================================================= */
/* MAPA */
/* ================================================= */

.mapa-contenedor{
    background:white;
    border:1px solid #e7e7e7;
    border-radius:20px;
    overflow:hidden;
    box-shadow:0 5px 20px rgba(0,0,0,.07);
}

.mapa-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
    padding:16px 18px;
    background:#fafafa;
    border-bottom:1px solid #eee;
}

.mapa-header strong{
