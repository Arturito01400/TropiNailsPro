</style>


<script>

/* ================================================= */
/* PREVIEW FOTO PERFIL */
/* ================================================= */

function previewImagen(event){

    const file =
        event.target.files[0];

    if(!file) return;

    const reader =
        new FileReader();

    reader.onload =
        function(e){

            document.getElementById(
                "previewFoto"
            ).src = e.target.result;

        };

    reader.readAsDataURL(file);
}


/* ================================================= */
/* PREVIEW FOTO NEGOCIO */
/* ================================================= */

function previewFotoNegocio(event){

    const file =
        event.target.files[0];

    if(!file) return;

    const reader =
        new FileReader();

    reader.onload =
        function(e){

            document.getElementById(
                "previewFotoNegocio"
            ).src = e.target.result;

        };

    reader.readAsDataURL(file);
}


/* ================================================= */
/* SERVICIOS */
/* ================================================= */

function agregarServicio(){

    const container =
        document.getElementById(
            "serviciosContainer"
        );

    const tarjeta =
        document.createElement("div");

    tarjeta.className =
        "servicio-card";

    tarjeta.innerHTML = `

        <!-- Servicio nuevo: todavía no tiene ID -->

        <input type="hidden"
               class="servicio-id"
               value="" />


        <div class="servicio-card-header">

            <div class="servicio-mini-icon">
                ✨
            </div>

            <div class="flex-grow-1">

                <strong class="servicio-numero">
                    Nuevo servicio
                </strong>

            </div>

            <button type="button"
                    class="btn-eliminar-servicio"
                    onclick="eliminarServicio(this)"
                    title="Eliminar servicio">

                🗑️

            </button>

        </div>


        <div class="row g-3">

            <div class="col-12">

                <label class="form-label">
                    Nombre del servicio
                </label>

                <input type="text"
                       class="form-control servicio-nombre"
                       maxlength="150"
                       placeholder="Ej: Manicura semipermanente">

            </div>


            <div class="col-12">

                <label class="form-label">
                    Descripción
                </label>

                <textarea class="form-control servicio-descripcion"
                          rows="2"
                          maxlength="500"
                          placeholder="Describe brevemente este servicio"></textarea>

            </div>


            <div class="col-md-4">

                <label class="form-label">
                    Precio
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        RD$
                    </span>

                    <input type="number"
                           class="form-control servicio-precio"
                           min="0"
                           step="0.01"
                           placeholder="Opcional">

                </div>

                <small class="text-muted">
                    Opcional
                </small>

            </div>


            <div class="col-md-4">

                <label class="form-label">
                    Duración
                </label>

                <div class="input-group">

                    <input type="number"
                           class="form-control servicio-duracion"
                           min="1"
                           max="1440"
                           placeholder="Opcional">

                    <span class="input-group-text">
                        min
                    </span>

                </div>

                <small class="text-muted">
                    Opcional
                </small>

            </div>


            <div class="col-md-4">

                <label class="form-label">
                    Estado
                </label>

                <select class="form-select servicio-activo">

                    <option value="true" selected>
                        Activo
                    </option>

                    <option value="false">
                        Oculto
                    </option>

                </select>

                <small class="text-muted">
                    Visible en tu perfil público
                </small>

            </div>

        </div>

    `;

    container.appendChild(tarjeta);

    actualizarNumerosServicios();

    actualizarEstadoSinServicios();

}


/* ================================================= */
/* ELIMINAR SERVICIO */
/* ================================================= */

function eliminarServicio(boton){

    const tarjeta =
        boton.closest(
            ".servicio-card"
        );

    if(!tarjeta)
        return;

    tarjeta.remove();

    actualizarNumerosServicios();

    actualizarEstadoSinServicios();

}


/* ================================================= */
/* NUMERACIÓN */
/* ================================================= */

function actualizarNumerosServicios(){

    const tarjetas =
        document.querySelectorAll(
            "#serviciosContainer .servicio-card"
        );

    tarjetas.forEach(
        function(tarjeta, index){

            const numero =
                tarjeta.querySelector(
                    ".servicio-numero"
                );

            if(numero){

                numero.innerText =
                    "Servicio " + (index + 1);

            }

        }
    );

}


/* ================================================= */
/* ESTADO SIN SERVICIOS */
/* ================================================= */

function actualizarEstadoSinServicios(){

    const tarjetas =
        document.querySelectorAll(
            "#serviciosContainer .servicio-card"
        );

    const mensaje =
        document.getElementById(
            "sinServicios"
        );

    if(!mensaje)
        return;

    if(tarjetas.length === 0){

        mensaje.classList.remove(
            "d-none"
        );

    }
    else{

        mensaje.classList.add(
            "d-none"
        );

    }

}


/* ================================================= */
/* PREPARAR SERVICIOS PARA GUARDAR */
/* ================================================= */

function prepararServicios(){

    const tarjetas =
        document.querySelectorAll(
            "#serviciosContainer .servicio-card"
        );

    const servicios = [];

    tarjetas.forEach(
        function(tarjeta){

            /* ========================================= */
            /* ID DEL SERVICIO */
            /* ========================================= */

            const idTexto =
                tarjeta.querySelector(
                    ".servicio-id"
                )?.value;


            const id =
                idTexto &&
                idTexto.trim() !== ""
                    ? parseInt(idTexto)
                    : null;


            /* ========================================= */
            /* DATOS */
            /* ========================================= */

            const nombre =
                tarjeta.querySelector(
                    ".servicio-nombre"
                )?.value.trim();

            const descripcion =
                tarjeta.querySelector(
                    ".servicio-descripcion"
                )?.value.trim();

            const precioTexto =
                tarjeta.querySelector(
                    ".servicio-precio"
                )?.value;

            const duracionTexto =
                tarjeta.querySelector(
                    ".servicio-duracion"
                )?.value;

            const activoTexto =
                tarjeta.querySelector(
                    ".servicio-activo"
                )?.value;


            /*
             * No enviamos tarjetas completamente vacías.
             */

            if(!nombre)
                return;


            /* ========================================= */
            /* PRECIO OPCIONAL */
            /* ========================================= */

            const precio =
                precioTexto &&
                precioTexto.trim() !== ""
                    ? parseFloat(precioTexto)
                    : null;


            /* ========================================= */
            /* DURACIÓN OPCIONAL */
            /* ========================================= */

            const duracion =
                duracionTexto &&
                duracionTexto.trim() !== ""
                    ? parseInt(duracionTexto)
                    : null;


            /* ========================================= */
            /* ESTADO */
            /* ========================================= */

            const activo =
                activoTexto !== "false";


            /* ========================================= */
            /* AGREGAR */
            /* ========================================= */

            servicios.push({

                Id:
                    id,

                Nombre:
                    nombre,

                Descripcion:
                    descripcion || null,

                Precio:
                    precio,

                DuracionMinutos:
                    duracion,

                Activo:
                    activo

            });

        }
    );


    document.getElementById(
        "ServiciosJson"
    ).value =
        JSON.stringify(servicios);

}


/* ================================================= */
/* CREAR MAPA */
/* ================================================= */

function mostrarMapa(lat, lon){

    const mapa =
        document.getElementById(
            "mapaGoogle"
        );

    const acciones =
        document.getElementById(
            "accionesMapa"
        );

    const estadoMapa =
        document.getElementById(
            "estadoMapa"
        );


    if(!lat || !lon){

        return;

    }


    const mapaUrl =
        "https://www.google.com/maps?q=" +
        encodeURIComponent(
            lat + "," + lon
        ) +
        "&output=embed";


    const googleMapsUrl =
        "https://www.google.com/maps/search/?api=1&query=" +
        encodeURIComponent(
            lat + "," + lon
        );


    const comoLlegarUrl =
        "https://www.google.com/maps/dir/?api=1&destination=" +
        encodeURIComponent(
            lat + "," + lon
        );


    mapa.innerHTML =
        '<iframe ' +
        'src="' + mapaUrl + '" ' +
        'loading="lazy" ' +
        'referrerpolicy="no-referrer-when-downgrade" ' +
        'allowfullscreen>' +
        '</iframe>';


    document.getElementById(
        "btnGoogleMaps"
    ).href =
        googleMapsUrl;


    document.getElementById(
        "btnComoLlegar"
    ).href =
        comoLlegarUrl;


    acciones.style.display =
        "flex";


    estadoMapa.innerText =
        "✓ Ubicación activa";


    estadoMapa.classList.add(
        "activo"
    );

}


/* ================================================= */
/* DETECTAR UBICACIÓN */
/* ================================================= */

function obtenerUbicacion(){

    const estado =
        document.getElementById(
            "estadoUbicacion"
        );


    if(!navigator.geolocation){

        estado.innerText =
            "❌ Tu navegador no permite obtener la ubicación.";

        estado.style.color =
            "#dc3545";

        return;

    }


    estado.innerText =
        "📍 Detectando ubicación...";

    estado.style.color =
        "#666";


    navigator.geolocation.getCurrentPosition(

        function(position){

            const lat =
                position.coords.latitude;

            const lon =
                position.coords.longitude;


            document.getElementById(
                "Latitud"
            ).value =
                lat.toFixed(7);


            document.getElementById(
                "Longitud"
            ).value =
                lon.toFixed(7);


            document.getElementById(
                "UbicacionActiva"
            ).value =
                "true";


            mostrarMapa(
                lat,
                lon
            );


            estado.innerText =
                "✅ Ubicación detectada correctamente. Guarda los cambios para conservarla.";


            estado.style.color =
                "#12a150";

        },


        function(error){

            console.error(error);


            estado.innerText =
                "❌ No pudimos obtener tu ubicación. Revisa los permisos del navegador.";


            estado.style.color =
                "#dc3545";

        },


        {
            enableHighAccuracy:true,
            timeout:10000,
            maximumAge:0
        }

    );

}


/* ================================================= */
/* AL CARGAR */
/* ================================================= */

document.addEventListener(
    "DOMContentLoaded",
    function(){

        actualizarNumerosServicios();

        actualizarEstadoSinServicios();


        const lat =
            document.getElementById(
                "Latitud"
            ).value;


        const lon =
            document.getElementById(
                "Longitud"
            ).value;


        if(
            lat &&
            lon &&
            !isNaN(parseFloat(lat)) &&
            !isNaN(parseFloat(lon))
        ){

            mostrarMapa(
                parseFloat(lat),
                parseFloat(lon)
            );

        }

    }
);


/* ================================================= */
/* ANTES DE GUARDAR */
/* ================================================= */

document.getElementById(
    "formPerfil"
).addEventListener(
    "submit",
    function(){

        prepararServicios();

    }
);

</script>