@model TropiNailsPro.Models.Usuario

@{
    ViewData["Title"] = "Editar Perfil";
    Layout = "_Layout";

    var negocio = ViewBag.Manicurista as TropiNailsPro.Models.Manicurista;

    string fotoBase = "/img/user-default.png";

    if (!string.IsNullOrWhiteSpace(Model?.FotoPerfil))
    {
        fotoBase = Model.FotoPerfil;

        if (!fotoBase.StartsWith("/") &&
            !fotoBase.StartsWith("http://") &&
            !fotoBase.StartsWith("https://"))
        {
            fotoBase = "/" + fotoBase;
        }
    }

    string fotoFinal =
        fotoBase + "?v=" + DateTime.Now.Ticks;

    string fotoNegocio =
        "/img/user-default.png";

    if (!string.IsNullOrWhiteSpace(negocio?.FotoNegocio))
    {
        fotoNegocio = negocio.FotoNegocio;

        if (!fotoNegocio.StartsWith("/") &&
            !fotoNegocio.StartsWith("http://") &&
            !fotoNegocio.StartsWith("https://"))
        {
            fotoNegocio = "/" + fotoNegocio;
        }
    }

    string whatsappValor =
        Model?.WhatsApp ?? "";

    string whatsappPlaceholder =
        "Ej: 18095551234";
}

<div class="container mt-4 mb-5 perfil-editar">

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

        <!-- ================================================= -->
        <!-- CABECERA -->
        <!-- ================================================= -->

        <div class="perfil-header text-center">

            <div class="perfil-header-icon">
                ✨
            </div>

            <h2 class="fw-bold mb-2">
                Personaliza tu perfil
            </h2>

            <p class="mb-0">
                Completa tu información para que tus clientes
                puedan conocerte, descubrir tus servicios y contactarte.
            </p>

        </div>


        <div class="card-body p-4 p-md-5">

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success text-center rounded-3 shadow-sm">
                    @TempData["Mensaje"]
                </div>
            }


            <form asp-controller="Perfil"
                  asp-action="Guardar"
                  method="post"
                  enctype="multipart/form-data"
                  id="formPerfil">

                <input type="hidden"
                       asp-for="Id" />


                <!-- ================================================= -->
                <!-- INFORMACIÓN PERSONAL -->
                <!-- ================================================= -->

                <div class="seccion-perfil">

                    <div class="seccion-titulo">

                        <div class="seccion-icono">
                            👤
                        </div>

                        <div>

                            <h4>
                                Mi información
                            </h4>

                            <small>
                                Información que podrán ver tus clientes.
                            </small>

                        </div>

                    </div>


                    <!-- FOTO PERFIL -->

                    <div class="foto-contenedor text-center mb-4">

                        <div class="foto-perfil-wrapper">

                            <img id="previewFoto"
                                 src="@fotoFinal"
                                 class="foto-perfil"
                                 onerror="this.src='/img/user-default.png'" />

                            <div class="foto-check">
                                ✓
                            </div>

                        </div>

                        <div class="mt-3">

                            <label class="btn btn-outline-pink">

                                📷 Cambiar foto de perfil

                                <input type="file"
                                       name="foto"
                                       accept="image/*"
                                       hidden
                                       onchange="previewImagen(event)" />

                            </label>

                        </div>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Nombre
                        </label>

                        <input asp-for="Nombre"
                               class="form-control form-control-lg"
                               placeholder="Tu nombre completo" />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Teléfono personal
                        </label>

                        <input asp-for="Telefono"
                               class="form-control form-control-lg"
                               placeholder="Ej: 8095551234" />

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- NEGOCIO -->
                <!-- ================================================= -->

                <div class="seccion-perfil">

                    <div class="seccion-titulo">

                        <div class="seccion-icono">
                            🏪
                        </div>

                        <div>

                            <h4>
                                Mi negocio
                            </h4>

                            <small>
                                Presenta tu negocio de manera profesional.
                            </small>

                        </div>

                    </div>


                    <div class="foto-negocio-box text-center mb-4">

                        <div class="foto-negocio-wrapper">

                            <img id="previewFotoNegocio"
                                 src="@fotoNegocio"
                                 class="foto-negocio"
                                 onerror="this.src='/img/user-default.png'" />

                        </div>

                        <div class="mt-3">

                            <label class="btn btn-outline-pink">

                                📸 Foto del negocio

                                <input type="file"
                                       name="fotoNegocio"
                                       accept="image/*"
                                       hidden
                                       onchange="previewFotoNegocio(event)" />

                            </label>

                        </div>

                        <small class="text-muted d-block mt-2">

                            Esta imagen aparecerá en tu perfil público.

                        </small>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Nombre del negocio
                        </label>

                        <input type="text"
                               name="NombreNegocio"
                               class="form-control form-control-lg"
                               value="@negocio?.NombreNegocio"
                               placeholder="Ej: Beauty Studio RD" />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Teléfono del negocio
                        </label>

                        <input type="text"
                               name="TelefonoNegocio"
                               class="form-control form-control-lg"
                               value="@negocio?.TelefonoNegocio"
                               placeholder="Ej: 8095551234" />

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- SERVICIOS -->
                <!-- ================================================= -->

                <div class="seccion-perfil">

                    <div class="seccion-titulo">

                        <div class="seccion-icono">
                            ✨
                        </div>

                        <div>

                            <h4>
                                Mis servicios
                            </h4>

                            <small>
                                Agrega los servicios que ofrece tu negocio.
                            </small>

                        </div>

                    </div>


                    <div class="servicios-intro">

                        <div class="servicios-intro-icon">
                            💎
                        </div>

                        <div>

                            <strong>
                                Haz que tus clientes sepan qué ofreces
                            </strong>

                            <p>
                                Puedes agregar servicios de cualquier área
                                de belleza: uñas, cabello, barbería, maquillaje,
                                pestañas, cejas, spa, estética, masajes y mucho más.
                            </p>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- LISTA DE SERVICIOS -->
                    <!-- ================================================= -->

                    <div id="serviciosContainer">

                        @if (negocio?.Servicios != null &&
                             negocio.Servicios.Any())
                        {
                            foreach (var servicio in negocio.Servicios)
                            {
                                <div class="servicio-card">

                                    <!-- 🔥 ID REAL DEL SERVICIO -->
                                    <input type="hidden"
                                           class="servicio-id"
                                           value="@servicio.Id" />


                                    <div class="servicio-card-header">

                                        <div class="servicio-mini-icon">
                                            ✨
                                        </div>

                                        <div class="flex-grow-1">

                                            <strong class="servicio-numero">
                                                Servicio
                                            </strong>

                                        </div>

                                        <button type="button"
                                                class="btn-eliminar-servicio"
                                                onclick="eliminarServicio(this)"
                                                title="Eliminar servicio">

                                            🗑️

                                        </button>

                                    </div>


                                    <div class="row g-3">

                                        <div class="col-12">

                                            <label class="form-label">
                                                Nombre del servicio
                                            </label>

                                            <input type="text"
                                                   class="form-control servicio-nombre"
                                                   value="@servicio.Nombre"
                                                   maxlength="150"
                                                   placeholder="Ej: Manicura semipermanente" />

                                        </div>


                                        <div class="col-12">

                                            <label class="form-label">
                                                Descripción
                                            </label>

                                            <textarea class="form-control servicio-descripcion"
                                                      rows="2"
                                                      maxlength="500"
                                                      placeholder="Describe brevemente este servicio">@servicio.Descripcion</textarea>

                                        </div>


                                        <div class="col-md-4">

                                            <label class="form-label">
                                                Precio
                                            </label>

                                            <div class="input-group">

                                                <span class="input-group-text">
                                                    RD$
                                                </span>

                                                <input type="number"
                                                       class="form-control servicio-precio"
                                                       value="@(servicio.Precio?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                       min="0"
                                                       step="0.01"
                                                       placeholder="Opcional" />

                                            </div>

                                            <small class="text-muted">
                                                Opcional
                                            </small>

                                        </div>


                                        <div class="col-md-4">

                                            <label class="form-label">
                                                Duración
                                            </label>

                                            <div class="input-group">

                                                <input type="number"
                                                       class="form-control servicio-duracion"
                                                       value="@servicio.DuracionMinutos"
                                                       min="1"
                                                       max="1440"
                                                       placeholder="Opcional" />

                                                <span class="input-group-text">
                                                    min
                                                </span>

                                            </div>

                                            <small class="text-muted">
                                                Opcional
                                            </small>

                                        </div>


                                        <div class="col-md-4">

                                            <label class="form-label">
                                                Estado
                                            </label>

                                            <select class="form-select servicio-activo">

                                                @if (servicio.Activo)
                                                {
                                                    <option value="true"
                                                            selected>
                                                        Activo
                                                    </option>

                                                    <option value="false">
                                                        Oculto
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="true">
                                                        Activo
                                                    </option>

                                                    <option value="false"
                                                            selected>
                                                        Oculto
                                                    </option>
                                                }

                                            </select>

                                            <small class="text-muted">
                                                Visible en tu perfil público
                                            </small>

                                        </div>

                                    </div>

                                </div>
                            }
                        }

                    </div>


                    <!-- ================================================= -->
                    <!-- BOTÓN AGREGAR -->
                    <!-- ================================================= -->

                    <button type="button"
                            class="btn btn-agregar-servicio mt-3"
                            onclick="agregarServicio()">

                        <span>
                            ＋
                        </span>

                        Agregar servicio

                    </button>


                    <div id="sinServicios"
                         class="sin-servicios @(negocio?.Servicios != null && negocio.Servicios.Any() ? "d-none" : "")">

                        <div class="sin-servicios-icon">
                            ✨
                        </div>

                        <strong>
                            Todavía no tienes servicios agregados
                        </strong>

                        <span>
                            Agrega los servicios que deseas mostrar
                            en tu perfil público.
                        </span>

                    </div>


                    <!-- ================================================= -->
                    <!-- JSON -->
                    <!-- ================================================= -->

                    <input type="hidden"
                           id="ServiciosJson"
                           name="ServiciosJson"
                           value="" />

                </div>


                <!-- ================================================= -->
                <!-- REDES SOCIALES -->
                <!-- ================================================= -->

                <div class="seccion-perfil">

                    <div class="seccion-titulo">

                        <div class="seccion-icono">
                            📱
                        </div>

                        <div>

                            <h4>
                                Mis redes sociales
                            </h4>

                            <small>
                                Permite que tus clientes conozcan tu trabajo.
                            </small>

                        </div>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            📸 Instagram
                        </label>

                        <input asp-for="Instagram"
                               class="form-control form-control-lg"
                               placeholder="https://instagram.com/tuusuario" />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            🎵 TikTok
                        </label>

                        <input asp-for="TikTok"
                               class="form-control form-control-lg"
                               placeholder="https://tiktok.com/@@tuusuario" />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            📘 Facebook
                        </label>

                        <input asp-for="Facebook"
                               class="form-control form-control-lg"
                               placeholder="https://facebook.com/tuusuario" />

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- WHATSAPP -->
                <!-- ================================================= -->

                <div class="seccion-perfil">

                    <div class="seccion-titulo">

                        <div class="seccion-icono">
                            💬
                        </div>

                        <div>

                            <h4>
                                WhatsApp
                            </h4>

                            <small>
                                Tus clientes podrán contactarte directamente.
                            </small>

                        </div>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Número de WhatsApp
                        </label>

                        <input asp-for="WhatsApp"
                               class="form-control form-control-lg"
                               placeholder="@whatsappPlaceholder"
                               value="@whatsappValor" />

                        <div class="form-text">

                            Escribe el número con código de país,
                            sin espacios ni símbolos.

                            Ejemplo:
                            <strong>18095551234</strong>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- UBICACIÓN -->
                <!-- ================================================= -->

                <div class="seccion-perfil">

                    <div class="seccion-titulo">

                        <div class="seccion-icono">
                            📍
                        </div>

                        <div>

                            <h4>
                                Ubicación de mi negocio
                            </h4>

                            <small>
                                Ayuda a tus clientes a encontrarte.
                            </small>

                        </div>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Dirección
                        </label>

                        <input type="text"
                               name="DireccionNegocio"
                               class="form-control form-control-lg"
                               value="@negocio?.DireccionNegocio"
                               placeholder="Ej: Calle Principal #25" />

                    </div>


                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Ciudad
                            </label>

                            <input type="text"
                                   name="Ciudad"
                                   class="form-control form-control-lg"
                                   value="@negocio?.Ciudad"
                                   placeholder="Santo Domingo" />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Provincia
                            </label>

                            <input type="text"
                                   name="Provincia"
                                   class="form-control form-control-lg"
                                   value="@negocio?.Provincia"
                                   placeholder="Santo Domingo" />

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- COORDENADAS -->
                    <!-- ================================================= -->

                    <input type="hidden"
                           id="Latitud"
                           name="Latitud"
                           value="@negocio?.Latitud" />

                    <input type="hidden"
                           id="Longitud"
                           name="Longitud"
                           value="@negocio?.Longitud" />


                    <!-- ================================================= -->
                    <!-- MAPA -->
                    <!-- ================================================= -->

                    <div class="mapa-contenedor mb-3">

                        <div class="mapa-header">

                            <div>

                                <strong>
                                    🗺️ Ubicación de tu negocio
                                </strong>

                                <small>
                                    Esta será la ubicación que verán tus clientes.
                                </small>

                            </div>

                            <span id="estadoMapa"
                                  class="estado-mapa">

                                Sin ubicación

                            </span>

                        </div>


                        <div id="mapaGoogle"
                             class="mapa-google">

                            <div id="mapaPlaceholder"
                                 class="mapa-placeholder">

                                <div class="mapa-placeholder-icon">
                                    📍
                                </div>

                                <strong>
                                    Aún no has seleccionado una ubicación
                                </strong>

                                <span>
                                    Presiona "Detectar mi ubicación"
                                    para colocar tu negocio en el mapa.
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- ACCIONES DEL MAPA -->
                    <!-- ================================================= -->

                    <div id="accionesMapa"
                         class="acciones-mapa"
                         style="display:none;">

                        <a id="btnGoogleMaps"
                           href="#"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-google-maps">

                            🗺️ Abrir en Google Maps

                        </a>


                        <a id="btnComoLlegar"
                           href="#"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-como-llegar">

                            🚗 Cómo llegar

                        </a>

                    </div>


                    <!-- ================================================= -->
                    <!-- DETECTAR UBICACIÓN -->
                    <!-- ================================================= -->

                    <div class="ubicacion-box">

                        <div class="ubicacion-icon">
                            📍
                        </div>

                        <div class="flex-grow-1">

                            <strong>
                                Ubicación exacta
                            </strong>

                            <p class="mb-2 text-muted">

                                Permite que TropiNails Pro detecte
                                automáticamente dónde está tu negocio.

                            </p>

                            <button type="button"
                                    class="btn btn-pink"
                                    onclick="obtenerUbicacion()">

                                📍 Detectar mi ubicación

                            </button>

                            <span id="estadoUbicacion"
                                  class="d-block mt-2 small">
                            </span>

                        </div>

                    </div>


                    <input type="hidden"
                           id="UbicacionActiva"
                           name="UbicacionActiva"
                           value="@(negocio?.UbicacionActiva == true ? "true" : "false")" />

                </div>


                <!-- ================================================= -->
                <!-- BOTONES -->
                <!-- ================================================= -->

                <div class="d-grid gap-3 mt-4">

                    <button type="submit"
                            class="btn btn-lg text-white btn-guardar">

                        💾 Guardar cambios

                    </button>


                    <a asp-controller="Perfil"
                       asp-action="Index"
                       class="btn btn-outline-secondary btn-lg btn-cancelar">

                        Cancelar

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


<style>

/* ================================================= */
/* CONTENEDOR */
/* ================================================= */

.perfil-editar{
    max-width:850px;
}


/* ================================================= */
/* CABECERA */
/* ================================================= */

.perfil-header{
    background:linear-gradient(
        135deg,
        #ff4da6,
        #e91e63,
        #c2185b
    );
    color:white;
    padding:42px 20px;
    position:relative;
}

.perfil-header-icon{
    width:65px;
    height:65px;
    margin:0 auto 12px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    background:rgba(255,255,255,.18);
    font-size:30px;
    backdrop-filter:blur(5px);
}

.perfil-header h2{
    font-size:30px;
    letter-spacing:-.4px;
}

.perfil-header p{
    opacity:.92;
    max-width:650px;
    margin-left:auto;
    margin-right:auto;
}


/* ================================================= */
/* SECCIONES */
/* ================================================= */

.seccion-perfil{
    margin-bottom:38px;
    padding-bottom:32px;
    border-bottom:1px solid #eee;
}

.seccion-perfil:last-of-type{
    border-bottom:none;
}

.seccion-titulo{
    display:flex;
    align-items:center;
    gap:15px;
    margin-bottom:27px;
}

.seccion-icono{
    width:52px;
    height:52px;
    min-width:52px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:16px;
    background:linear-gradient(
        135deg,
        #fff0f7,
        #ffe0ed
    );
    font-size:25px;
    box-shadow:0 5px 15px rgba(255,77,166,.08);
}

.seccion-titulo h4{
    margin:0;
    font-weight:750;
    color:#2b2b2b;
}

.seccion-titulo small{
    display:block;
    color:#777;
    margin-top:3px;
}


/* ================================================= */
/* FORMULARIOS */
/* ================================================= */

.form-label{
    font-weight:650;
    color:#333;
    margin-bottom:7px;
}

.form-control,
.form-select{
    border-radius:13px;
    border:1px solid #ddd;
    min-height:48px;
}

textarea.form-control{
    min-height:auto;
}

.form-control:focus,
.form-select:focus{
    border-color:#ff4da6;
    box-shadow:0 0 0 .2rem rgba(255,77,166,.13);
}

.input-group-text{
    border-radius:13px 0 0 13px;
    background:#fff5fa;
    border-color:#ddd;
    color:#d62978;
    font-weight:650;
}


/* ================================================= */
/* FOTOS */
/* ================================================= */

.foto-perfil-wrapper{
    position:relative;
    display:inline-block;
}

.foto-perfil{
    width:160px;
    height:160px;
    object-fit:cover;
    border-radius:50%;
    border:5px solid #ff4da6;
    box-shadow:0 10px 30px rgba(0,0,0,.15);
}

.foto-check{
    position:absolute;
    right:7px;
    bottom:10px;
    width:34px;
    height:34px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#ff4da6;
    color:white;
    border:3px solid white;
    font-weight:bold;
}

.foto-negocio-wrapper{
    width:100%;
    display:flex;
    justify-content:center;
}

.foto-negocio{
    width:100%;
    max-width:560px;
    height:245px;
    object-fit:cover;
    border-radius:22px;
    border:4px solid #ff4da6;
    box-shadow:0 10px 30px rgba(0,0,0,.12);
}


/* ================================================= */
/* BOTONES ROSA */
/* ================================================= */

.btn-outline-pink{
    color:#ff4da6;
    border:2px solid #ff4da6;
    border-radius:12px;
    font-weight:650;
    padding:10px 17px;
    transition:.2s ease;
}

.btn-outline-pink:hover{
    background:#ff4da6;
    color:white;
    transform:translateY(-1px);
}

.btn-pink{
    background:#ff4da6;
    border:none;
    color:white;
    border-radius:12px;
    font-weight:650;
    padding:10px 18px;
    transition:.2s ease;
}

.btn-pink:hover{
    background:#e91e63;
    color:white;
    transform:translateY(-1px);
}


/* ================================================= */
/* SERVICIOS */
/* ================================================= */

.servicios-intro{
    display:flex;
    align-items:flex-start;
    gap:15px;
    padding:18px;
    margin-bottom:20px;
    border-radius:17px;
    background:linear-gradient(
        135deg,
        #fff7fb,
        #fff0f7
    );
    border:1px solid #ffd5e7;
}

.servicios-intro-icon{
    width:45px;
    height:45px;
    min-width:45px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:13px;
    background:white;
    font-size:23px;
    box-shadow:0 4px 12px rgba(0,0,0,.06);
}

.servicios-intro strong{
    display:block;
    color:#333;
    margin-bottom:4px;
