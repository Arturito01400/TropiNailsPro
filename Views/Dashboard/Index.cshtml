@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var usuario = ViewBag.UsuarioNombre as string;

    var clientas = ViewBag.Clientas as List<TropiNailsPro.Models.Usuario>
        ?? new List<TropiNailsPro.Models.Usuario>();

    var linkRegistro = ViewBag.LinkRegistro as string;

    var esClienta = ViewBag.EsClienta as bool? ?? false;

    var plan = ViewBag.Plan as string ?? "Basico";

    var inventarioDesbloqueado =
        ViewBag.InventarioDesbloqueado as bool? ?? false;

    var pagosDesbloqueados =
        ViewBag.PagosDesbloqueados as bool? ?? false;

    var estadisticasDesbloqueadas = true;

    var mostrarSuscripcion =
        ViewBag.MostrarSuscripcion as bool? ?? false;

    var siguienteClienteDesbloqueado = true;

    var citasHoy =
        ViewBag.CitasHoy as List<TropiNailsPro.Models.Cita>
        ?? new List<TropiNailsPro.Models.Cita>();
}

<style>

/* =========================================================
   DASHBOARD
   ========================================================= */

body{
    background:linear-gradient(to right,#ffe5ec,#e0f7fa);
    overflow-x:hidden;
}


/* =========================================================
   PANEL PRINCIPAL
   ========================================================= */

.dashboard-panel{
    background:#111;
    padding:35px;
    border-radius:18px;
    box-shadow:0 10px 30px rgba(0,0,0,.25);
}

.dashboard-panel .card{
    background:white;
    cursor:pointer;
    border-radius:12px;
    transition:none;
    transform:none;
    min-height:auto;
}


/* Mantiene las tarjetas actuales sin movimiento */

.dashboard-panel .card:hover{
    transform:none;
}


/* =========================================================
   HEADER
   ========================================================= */

.dashboard-header{
    margin-bottom:30px;
    text-align:center;
}

.dashboard-header h1{
    font-size:2.2rem;
    color:#333;
}

.dashboard-header p{
    color:#666;
}


/* =========================================================
   ANTIGUA TARJETA DE CLIENTA
   ========================================================= */

.clienta-card{
    border-radius:12px;
    background:#fff0f6;
    padding:15px;
    margin-bottom:15px;
    box-shadow:0 2px 8px rgba(0,0,0,.1);
}


/* =========================================================
   CHAT
   ========================================================= */

.chat-card{
    background:linear-gradient(
        135deg,
        #ff80ab,
        #f06292
    );
    color:white;
}

.chat-card .btn{
    background:white;
    color:#e91e63;
    font-weight:bold;
    border:none;
}

.chat-card .btn:hover{
    background:#ffe4ec;
}


/* =========================================================
   LINK REGISTRO
   ========================================================= */

.link-registro{
    margin-bottom:20px;
    text-align:center;
}

.link-registro input{
    width:70%;
    text-align:center;
    padding:8px;
    border-radius:5px;
    border:1px solid #ccc;
}


/* =========================================================
   FINANZAS
   ========================================================= */

.fin-card{
    background:white;
    border-radius:12px;
    padding:20px;
    box-shadow:0 4px 15px rgba(0,0,0,.15);
    text-align:center;
}

.fin-card h4{
    color:#e91e63;
    font-weight:bold;
}

.fin-card span{
    font-size:22px;
    font-weight:bold;
}


/* =========================================================
   PREMIUM
   ========================================================= */

.premium-lock{
    display:inline-block;
    padding:6px 14px;
    background:#fff3cd;
    border-radius:25px;
    font-size:.85rem;
    font-weight:700;
}


/* =========================================================
   TARJETAS FINANCIERAS
   ========================================================= */

.finance-module-card{
    background:white;
    border-radius:18px;
    padding:25px;
    box-shadow:0 8px 25px rgba(0,0,0,.10);
    transition:.3s;
}

.finance-module-card:hover{
    transform:translateY(-5px);
}

.finance-module-icon{
    font-size:45px;
    margin-bottom:15px;
}


/* =========================================================
   👩‍💼 MIS CLIENTAS — DISEÑO PREMIUM
   ========================================================= */

.clientas-section{
    width:100%;
    max-width:1200px;
    margin:55px auto 0;
    padding:0 15px;
}

.clientas-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    margin-bottom:22px;
    padding:0 5px;
}

.clientas-title-box{
    display:flex;
    align-items:center;
    gap:14px;
}

.clientas-title-icon{
    width:52px;
    height:52px;
    border-radius:16px;
    background:linear-gradient(
        135deg,
        #ff4f9a,
        #ff80ab
    );
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:26px;
    box-shadow:0 7px 18px rgba(233,30,99,.22);
}

.clientas-title{
    margin:0;
    font-size:28px;
    font-weight:800;
    color:#222;
}

.clientas-subtitle{
    margin:4px 0 0;
    color:#777;
    font-size:14px;
}

.clientas-counter{
    background:white;
    border-radius:14px;
    padding:10px 16px;
    box-shadow:0 5px 18px rgba(0,0,0,.08);
    border:1px solid rgba(233,30,99,.08);
    display:flex;
    align-items:center;
    gap:8px;
    white-space:nowrap;
}

.clientas-counter-number{
    font-size:20px;
    font-weight:800;
    color:#e91e63;
}

.clientas-counter-text{
    font-size:13px;
    color:#666;
    font-weight:600;
}


/* =========================================================
   TABLA
   ========================================================= */

.clientas-table-card{
    background:white;
    border-radius:22px;
    overflow:hidden;
    box-shadow:
        0 10px 30px rgba(0,0,0,.09);
    border:1px solid rgba(0,0,0,.04);
}

.clientas-table-wrapper{
    width:100%;
    overflow-x:auto;
}

.clientas-table{
    width:100%;
    border-collapse:collapse;
    margin:0;
}

.clientas-table thead{
    background:linear-gradient(
        135deg,
        #fff5f9,
        #f8fbff
    );
}

.clientas-table th{
    padding:17px 20px;
    text-align:left;
    font-size:12px;
    font-weight:800;
    color:#777;
    text-transform:uppercase;
    letter-spacing:.5px;
    border-bottom:1px solid #edf0f5;
    white-space:nowrap;
}

.clientas-table td{
    padding:17px 20px;
    border-bottom:1px solid #f0f2f6;
    vertical-align:middle;
    color:#444;
    font-size:14px;
}

.clientas-table tbody tr{
    transition:.22s ease;
}

.clientas-table tbody tr:hover{
    background:#fff8fb;
}

.clientas-table tbody tr:last-child td{
    border-bottom:none;
}


/* =========================================================
   CLIENTA
   ========================================================= */

.clienta-info{
    display:flex;
    align-items:center;
    gap:12px;
    min-width:200px;
}

.clienta-avatar{
    width:46px;
    height:46px;
    min-width:46px;
    border-radius:50%;
    background:linear-gradient(
        135deg,
        #ff4f9a,
        #ff9cc1
    );
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:21px;
    box-shadow:0 4px 12px rgba(233,30,99,.18);
}

.clienta-name{
    font-weight:750;
    color:#222;
    font-size:15px;
    word-break:break-word;
}

.clienta-label{
    display:block;
    color:#999;
    font-size:11px;
    margin-top:2px;
}


/* =========================================================
   CORREO
   ========================================================= */

.clienta-email{
    color:#555;
    word-break:break-word;
}

.clienta-email-icon{
    color:#e91e63;
    margin-right:6px;
}


/* =========================================================
   TELEFONO
   ========================================================= */

.clienta-phone{
    color:#555;
    white-space:nowrap;
}

.clienta-phone-icon{
    color:#e91e63;
    margin-right:6px;
}


/* =========================================================
   FECHA
   ========================================================= */

.clienta-date{
    white-space:nowrap;
    color:#666;
}

.clienta-date-icon{
    color:#e91e63;
    margin-right:6px;
}


/* =========================================================
   ESTADO
   ========================================================= */

.clienta-status{
    display:inline-flex;
    align-items:center;
    gap:6px;
    background:#ecfdf3;
    color:#16803c;
    border-radius:30px;
    padding:6px 11px;
    font-size:11px;
    font-weight:700;
}

.clienta-status-dot{
    width:7px;
    height:7px;
    border-radius:50%;
    background:#22c55e;
}


/* =========================================================
   SIN CLIENTAS
   ========================================================= */

.clientas-empty{
    padding:50px 20px;
    text-align:center;
}

.clientas-empty-icon{
    font-size:48px;
    margin-bottom:12px;
}

.clientas-empty-title{
    font-size:18px;
    font-weight:700;
    color:#333;
    margin-bottom:5px;
}

.clientas-empty-text{
    color:#888;
    font-size:14px;
}


/* =========================================================
   MOBILE
   ========================================================= */

@@media screen and (max-width:768px){

    .dashboard-panel{
        padding:20px;
    }

    .link-registro input{
        width:100%;
    }

    .clientas-section{
        margin-top:40px;
        padding:0 10px;
    }

    .clientas-header{
        flex-direction:column;
        align-items:flex-start;
        gap:14px;
    }

    .clientas-title{
        font-size:24px;
    }

    .clientas-counter{
        align-self:flex-start;
    }

    .clientas-table-card{
        border-radius:18px;
    }

    .clientas-table th,
    .clientas-table td{
        padding:14px 15px;
    }

}


/* =========================================================
   TELEFONOS PEQUEÑOS
   ========================================================= */

@@media screen and (max-width:480px){

    .clientas-title-box{
        gap:10px;
    }

    .clientas-title-icon{
        width:46px;
        height:46px;
        border-radius:14px;
        font-size:23px;
    }

    .clientas-title{
        font-size:21px;
    }

    .clientas-subtitle{
        font-size:12px;
    }

    .clientas-table{
        min-width:760px;
    }

}

</style>


<div class="dashboard-header">

    <h1>👋 ¡Bienvenida, @usuario!</h1>

    <p>
        Selecciona una opción para comenzar.
    </p>

</div>


<div class="link-registro">

    <label>
        🔗 Link único para tus clientas:
    </label>

    <input
        type="text"
        value="@linkRegistro"
        readonly
        onclick="this.select();" />

</div>


<div class="dashboard-panel">

    <div class="row g-4 justify-content-center">

        @if(!esClienta)
        {

            <div class="col-md-4">

                <div class="card h-100 shadow-sm"
                     onclick="window.location.href='@Url.Action("Index","Citas")'">

                    <div class="card-body text-center">

                        <h5>📅 Gestionar Citas</h5>

                        <a asp-controller="Citas"
                           asp-action="Index"
                           class="btn btn-primary">

                            Ir a Citas

                        </a>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card h-100 shadow-sm"
                     onclick="window.location.href='@Url.Action("Index","ModelosUnas")'">

                    <div class="card-body text-center">

                        <h5>🌸 Portafolio</h5>

                        <a asp-controller="ModelosUnas"
                           asp-action="Index"
                           class="btn btn-success">

                            Ver Portafolio

                        </a>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card h-100 shadow-sm chat-card"
                     onclick="window.location.href='@Url.Action("Index","Chat")'">

                    <div class="card-body text-center">

                        <h5>💬 Chat con Clientas</h5>

                        <a asp-controller="Chat"
                           asp-action="Index"
                           class="btn">

                            Abrir Chat

                        </a>

                    </div>

                </div>

            </div>


            <!-- INVENTARIO PREMIUM -->

            <div class="col-md-4">

                @if(inventarioDesbloqueado)
                {

                    <div class="card h-100 shadow-sm border-info"
                         onclick="window.location.href='@Url.Action("Index","Productos")'">

                        <div class="card-body text-center">

                            <h5>📦 Inventario</h5>

                            <p class="text-muted small">
                                Controla productos y stock
                            </p>

                            <a asp-controller="Productos"
                               asp-action="Index"
                               class="btn btn-info text-white">

                                Abrir Inventario

                            </a>

                        </div>

                    </div>

                }
                else
                {

                    <div class="card h-100 shadow-sm border-warning"
                         onclick="window.location.href='@Url.Action("PremiumRequired","Dashboard")'">

                        <div class="card-body text-center">

                            <h5>📦 Inventario</h5>

                            <span class="premium-lock">
                                🔒 Premium
                            </span>

                            <br/><br/>

                            <a asp-controller="Dashboard"
                               asp-action="PremiumRequired"
                               class="btn btn-warning">

                                Actualizar Plan

                            </a>

                        </div>

                    </div>

                }

            </div>


            <!-- PAGOS PREMIUM -->

            <div class="col-md-4">

                @if(pagosDesbloqueados)
                {

                    <div class="card h-100 shadow-sm"
                         onclick="window.location.href='@Url.Action("Lista","Pagos")'">

                        <div class="card-body text-center">

                            <h5>💰 Pagos Recibidos</h5>

                            <a asp-controller="Pagos"
                               asp-action="Lista"
                               class="btn btn-outline-primary">

                                Ver Pagos

                            </a>

                        </div>

                    </div>

                }
                else
                {

                    <div class="card h-100 shadow-sm border-warning"
                         onclick="window.location.href='@Url.Action("PremiumPagos","Dashboard")'">

                        <div class="card-body text-center">

                            <h5>💰 Registro de Pagos</h5>

                            <span class="premium-lock">
                                🔒 Premium
                            </span>

                            <br/><br/>

                            <a asp-controller="Dashboard"
                               asp-action="PremiumRequired"
                               class="btn btn-warning">

                                Actualizar Plan

                            </a>

                        </div>

                    </div>

                }

            </div>


            <!-- GASTOS DEL NEGOCIO -->

            <div class="col-md-4">

                <div class="card h-100 finance-module-card border-danger"
                     onclick="window.location.href='@Url.Action("Index","Gastos")'">

                    <div class="card-body text-center">

                        <h5>
                            💼 Gastos del Negocio
                        </h5>

                        <p class="text-muted small">

                            Controla materiales, productos,
                            publicidad y costos del emprendimiento.

                        </p>

                        <a asp-controller="Gastos"
                           asp-action="Index"
                           class="btn btn-danger">

                            Ver Gastos

                        </a>

                    </div>

                </div>

            </div>


            <!-- RESUMEN FINANCIERO -->

            <div class="col-md-4">

                <div class="card h-100 finance-module-card border-success"
                     onclick="window.location.href='@Url.Action("ResumenMensual","Finanzas")'">

                    <div class="card-body text-center">

                        <h5>
                            📊 Resumen Financiero
                        </h5>

                        <p class="text-muted small">

                            Analiza ingresos, gastos y ganancias
                            de tu negocio.

                        </p>

                        <a asp-controller="Finanzas"
                           asp-action="ResumenMensual"
                           class="btn btn-success">

                            Ver Resumen

                        </a>

                    </div>

                </div>

            </div>


            <!-- GASTOS PERSONALES -->

            <div class="col-md-4">

                <div class="card h-100 finance-module-card border-primary"
                     onclick="window.location.href='@Url.Action("Index","GastosPersonales")'">

                    <div class="card-body text-center">

                        <h5>
                            👤 Gastos Personales
                        </h5>

                        <p class="text-muted small">

                            Separa tus gastos personales
                            de las finanzas del negocio.

                        </p>

                        <a asp-controller="GastosPersonales"
                           asp-action="Index"
                           class="btn btn-primary">

                            Ver Gastos Personales

                        </a>

                    </div>

                </div>

            </div>


            <!-- ESTADÍSTICAS -->

            <div class="col-md-4">

                <div class="card h-100 shadow-sm border-warning">

                    <div class="card-body text-center">

                        <h5>📊 Estadísticas</h5>

                        <button class="btn btn-warning"
                                disabled>

                            Próximamente

                        </button>

                    </div>

                </div>

            </div>


            <!-- CITAS DE HOY -->

            <div class="col-md-4">

                <div class="card h-100 shadow-sm border-dark"
                     onclick="window.location.href='@Url.Action("Index","Citas")#hoy'">

                    <div class="card-body text-center">

                        <h5>➡️ Citas de hoy</h5>

                        <h2>@citasHoy.Count</h2>

                        <a href="/Citas/Index#hoy"
                           class="btn btn-dark">

                            Atender

                        </a>

                    </div>

                </div>

            </div>


            @if(usuario=="Arturo Quezada Montero")
            {

                <div class="col-md-4">

                    <div class="card h-100 shadow-sm border-dark"
                         onclick="window.location.href='@Url.Action("Crecimiento","Propietario")'">

                        <div class="card-body text-center">

                            <h5>🧠 Panel del Propietario</h5>

                            <p class="text-muted small">
                                Monitorear crecimiento
                            </p>

                            <a asp-controller="Propietario"
                               asp-action="Crecimiento"
                               class="btn btn-dark">

                                Abrir Panel

                            </a>

                        </div>

                    </div>

                </div>

            }


            @if(mostrarSuscripcion)
            {

                <div class="col-12 text-center mt-3">

                    <p class="text-danger fw-bold">

                        Tu periodo de prueba terminó.
                        Debes suscribirte para continuar.

                    </p>

                </div>

            }

        }

    </div>

</div>


<!-- =========================================================
     👩‍💼 MIS CLIENTAS
     ========================================================= -->

<div class="clientas-section">

    <div class="clientas-header">

        <div class="clientas-title-box">

            <div class="clientas-title-icon">
                👩‍💼
            </div>

            <div>

                <h3 class="clientas-title">
                    Mis clientas
                </h3>

                <p class="clientas-subtitle">
                    Administra y consulta las clientas registradas en tu negocio
                </p>

            </div>

        </div>


        <div class="clientas-counter">

            <span class="clientas-counter-number">
                @clientas.Count
            </span>

            <span class="clientas-counter-text">
                @(clientas.Count == 1 ? "clienta registrada" : "clientas registradas")
            </span>

        </div>

    </div>


    <div id="lista-clientas"
         class="clientas-table-card">

        @if(clientas.Any())
        {

            <div class="clientas-table-wrapper">

                <table class="clientas-table">

                    <thead>

                        <tr>

                            <th>
                                Clienta
                            </th>

                            <th>
                                Correo electrónico
                            </th>

                            <th>
                                Teléfono
                            </th>

                            <th>
                                Fecha de registro
                            </th>

                            <th>
                                Estado
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach(var c in clientas)
                        {

                            <tr>

                                <td>

                                    <div class="clienta-info">

                                        <div class="clienta-avatar">
                                            👩
                                        </div>

                                        <div>

                                            <div class="clienta-name">
                                                @c.Nombre
                                            </div>

                                            <span class="clienta-label">
                                                Clienta TropiNails Pro
                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <td>

                                    <div class="clienta-email">

                                        <span class="clienta-email-icon">
                                            ✉
                                        </span>

                                        @c.Email

                                    </div>

                                </td>


                                <td>

                                    <div class="clienta-phone">

                                        <span class="clienta-phone-icon">
                                            📱
                                        </span>

                                        @c.Telefono

                                    </div>

                                </td>


                                <td>

                                    <div class="clienta-date">

                                        <span class="clienta-date-icon">
                                            📅
                                        </span>

                                        @c.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy")

                                        <br/>

                                        <small class="text-muted">

                                            @c.FechaRegistro.ToLocalTime().ToString("HH:mm")

                                        </small>

                                    </div>

                                </td>


                                <td>

                                    <span class="clienta-status">

                                        <span class="clienta-status-dot"></span>

                                        Registrada

                                    </span>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        }
        else
        {

            <div class="clientas-empty">

                <div class="clientas-empty-icon">
                    👩‍💼
                </div>

                <div class="clientas-empty-title">
                    Aún no tienes clientas registradas
                </div>

                <div class="clientas-empty-text">
                    Comparte tu link de registro para comenzar a recibir clientas.
                </div>

            </div>

        }

    </div>

</div>


<!-- =========================================================
     ESTADÍSTICAS FINANCIERAS
     ========================================================= -->

<h3 class="mt-5 mb-4 text-center">
    📊 Estadísticas Financieras
</h3>


<div class="row text-center mb-4">

    <div class="col-md-4">

        <div class="fin-card">

            <h4>💰 Ingresos Hoy</h4>

            <span>
                $@Convert.ToDecimal(
                    ViewBag.IngresosHoy
                ).ToString("N2")
            </span>

        </div>

    </div>


    <div class="col-md-4">

        <div class="fin-card">

            <h4>💰 Ingresos del Mes</h4>

            <span>
                $@Convert.ToDecimal(
                    ViewBag.IngresosMes
                ).ToString("N2")
            </span>

        </div>

    </div>


    <div class="col-md-4">

        <div class="fin-card">

            <h4>💰 Ingresos del Año</h4>

            <span>
                $@Convert.ToDecimal(
                    ViewBag.IngresosAnio
                ).ToString("N2")
            </span>

        </div>

    </div>

</div>


<!-- =========================================================
     CLIENTAS QUE DEBEN
     ========================================================= -->

<h4 class="text-center mb-3">
    📉 Clientes que deben
</h4>


@if(ViewBag.ClientasDeudoras != null &&
   ViewBag.ClientasDeudoras.Count > 0)
{

    <table class="table table-bordered text-center">

        <thead class="table-danger">

            <tr>

                <th>
                    Clienta
                </th>

                <th>
                    Monto
                </th>

                <th>
                    Estado
                </th>

            </tr>

        </thead>


        <tbody>

            @foreach(var d in ViewBag.ClientasDeudoras)
            {

                <tr>

                    <td>
                        @d.ClienteNombre
                    </td>

                    <td>

                        $@Convert.ToDecimal(
                            d.Monto
                        ).ToString("N2")

                    </td>

                    <td class="text-danger">
                        Pendiente
                    </td>

                </tr>

            }

        </tbody>

    </table>

}
else
{

    <p class="text-center text-success">
        No hay clientas con deuda 🎉
    </p>

}


<!-- =========================================================
     GRÁFICA
     ========================================================= -->

<h4 class="text-center mt-5">
    📊 Gráfica de ingresos
</h4>


<canvas id="graficaIngresos"
        height="100">
</canvas>


@section Scripts{

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const datos = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                ViewBag.GraficaIngresos ?? new List<object>()
            )
        );

        const labels = datos.map(x => "Mes " + x.Mes);

        const valores = datos.map(x => x.Total);

        const ctx =
            document
                .getElementById('graficaIngresos')
                .getContext('2d');

        new Chart(ctx,{
            type:'line',

            data:{
                labels:labels,

                datasets:[
                    {
                        label:'Ingresos',
                        data:valores,
                        borderColor:'#e91e63',
                        backgroundColor:
                            'rgba(233,30,99,0.2)',
                        tension:0.4
                    }
                ]
            }
        });

    </script>

}