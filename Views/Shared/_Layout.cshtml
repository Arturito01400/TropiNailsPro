
@using Microsoft.AspNetCore.Http
@using System.IO
@using Microsoft.AspNetCore.Hosting
@inject IHttpContextAccessor HttpContextAccessor
@inject IWebHostEnvironment env
@inject IConfiguration Configuration

@{
    var title = ViewData["Title"] ?? "TropiNails Pro";

    var usuario =
        HttpContextAccessor.HttpContext?
        .Session.GetString("UsuarioNombre");

    var foto =
        HttpContextAccessor.HttpContext?
        .Session.GetString("UsuarioFoto");

    var ultimaConexion =
        HttpContextAccessor.HttpContext?
        .Session.GetString("UsuarioUltimaConexion");

    var avatarPorDefecto =
        "/img/user-default.png";

    var fotoSesion =
        string.IsNullOrWhiteSpace(foto)
        ? avatarPorDefecto
        : foto.Replace("\\", "/");

    if (!fotoSesion.StartsWith("/")
        &&
        !fotoSesion.StartsWith("http"))
    {
        fotoSesion = "/" + fotoSesion;
    }

    var avatarFinal = fotoSesion;

    DateTime ultimaConexionDt;

    bool tieneUltimaConexion =
        DateTime.TryParse(
            ultimaConexion,
            out ultimaConexionDt
        );

    var version = DateTime.Now.Second;

    // =========================================================
    // VAPID — SOLO PUBLIC KEY
    // =========================================================
    // La PublicKey se obtiene desde Azure Configuration.
    //
    // IMPORTANTE:
    // La PrivateKey NUNCA se expone al navegador.
    // =========================================================

    var vapidPublicKey =
        Configuration["VAPID:PublicKey"];
}

