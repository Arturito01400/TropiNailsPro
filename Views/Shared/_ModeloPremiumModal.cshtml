<div class="modelo-premium-overlay"
     id="modeloPremiumModal">

    <div class="modelo-premium-container">

        <!-- BOTÓN CERRAR -->
        <button class="modelo-premium-close"
                type="button"
                onclick="cerrarModeloPremium()">
            ✕
        </button>

        <!-- CONTENIDO (IMAGEN O VIDEO) -->
        <div class="modelo-premium-media"
             id="modeloPremiumMedia">

        </div>

        <!-- INFORMACIÓN -->
        <div class="modelo-premium-info">

            <h2 id="modeloPremiumNombre">
            </h2>

            <p id="modeloPremiumDescripcion">
            </p>

            <div class="modelo-premium-stats">

                <span>
                    👁️ Diseño seleccionado
                </span>

            </div>

            <button id="btnReservarModelo"
                    class="modelo-premium-reservar"
                    type="button">

                💅 Reservar este diseño

            </button>

        </div>

    </div>

</div>