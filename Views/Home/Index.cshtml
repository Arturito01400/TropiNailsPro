<script>

    document.addEventListener("DOMContentLoaded", function () {

        const input =
            document.getElementById("beautySearchInput");

        const searchButton =
            document.getElementById("beautySearchButton");

        const nearMeButton =
            document.getElementById("nearMeButton");

        const findProfessionalsButton =
            document.getElementById("findProfessionalsButton");

        const loading =
            document.getElementById("searchLoading");

        const resultsSection =
            document.getElementById("searchResultsSection");

        const professionalsGrid =
            document.getElementById("professionalsGrid");

        const externalGrid =
            document.getElementById("externalGrid");

        const externalResults =
            document.getElementById("externalResults");

        const emptyResults =
            document.getElementById("emptyResults");

        const resultsTitle =
            document.getElementById("resultsTitle");

        const resultsCount =
            document.getElementById("resultsCount");


        let userLatitude = null;
        let userLongitude = null;


        /* =====================================================
           OBTENER UBICACIÓN
           ===================================================== */

        function obtenerUbicacion() {

            return new Promise(function (resolve) {

                if (!navigator.geolocation) {
                    console.warn("Este navegador no soporta geolocalización.");
                    resolve(null);
                    return;
                }

                let finalizado = false;

                function completar(resultado) {
                    if (finalizado) return;
                    finalizado = true;
                    resolve(resultado);
                }

                function procesarPosicion(position) {

                    const latitud = Number(position.coords.latitude);
                    const longitud = Number(position.coords.longitude);

                    if (!Number.isFinite(latitud) ||
                        !Number.isFinite(longitud) ||
                        latitud < -90 ||
                        latitud > 90 ||
                        longitud < -180 ||
                        longitud > 180) {

                        console.warn("La geolocalización devolvió coordenadas inválidas.");
                        completar(null);
                        return;
                    }

                    userLatitude = latitud;
                    userLongitude = longitud;

                    console.log("Ubicación obtenida:", {
                        latitud: userLatitude,
                        longitud: userLongitude
                    });

                    completar({
                        latitud: userLatitude,
                        longitud: userLongitude
                    });
                }

                function procesarError(error) {

                    if (error && error.code === 1) {
                        console.warn("El usuario no permitió el acceso a la ubicación.");
                        completar(null);
                        return;
                    }

                    console.warn(
                        "No se pudo obtener la ubicación con alta precisión. Se intentará nuevamente con una ubicación más rápida.",
                        error
                    );

                    navigator.geolocation.getCurrentPosition(
                        procesarPosicion,
                        function (errorFallback) {
                            console.warn("No se pudo obtener la ubicación:", errorFallback);
                            completar(null);
                        },
                        {
                            enableHighAccuracy: false,
                            timeout: 10000,
                            maximumAge: 60000
                        }
                    );
                }

                navigator.geolocation.getCurrentPosition(
                    procesarPosicion,
                    procesarError,
                    {
                        enableHighAccuracy: true,
                        timeout: 12000,
                        maximumAge: 60000
                    }
                );

            });

        }


        /* =====================================================
           ESCAPAR HTML
           ===================================================== */

        function escapeHtml(value) {

            if (value === null ||
                value === undefined) {

                return "";
            }

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }


        /* =====================================================
           BUSCAR
           ===================================================== */

        async function buscar(texto, usarUbicacion) {

            texto = (texto || "").trim();


            if (!texto) {

                input.focus();

                return;
            }


            loading.classList.add("visible");

            searchButton.disabled = true;

            emptyResults.classList.remove("visible");

            professionalsGrid.innerHTML = "";

            externalGrid.innerHTML = "";

            externalResults.style.display = "none";


            if (usarUbicacion) {

                // Nunca reutilizamos una ubicación vieja si la nueva consulta falla.
                userLatitude = null;
                userLongitude = null;

                const ubicacion = await obtenerUbicacion();

                if (ubicacion) {
                    console.log("Buscando con ubicación del usuario:", ubicacion);
                }
                else {
                    console.warn(
                        "La búsqueda continuará sin ubicación. Los profesionales de TropiNails seguirán funcionando, pero Google Places puede no devolver negocios cercanos."
                    );
                }

            }


            try {

                const params =
                    new URLSearchParams();


                params.append("texto", texto);


                if (Number.isFinite(userLatitude) &&
                    Number.isFinite(userLongitude)) {

                    params.append(
                        "latitud",
                        userLatitude
                    );

                    params.append(
                        "longitud",
                        userLongitude
                    );

                }


                const response =
                    await fetch(
                        "/Home/Buscar?" +
                        params.toString(),
                        {
                            method: "GET",
                            headers: {
                                "Accept":
                                    "application/json"
                            },
                            cache: "no-store"
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        "No se pudo completar la búsqueda."
                    );

                }


                const data =
                    await response.json();


                if (!data.exito) {

                    throw new Error(
                        data.mensaje ||
                        "No pudimos realizar la búsqueda."
                    );

                }


                mostrarResultados(
                    texto,
                    data
                );


            }
            catch (error) {

                console.error(
                    "Error buscando profesionales:",
                    error
                );

                resultsSection.classList.add(
                    "visible"
                );

                resultsTitle.textContent =
                    "No pudimos completar la búsqueda";

                resultsCount.textContent = "";

                emptyResults.classList.add(
                    "visible"
                );

            }
            finally {

                loading.classList.remove(
                    "visible"
                );

                searchButton.disabled =
                    false;

            }

        }


        /* =====================================================
           MOSTRAR RESULTADOS
           ===================================================== */

        function mostrarResultados(
            texto,
            data
        ) {

            const profesionales =
                Array.isArray(data.profesionales)
                    ? data.profesionales
                    : [];

            const negocios =
                Array.isArray(data.negocios)
                    ? data.negocios
                    : [];


            resultsSection.classList.add(
                "visible"
            );


            resultsTitle.textContent =
                "Resultados para “" +
                texto +
                "”";


            resultsCount.textContent =
                profesionales.length +
                " profesional" +
                (profesionales.length === 1
                    ? ""
                    : "es");


            professionalsGrid.innerHTML = "";


            if (profesionales.length === 0) {

                emptyResults.classList.add(
                    "visible"
                );

            }
            else {

                emptyResults.classList.remove(
                    "visible"
                );


                profesionales.forEach(
    function (profesional) {

        professionalsGrid.insertAdjacentHTML(
            "beforeend",
            crearCardProfesional(
                profesional
            )
        );

    }
);

            }


            /* =================================================
               GOOGLE / NEGOCIOS EXTERNOS
               ================================================= */

            if (negocios.length > 0) {

                externalResults.style.display =
                    "block";


                negocios.forEach(
                    function (negocio) {

                        externalGrid
                            .insertAdjacentHTML(
                                "beforeend",
                                crearCardNegocio(
                                    negocio
                                )
                            );

                    }
                );

            }


            setTimeout(function () {

                resultsSection.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });

            }, 100);

        }


        /* =====================================================
   CARD PROFESIONAL — RESULTADO DE BÚSQUEDA
   ===================================================== */

/* =====================================================
   CARD PROFESIONAL — TROPINAILS BEAUTY PROFILE
   ===================================================== */

function crearCardProfesional(profesional) {

    const id =
        profesional.id || "";

    const nombre =
        profesional.nombre ||
        profesional.nombreCompleto ||
        profesional.userName ||
        "Profesional de belleza";


    /* =====================================================
       UBICACIÓN
       ===================================================== */

    const direccion =
        profesional.direccion ||
        profesional.ciudad ||
        profesional.provincia ||
        "Ubicación disponible";


    /* =====================================================
       FOTO DE PERFIL
       ===================================================== */

    const fotoPerfil =
        profesional.fotoPerfil ||
        profesional.foto ||
        profesional.imagen ||
        profesional.imagenUrl ||
        "";


    /* =====================================================
       FOTO DE PORTADA
       ===================================================== */

    const fotoPortada =
        profesional.fotoPortada ||
        profesional.portada ||
        profesional.imagenPortada ||
        profesional.banner ||
        profesional.bannerUrl ||
        "";


    /* =====================================================
       CATEGORÍA
       ===================================================== */

    const categoria =
        profesional.categoria ||
        profesional.especialidad ||
        profesional.tipoProfesional ||
        "Profesional de belleza";


    /* =====================================================
       ESTADÍSTICAS
       ===================================================== */

    const servicios =
        profesional.totalServicios ??
        profesional.cantidadServicios ??
        profesional.servicios ??
        0;


    const trabajos =
        profesional.totalTrabajos ??
        profesional.cantidadTrabajos ??
        profesional.trabajos ??
        profesional.modelos ??
        0;


    const publicaciones =
        profesional.totalPublicaciones ??
        profesional.cantidadPublicaciones ??
        profesional.publicaciones ??
        0;


    /* =====================================================
       URL DEL PERFIL
       ===================================================== */

    const perfilUrl =
        "/Salones/Index/" +
        encodeURIComponent(id);


    /* =====================================================
       PORTADA
       ===================================================== */

    const portadaHtml =
        fotoPortada
            ?
            `
            <img
                src="${escapeHtml(fotoPortada)}"
                alt=""
                loading="lazy"
                onerror="
                    this.style.display='none';
                    this.nextElementSibling.style.display='flex';
                "
            />

            <div
                class="professional-cover-placeholder"
                style="display:none;">

                <i class="bi bi-stars"></i>

            </div>
            `
            :
            `
            <div class="professional-cover-placeholder">

                <i class="bi bi-stars"></i>

            </div>
            `;


    /* =====================================================
       FOTO DE PERFIL
       ===================================================== */

    const avatarHtml =
        fotoPerfil
            ?
            `
            <img
                src="${escapeHtml(fotoPerfil)}"
                alt="${escapeHtml(nombre)}"
                loading="lazy"
                onerror="
                    this.style.display='none';
                    this.nextElementSibling.style.display='flex';
                "
            />

            <div
                class="professional-avatar-placeholder"
                style="display:none;">

                <i class="bi bi-person-heart"></i>

            </div>
            `
            :
            `
            <div class="professional-avatar-placeholder">

                <i class="bi bi-person-heart"></i>

            </div>
            `;


    /* =====================================================
       HTML FINAL
       ===================================================== */

    return `

        <article class="professional-card">


            <!-- =================================================
                 PORTADA
                 ================================================= -->

            <div class="professional-cover">

                ${portadaHtml}


                <!-- BADGE -->

                <div class="professional-top-badge">

                    <i class="bi bi-stars"></i>

                    TropiNails Pro

                </div>


                <!-- ESTADO -->

                <div
                    class="professional-status"
                    title="Profesional en TropiNails">

                    <i class="bi bi-patch-check-fill"></i>

                </div>


                <!-- INFORMACIÓN SOBRE PORTADA -->

                <div class="professional-cover-info">

                    <div class="professional-cover-category">

                        ${escapeHtml(categoria)}

                    </div>

                    <div class="professional-cover-name">

                        ${escapeHtml(nombre)}

                    </div>

                </div>


                <!-- FOTO DE PERFIL -->

                <div class="professional-avatar">

                    ${avatarHtml}


                    <div class="professional-verified">

                        <i class="bi bi-check-lg"></i>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 CONTENIDO
                 ================================================= -->

            <div class="professional-content">


                <!-- UBICACIÓN -->

                <div class="professional-location">

                    <i class="bi bi-geo-alt-fill"></i>

                    <span>
                        ${escapeHtml(direccion)}
                    </span>

                </div>


                <!-- ESTADÍSTICAS -->

                <div class="professional-stats">


                    <div class="professional-stat">

                        <strong>
                            ${escapeHtml(servicios)}
                        </strong>

                        <span>
                            Servicios
                        </span>

                    </div>


                    <div class="professional-stat">

                        <strong>
                            ${escapeHtml(trabajos)}
                        </strong>

                        <span>
                            Trabajos
                        </span>

                    </div>


                    <div class="professional-stat">

                        <strong>
                            ${escapeHtml(publicaciones)}
                        </strong>

                        <span>
                            Publicaciones
                        </span>

                    </div>


                </div>


                <!-- BOTONES -->

                <div class="professional-actions">


                    <a
                        href="${perfilUrl}"
                        class="professional-action primary">

                        <i class="bi bi-person-heart"></i>

                        Ver perfil

                    </a>


                    <a
                        href="${perfilUrl}"
                        class="professional-action secondary">

                        <i class="bi bi-calendar-heart"></i>

                        Agendar

                    </a>


                </div>

            </div>

        </article>

    `;
}


        /* =====================================================
           CARD NEGOCIO EXTERNO
           ===================================================== */

        function crearCardNegocio(
            negocio
        ) {

            const nombre =
                negocio.nombre ||
                "Negocio de belleza";


            const direccion =
                negocio.direccion ||
                "Ubicación no disponible";


            const rating =
                negocio.rating;


            const reviews =
                negocio.reviews;


            let ratingHtml = "";


            if (rating) {

                ratingHtml =
                    `
                    <div class="external-rating">

                        ⭐ ${escapeHtml(rating)}

                        ${
                            reviews
                                ? ` · ${escapeHtml(reviews)} reseñas`
                                : ""
                        }

                    </div>
                    `;

            }


            const mapsUrl =
                negocio.mapsUrl || "#";


            return `
                <article class="external-card">

                    <h4>

                        ${escapeHtml(nombre)}

                    </h4>


                    <p>

                        ${escapeHtml(direccion)}

                    </p>


                    ${ratingHtml}


                    ${
                        mapsUrl !== "#"
                        ?
                        `
                        <a href="${escapeHtml(mapsUrl)}"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="external-link">

                            Ver ubicación

                            <i class="bi bi-arrow-up-right"></i>

                        </a>
                        `
                        :
                        ""
                    }

                </article>
            `;

        }


        /* =====================================================
           BOTÓN BUSCAR
           ===================================================== */

        searchButton.addEventListener(
            "click",
            function () {

                buscar(
                    input.value,
                    true
                );

            }
        );


        /* =====================================================
           ENTER
           ===================================================== */

        input.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Enter") {

                    event.preventDefault();

                    buscar(
                        input.value,
                        true
                    );

                }

            }
        );


        /* =====================================================
           CERCA DE MÍ
           ===================================================== */

        nearMeButton.addEventListener(
            "click",
            async function () {

                const texto =
                    input.value.trim();


                if (!texto) {

                    input.value =
                        "servicios de belleza";

                }


                await buscar(
                    input.value,
                    true
                );

            }
        );


        /* =====================================================
           ENCONTRAR PROFESIONALES
           ===================================================== */

        findProfessionalsButton
            .addEventListener(
                "click",
                function () {

                    if (!input.value.trim()) {

                        input.value =
                            "servicios de belleza";

                    }


                    buscar(
                        input.value,
                        true
                    );

                }
            );


        /* =====================================================
           CHIPS DE BÚSQUEDA
           ===================================================== */

        document
            .querySelectorAll(
                ".suggestion-chip"
            )
            .forEach(
                function (chip) {

                    chip.addEventListener(
                        "click",
                        function () {

                            const texto =
                                chip.dataset.search;


                            input.value =
                                texto;


                            buscar(
                                texto,
                                true
                            );

                        }
                    );

                }
            );


        /* =====================================================
           CATEGORÍAS
           ===================================================== */

        document
            .querySelectorAll(
                ".beauty-category"
            )
            .forEach(
                function (category) {

                    category.addEventListener(
                        "click",
                        function () {

                            const texto =
                                category
                                    .dataset
                                    .categorySearch;


                            input.value =
                                texto;


                            window.scrollTo({
                                top: 0,
                                behavior: "smooth"
                            });


                            setTimeout(
                                function () {

                                    buscar(
                                        texto,
                                        true
                                    );

                                },
                                350
                            );

                        }
                    );

                }
            );

    });

</script>