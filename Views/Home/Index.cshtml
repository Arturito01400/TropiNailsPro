            <button type="button"
                    class="beauty-category"
                    data-category-search="Cejas y pestañas">

                <div class="category-icon">

                    <i class="bi bi-eye"></i>

                </div>

                <strong>Cejas & pestañas</strong>

                <small>Lashes · Brows · Microblading</small>

            </button>


            <button type="button"
                    class="beauty-category"
                    data-category-search="Maquillaje">

                <div class="category-icon">

