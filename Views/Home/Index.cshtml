@{
    ViewData["Title"] = "TropiNails";
    Layout = "_Layout";
}

<style>

    /* =========================================================
       TROPINAILS PRO
       VITRINA PÚBLICA — BEAUTY DISCOVERY
       ========================================================= */

    :root {
        --tn-pink: #ff4da6;
        --tn-pink-dark: #d62978;
        --tn-purple: #9b5cff;
        --tn-white: #ffffff;
        --tn-dark: #08060c;
        --tn-glass: rgba(255,255,255,.075);
        --tn-border: rgba(255,255,255,.16);
    }

    * {
        box-sizing: border-box;
    }

    body {
        overflow-x: hidden;
    }

    /* =========================================================
       HERO
       ========================================================= */

    .public-home {
        position: relative;
        min-height: calc(100vh - 56px);
        display: flex;
        align-items: center;
        overflow: hidden;
        color: #fff;

        background:
            linear-gradient(
                90deg,
                rgba(8, 6, 12, .96) 0%,
                rgba(8, 6, 12, .84) 30%,
                rgba(8, 6, 12, .48) 62%,
                rgba(8, 6, 12, .10) 100%
            ),
            url('/images/tropinails-public-hero.png')
            center center / cover no-repeat;
    }

    .public-home::before {
        content: "";
        position: absolute;
        inset: 0;

        background:
            radial-gradient(
                circle at 72% 42%,
                rgba(255, 105, 180, .20),
                transparent 30%
            ),
            radial-gradient(
                circle at 35% 20%,
                rgba(255,255,255,.06),
                transparent 25%
            );

        pointer-events: none;
        z-index: 1;
    }

    .public-home::after {
        content: "";
        position: absolute;
        inset: 0;

        background:
            linear-gradient(
                180deg,
                rgba(0,0,0,.18),
                transparent 35%,
                rgba(0,0,0,.52)
            );

        pointer-events: none;
        z-index: 1;
    }

    /* =========================================================
       LOGIN
       ========================================================= */

    .login-link {
        position: absolute;
        top: 25px;
        right: 30px;
        z-index: 20;

        display: inline-flex;
        align-items: center;
        gap: 9px;

        padding: 11px 17px;

        border-radius: 14px;

        color: rgba(255,255,255,.94);
        text-decoration: none;

        font-size: .82rem;
        font-weight: 700;

        background: rgba(255,255,255,.065);

        border: 1px solid rgba(255,255,255,.17);

        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);

        box-shadow:
            0 12px 35px rgba(0,0,0,.18),
            inset 0 1px rgba(255,255,255,.08);

        transition: .25s ease;
    }

    .login-link::before {
        content: "";

        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: #ff79b8;

        box-shadow:
            0 0 12px rgba(255,121,184,.9);
    }

    .login-link:hover {
        color: #fff;
        transform: translateY(-2px);

        background: rgba(255,255,255,.13);

        border-color:
            rgba(255,255,255,.30);
    }

    /* =========================================================
       CONTENIDO HERO
       ========================================================= */

    .public-content {
        position: relative;
        z-index: 5;

        width: 100%;

        padding: 90px 0 100px;
    }

    .premium-container {
        max-width: 1450px;
        margin: auto;
        padding: 0 50px;
    }

    /* =========================================================
       BADGE
       ========================================================= */

    .brand-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;

        padding: 9px 15px;

        border-radius: 999px;

        background: rgba(255,255,255,.07);

        border: 1px solid rgba(255,255,255,.15);

        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);

        color: rgba(255,255,255,.92);

        font-size: .78rem;
        font-weight: 600;

        letter-spacing: .8px;

        margin-bottom: 27px;
    }

    .brand-dot {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: #ff72b6;

        box-shadow:
            0 0 0 5px rgba(255,114,182,.08),
            0 0 20px rgba(255,114,182,.9);
    }

    /* =========================================================
       TITULO
       ========================================================= */

    .hero-title {
        color: #fff;

        font-size: clamp(3.8rem, 6.4vw, 7rem);

        line-height: .91;

        font-weight: 800;

        letter-spacing: -4.5px;

        margin: 0 0 30px;

        max-width: 850px;

        text-shadow:
            0 10px 40px rgba(0,0,0,.22);
    }

    .hero-title span {
        background:
            linear-gradient(
                100deg,
                #ffffff 10%,
                #ffd4e8 45%,
                #ff75b8 100%
            );

        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;

        background-clip: text;
    }

    /* =========================================================
       DESCRIPCIÓN
       ========================================================= */

    .hero-description {
        color: rgba(255,255,255,.76);

        font-size: 1.12rem;

        line-height: 1.7;

        max-width: 620px;

        margin-bottom: 31px;
    }

    /* =========================================================
       BUSCADOR
       ========================================================= */

    .hero-search {
        position: relative;

        width: min(720px, 100%);

        min-height: 68px;

        padding: 8px;

        display: flex;
        align-items: center;

        gap: 7px;

        border-radius: 20px;

        background:
            rgba(255,255,255,.085);

        border:
            1px solid rgba(255,255,255,.20);

        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);

        box-shadow:
            0 25px 70px rgba(0,0,0,.25),
            inset 0 1px rgba(255,255,255,.10);

        margin-bottom: 13px;
    }

    .search-icon {
        width: 49px;
        height: 49px;

        flex: 0 0 49px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 15px;

        color: rgba(255,255,255,.85);

        background: rgba(255,255,255,.06);

        font-size: 1rem;
    }

    .hero-search input {
        flex: 1;

        min-width: 0;

        border: 0;
        outline: 0;

        background: transparent;

        color: #fff;

        font-size: .98rem;

        padding: 12px 8px;
    }

    .hero-search input::placeholder {
        color: rgba(255,255,255,.54);
    }

    .search-button {
        border: 0;

        min-height: 50px;

        padding: 0 24px;

        border-radius: 15px;

        background: #fff;

        color: #171017;

        font-weight: 700;

        font-size: .9rem;

        cursor: pointer;

        transition: .25s ease;
    }

    .search-button:hover {
        transform: translateY(-2px);

        box-shadow:
            0 10px 25px rgba(0,0,0,.22);
    }

    .search-button:disabled {
        opacity: .65;
        cursor: wait;
        transform: none;
    }

    /* =========================================================
       SUGERENCIAS
       ========================================================= */

    .search-suggestions {
        width: min(720px,100%);

        display: flex;
        flex-wrap: wrap;

        gap: 8px;

        margin-bottom: 25px;
    }

    .suggestion-chip {
        border: 1px solid rgba(255,255,255,.13);

        background: rgba(255,255,255,.055);

        color: rgba(255,255,255,.75);

        border-radius: 999px;

        padding: 7px 12px;

        font-size: .72rem;

        cursor: pointer;

        transition: .2s ease;

        backdrop-filter: blur(12px);
    }

    .suggestion-chip:hover {
        color: #fff;

        background:
            rgba(255,77,166,.17);

        border-color:
            rgba(255,114,182,.40);

        transform: translateY(-1px);
    }

    /* =========================================================
       BOTONES
       ========================================================= */

    .hero-actions {
        display: flex;
        flex-wrap: wrap;

        gap: 11px;

        margin-bottom: 34px;
    }

    .btn-premium {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 9px;

        min-height: 52px;

        padding: 0 21px;

        border-radius: 15px;

        text-decoration: none;

        font-size: .9rem;

        font-weight: 700;

        transition: .25s ease;
    }

    .btn-primary-premium {
        color: #fff;

        background:
            linear-gradient(
                135deg,
                #ff4da6,
                #d62978
            );

        box-shadow:
            0 15px 35px rgba(214,41,120,.27);
    }

    .btn-primary-premium:hover {
        color: #fff;

        transform: translateY(-3px);

        box-shadow:
            0 20px 42px rgba(214,41,120,.40);
    }

    .btn-glass-premium {
        color: #fff;

        background:
            rgba(255,255,255,.07);

        border:
            1px solid rgba(255,255,255,.18);

        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }

    .btn-glass-premium:hover {
        color: #fff;

        background:
            rgba(255,255,255,.13);

        transform: translateY(-3px);
    }

    /* =========================================================
       CONFIANZA
       ========================================================= */

    .trust-row {
        display: flex;
        flex-wrap: wrap;

        gap: 22px;

        color: rgba(255,255,255,.65);

        font-size: .78rem;

        font-weight: 500;
    }

    .trust-item {
        display: flex;

        align-items: center;

        gap: 7px;
    }

    .trust-item i {
        color: #ff9ccc;
    }

    /* =========================================================
       RESULTADOS
       ========================================================= */

    .search-results-section {
        display: none;

        position: relative;

        z-index: 30;

        width: 100%;

        padding: 70px 0 90px;

        background:
            linear-gradient(
                180deg,
                #0c0910,
                #110b13
            );

        color: #fff;
    }

    .search-results-section.visible {
        display: block;
    }

    .results-container {
        max-width: 1450px;

        margin: auto;

        padding: 0 50px;
    }

    .results-header {
        display: flex;

        align-items: flex-end;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 30px;
    }

    .results-kicker {
        color: #ff82bc;

        font-size: .75rem;

        font-weight: 700;

        text-transform: uppercase;

        letter-spacing: 1.4px;

        margin-bottom: 8px;
    }

    .results-title {
        margin: 0;

        color: #fff;

        font-size: clamp(1.8rem,3vw,3rem);

        font-weight: 800;

        letter-spacing: -1.5px;
    }

    .results-count {
        color: rgba(255,255,255,.55);

        font-size: .85rem;
    }

    /* =========================================================
       GRID PROFESIONALES
       ========================================================= */

    .professionals-grid {
        display: grid;

        grid-template-columns:
            repeat(4, minmax(0,1fr));

        gap: 20px;
    }

    .professional-card {
        overflow: hidden;

        border-radius: 22px;

        background:
            rgba(255,255,255,.055);

        border:
            1px solid rgba(255,255,255,.10);

        box-shadow:
            0 20px 50px rgba(0,0,0,.18);

        transition: .3s ease;
    }

    .professional-card:hover {
        transform: translateY(-6px);

        border-color:
            rgba(255,114,182,.35);

        box-shadow:
            0 30px 65px rgba(0,0,0,.28);
    }

    .professional-image {
        position: relative;

        height: 260px;

        overflow: hidden;

        background:
            linear-gradient(
                135deg,
                #251321,
                #120c14
            );
    }

    .professional-image img {
        width: 100%;
        height: 100%;

        object-fit: cover;

        transition: transform .5s ease;
    }

    .professional-card:hover
    .professional-image img {
        transform: scale(1.05);
    }

    .professional-placeholder {
        width: 100%;
        height: 100%;

        display: flex;

        align-items: center;
        justify-content: center;

        color: rgba(255,255,255,.35);

        font-size: 3rem;
    }

    .professional-badge {
        position: absolute;

        top: 13px;
        left: 13px;

        padding: 6px 10px;

        border-radius: 999px;

        background:
            rgba(0,0,0,.55);

        backdrop-filter: blur(12px);

        color: #fff;

        font-size: .68rem;

        font-weight: 700;
    }

    .professional-content {
        padding: 18px;
    }

    .professional-name {
        color: #fff;

        font-size: 1.05rem;

        font-weight: 750;

        margin-bottom: 6px;
    }

    .professional-location {
        display: flex;

        align-items: center;

        gap: 6px;

        color: rgba(255,255,255,.58);

        font-size: .76rem;

        margin-bottom: 14px;
    }

    .professional-location i {
        color: #ff82bc;
    }

    .professional-actions {
        display: flex;

        gap: 8px;
    }

    .professional-action {
        flex: 1;

        min-height: 40px;

        border-radius: 11px;

        display: flex;

        align-items: center;
        justify-content: center;

        text-decoration: none;

        font-size: .72rem;

        font-weight: 700;

        transition: .2s ease;
    }

    .professional-action.primary {
        color: #fff;

        background:
            linear-gradient(
                135deg,
                #ff4da6,
                #d62978
            );
    }

    .professional-action.secondary {
        color: rgba(255,255,255,.82);

        background:
            rgba(255,255,255,.07);

        border:
            1px solid rgba(255,255,255,.10);
    }

    .professional-action:hover {
        color: #fff;

        transform: translateY(-1px);
    }

    /* =========================================================
       GOOGLE / OTROS NEGOCIOS
       ========================================================= */

    .external-results {
        margin-top: 70px;
    }

    .external-heading {
        margin-bottom: 20px;
    }

    .external-heading h3 {
        color: #fff;

        font-size: 1.35rem;

        font-weight: 750;

        margin-bottom: 5px;
    }

    .external-heading p {
        color: rgba(255,255,255,.50);

        font-size: .8rem;

        margin: 0;
    }

    .external-grid {
        display: grid;

        grid-template-columns:
            repeat(3, minmax(0,1fr));

        gap: 14px;
    }

    .external-card {
        padding: 17px;

        border-radius: 17px;

        background:
            rgba(255,255,255,.04);

        border:
            1px solid rgba(255,255,255,.09);
    }

    .external-card h4 {
        color: #fff;

        font-size: .92rem;

        margin-bottom: 6px;
    }

    .external-card p {
        color: rgba(255,255,255,.53);

        font-size: .74rem;

        line-height: 1.5;

        margin-bottom: 10px;
    }

    .external-rating {
        color: #ffd166;

        font-size: .74rem;

        margin-bottom: 12px;
    }

    .external-link {
        color: #ff83bc;

        font-size: .72rem;

        font-weight: 700;

        text-decoration: none;
    }

    .external-link:hover {
        color: #fff;
    }

    /* =========================================================
       SIN RESULTADOS
       ========================================================= */

    .empty-results {
        display: none;

        text-align: center;

        padding: 60px 20px;

        border-radius: 22px;

        background:
            rgba(255,255,255,.035);

        border:
            1px solid rgba(255,255,255,.08);
    }

    .empty-results.visible {
        display: block;
    }

    .empty-results i {
        display: block;

        color: #ff82bc;

        font-size: 2.5rem;

        margin-bottom: 15px;
    }

    .empty-results h3 {
        color: #fff;

        font-size: 1.3rem;

        margin-bottom: 8px;
    }

    .empty-results p {
        color: rgba(255,255,255,.55);

        font-size: .85rem;

        max-width: 550px;

        margin: auto;
    }

    /* =========================================================
       CATEGORÍAS
       ========================================================= */

    .beauty-categories {
        position: relative;

        z-index: 10;

        padding: 70px 0 80px;

        background:
            #0c0910;

        color: #fff;
    }

    .categories-container {
        max-width: 1450px;

        margin: auto;

        padding: 0 50px;
    }

    .section-heading {
        margin-bottom: 28px;
    }

    .section-heading span {
        color: #ff82bc;

        font-size: .72rem;

        font-weight: 700;

        text-transform: uppercase;

        letter-spacing: 1.4px;
    }

    .section-heading h2 {
        color: #fff;

        font-size: clamp(1.8rem,3vw,2.8rem);

        font-weight: 800;

        letter-spacing: -1.5px;

        margin: 7px 0 8px;
    }

    .section-heading p {
        color: rgba(255,255,255,.52);

        max-width: 620px;

        margin: 0;

        font-size: .9rem;
    }

    .categories-grid {
        display: grid;

        grid-template-columns:
            repeat(6, minmax(0,1fr));

        gap: 13px;
    }

    .beauty-category {
        position: relative;

        min-height: 160px;

        overflow: hidden;

        border-radius: 19px;

        padding: 20px;

        display: flex;

        flex-direction: column;

        justify-content: flex-end;

        text-decoration: none;

        background:
            linear-gradient(
                145deg,
                rgba(255,255,255,.08),
                rgba(255,255,255,.025)
            );

        border:
            1px solid rgba(255,255,255,.09);

        transition: .3s ease;
    }

    .beauty-category::before {
        content: "";

        position: absolute;

        inset: 0;

        background:
            radial-gradient(
                circle at 80% 20%,
                rgba(255,77,166,.24),
                transparent 45%
            );

        opacity: .7;

        transition: .3s ease;
    }

    .beauty-category:hover {
        transform: translateY(-5px);

        border-color:
            rgba(255,114,182,.35);

        box-shadow:
            0 20px 45px rgba(0,0,0,.22);
    }

    .category-icon {
        position: relative;
        z-index: 2;

        width: 48px;
        height: 48px;

        display: flex;

        align-items: center;
        justify-content: center;

        margin-bottom: auto;

        border-radius: 15px;

        background:
            rgba(255,255,255,.08);

        color: #ff9dcc;

        font-size: 1.2rem;
    }

    .beauty-category strong {
        position: relative;
        z-index: 2;

        color: #fff;

        font-size: .9rem;
    }

    .beauty-category small {
        position: relative;
        z-index: 2;

        color: rgba(255,255,255,.45);

        font-size: .68rem;

        margin-top: 4px;
    }

    /* =========================================================
       DESCUBRIMIENTO
       ========================================================= */

    .discovery-section {
        position: relative;

        padding: 90px 0;

        background:
            linear-gradient(
                180deg,
                #0c0910,
                #08060c
            );

        overflow: hidden;
    }

    .discovery-section::before {
        content: "";

        position: absolute;

        width: 600px;
        height: 600px;

        right: -250px;
        top: -200px;

        border-radius: 50%;

        background:
            radial-gradient(
                circle,
                rgba(255,77,166,.13),
                transparent 65%
            );

        pointer-events: none;
    }

    .discovery-grid {
        max-width: 1450px;

        margin: auto;

        padding: 0 50px;

        display: grid;

        grid-template-columns:
            1.1fr .9fr;

        gap: 25px;
    }

    .discovery-card {
        min-height: 310px;

        border-radius: 26px;

        padding: 35px;

        position: relative;

        overflow: hidden;

        border:
            1px solid rgba(255,255,255,.10);

        background:
            linear-gradient(
                135deg,
                rgba(255,255,255,.075),
                rgba(255,255,255,.025)
            );
    }

    .discovery-card h3 {
        color: #fff;

        font-size: 1.8rem;

        font-weight: 800;

        letter-spacing: -1px;

        max-width: 500px;

        margin-bottom: 12px;
    }

    .discovery-card p {
        color: rgba(255,255,255,.55);

        font-size: .86rem;

        line-height: 1.7;

        max-width: 480px;
    }

    .discovery-icon {
        width: 58px;
        height: 58px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 18px;

        background:
            linear-gradient(
                135deg,
                #ff4da6,
                #9b5cff
            );

        color: #fff;

        font-size: 1.3rem;

        margin-bottom: 25px;

        box-shadow:
            0 15px 35px rgba(255,77,166,.20);
    }

    /* =========================================================
       LOADING
       ========================================================= */

    .search-loading {
        display: none;

        align-items: center;

        gap: 10px;

        color: rgba(255,255,255,.60);

        font-size: .78rem;

        margin: 8px 0 20px;
    }

    .search-loading.visible {
        display: flex;
    }

    .loading-spinner {
        width: 16px;
        height: 16px;

        border-radius: 50%;

        border:
            2px solid rgba(255,255,255,.15);

        border-top-color:
            #ff72b6;

        animation:
            tnSpin .7s linear infinite;
    }

    @@keyframes tnSpin {
        to {
            transform: rotate(360deg);
        }
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1200px) {

        .professionals-grid {
            grid-template-columns:
                repeat(3,minmax(0,1fr));
        }

        .categories-grid {
            grid-template-columns:
                repeat(3,minmax(0,1fr));
        }
    }

    @@media (max-width: 992px) {

        .premium-container,
        .results-container,
        .categories-container,
        .discovery-grid {
            padding-left: 30px;
            padding-right: 30px;
        }

        .public-home {
            background-position: 64% center;
        }

        .hero-title {
            font-size:
                clamp(3.3rem,8vw,5rem);
        }

        .external-grid {
            grid-template-columns:
                repeat(2,minmax(0,1fr));
        }

        .discovery-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {

    .public-home {
        min-height:
            calc(100vh - 56px);

        align-items: flex-end;

        background:
            linear-gradient(
                180deg,
                rgba(8,6,12,.38) 0%,
                rgba(8,6,12,.75) 45%,
                rgba(8,6,12,.97) 100%
            ),
            url('/images/tropinails-public-hero.png')
            62% center / cover no-repeat;
    }


    .premium-container,
    .results-container,
    .categories-container,
    .discovery-grid {
        padding-left: 18px;
        padding-right: 18px;
    }


    .public-content {
        padding:
            100px 0 45px;
    }


    .brand-badge {
        margin-bottom: 19px;
        font-size: .72rem;
    }


    .hero-title {
        font-size: 3.25rem;

        letter-spacing: -2.5px;

