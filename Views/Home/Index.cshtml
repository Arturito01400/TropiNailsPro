@{
    ViewData["Title"] = "TropiNails";
    Layout = "_Layout";
}

<style>

    /* =========================================================
       TROPINAILS PRO
       VITRINA PÚBLICA — BEAUTY DISCOVERY
       ========================================================= */

    :root {
        --tn-pink: #ff4da6;
        --tn-pink-dark: #d62978;
        --tn-purple: #9b5cff;
        --tn-white: #ffffff;
        --tn-dark: #08060c;
        --tn-glass: rgba(255,255,255,.075);
        --tn-border: rgba(255,255,255,.16);
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html {
        overflow-x: hidden;
        scroll-behavior: smooth;
    }

    body {
        overflow-x: hidden;
        margin: 0;
        background: var(--tn-dark);
    }


    /* =========================================================
       HERO
       ========================================================= */

    .public-home {
        position: relative;

        min-height: calc(100vh - 56px);

        display: flex;
        align-items: center;

        overflow: hidden;

        color: #fff;

        background:
            linear-gradient(
                90deg,
                rgba(8, 6, 12, .96) 0%,
                rgba(8, 6, 12, .84) 30%,
                rgba(8, 6, 12, .48) 62%,
                rgba(8, 6, 12, .10) 100%
            ),
            url('/images/tropinails-public-hero.png')
            center center / cover no-repeat;
    }

    .public-home::before {
        content: "";

        position: absolute;
        inset: 0;

        background:
            radial-gradient(
                circle at 72% 42%,
                rgba(255, 105, 180, .20),
                transparent 30%
            ),
            radial-gradient(
                circle at 35% 20%,
                rgba(255,255,255,.06),
                transparent 25%
            );

        pointer-events: none;
        z-index: 1;
    }

    .public-home::after {
        content: "";

        position: absolute;
        inset: 0;

        background:
            linear-gradient(
                180deg,
                rgba(0,0,0,.18),
                transparent 35%,
                rgba(0,0,0,.52)
            );

        pointer-events: none;
        z-index: 1;
    }


    /* =========================================================
       NAVEGACIÓN SUPERIOR
       ========================================================= */

    .public-top-navigation {
        position: absolute;

        top: 25px;
        right: 30px;

        z-index: 20;

        display: flex;
        align-items: center;

        gap: 9px;
    }


    /* =========================================================
       LOGIN
       ========================================================= */

    .login-link {
        position: relative;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 9px;

        min-height: 44px;

        padding: 11px 17px;

        border-radius: 14px;

        color: rgba(255,255,255,.94);
        text-decoration: none;

        font-size: .82rem;
        font-weight: 700;

        background: rgba(255,255,255,.065);

        border: 1px solid rgba(255,255,255,.17);

        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);

        box-shadow:
            0 12px 35px rgba(0,0,0,.18),
            inset 0 1px rgba(255,255,255,.08);

        transition:
            transform .25s ease,
            background .25s ease,
            border-color .25s ease,
            box-shadow .25s ease;
    }

    .login-link::before {
        content: "";

        width: 7px;
        height: 7px;

        flex: 0 0 7px;

        border-radius: 50%;

        background: #ff79b8;

        box-shadow:
            0 0 12px rgba(255,121,184,.9);
    }

    .login-link:hover {
        color: #fff;

        transform: translateY(-2px);

        background: rgba(255,255,255,.13);

        border-color:
            rgba(255,255,255,.30);

        box-shadow:
            0 16px 40px rgba(0,0,0,.25);
    }


    /* =========================================================
       BOTÓN PROFESIONALES
       ========================================================= */

    .professionals-link {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 8px;

        min-height: 44px;

        padding: 11px 17px;

        border-radius: 14px;

        color: rgba(255,255,255,.94);
        text-decoration: none;

        font-size: .82rem;
        font-weight: 700;

        background:
            rgba(255,255,255,.065);

        border:
            1px solid rgba(255,255,255,.17);

        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);

        box-shadow:
            0 12px 35px rgba(0,0,0,.18),
            inset 0 1px rgba(255,255,255,.08);

        transition:
            transform .25s ease,
            background .25s ease,
            border-color .25s ease,
            box-shadow .25s ease;
    }

    .professionals-link i {
        color: #ff82bc;

        font-size: .9rem;
    }

    .professionals-link:hover {
        color: #fff;

        transform: translateY(-2px);

        background:
            rgba(255,255,255,.13);

        border-color:
            rgba(255,114,182,.35);

        box-shadow:
            0 16px 40px rgba(0,0,0,.25);
    }


    /* =========================================================
       CONTENIDO HERO
       ========================================================= */

    .public-content {
        position: relative;
        z-index: 5;

        width: 100%;

        padding: 90px 0 100px;
    }

    .premium-container {
        width: 100%;
        max-width: 1450px;

        margin: auto;

        padding: 0 50px;
    }


    /* =========================================================
       BADGE
       ========================================================= */

    .brand-badge {
        display: inline-flex;

        align-items: center;

        gap: 10px;

        padding: 9px 15px;

        border-radius: 999px;

        background:
            rgba(255,255,255,.07);

        border:
            1px solid rgba(255,255,255,.15);

        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);

        color:
            rgba(255,255,255,.92);

        font-size: .78rem;
        font-weight: 600;

        letter-spacing: .8px;

        margin-bottom: 27px;
    }

    .brand-dot {
        width: 7px;
        height: 7px;

        flex: 0 0 7px;

        border-radius: 50%;

        background: #ff72b6;

        box-shadow:
            0 0 0 5px rgba(255,114,182,.08),
            0 0 20px rgba(255,114,182,.9);
    }


    /* =========================================================
       TÍTULO
       ========================================================= */

    .hero-title {
        color: #fff;

        font-size:
            clamp(3.8rem, 6.4vw, 7rem);

        line-height: .91;

        font-weight: 800;

        letter-spacing: -4.5px;

        margin: 0 0 30px;

        max-width: 850px;

        text-shadow:
            0 10px 40px rgba(0,0,0,.22);
    }

    .hero-title span {
        background:
            linear-gradient(
                100deg,
                #ffffff 10%,
                #ffd4e8 45%,
                #ff75b8 100%
            );

        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;

        background-clip: text;
    }


    /* =========================================================
       DESCRIPCIÓN
       ========================================================= */

    .hero-description {
        color:
            rgba(255,255,255,.76);

        font-size: 1.12rem;

        line-height: 1.7;

        max-width: 620px;

        margin-bottom: 31px;
    }


    /* =========================================================
       BUSCADOR
       ========================================================= */

    .hero-search {
        position: relative;

        width: min(720px, 100%);

        min-height: 68px;

        padding: 8px;

        display: flex;

        align-items: center;

        gap: 7px;

        border-radius: 20px;

        background:
            rgba(255,255,255,.085);

        border:
            1px solid rgba(255,255,255,.20);

        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);

        box-shadow:
            0 25px 70px rgba(0,0,0,.25),
            inset 0 1px rgba(255,255,255,.10);

        margin-bottom: 13px;
    }

    .search-icon {
        width: 49px;
        height: 49px;

        flex: 0 0 49px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 15px;

        color:
            rgba(255,255,255,.85);

        background:
            rgba(255,255,255,.06);

        font-size: 1rem;
    }

    .hero-search input {
        flex: 1;

        min-width: 0;

        width: 100%;

        border: 0;
        outline: 0;

        background: transparent;

        color: #fff;

        font-size: .98rem;

        padding: 12px 8px;
    }

    .hero-search input::placeholder {
        color:
            rgba(255,255,255,.54);
    }

    .search-button {
        border: 0;

        min-height: 50px;

        flex: 0 0 auto;

        padding: 0 24px;

        border-radius: 15px;

        background: #fff;

        color: #171017;

        font-weight: 700;

        font-size: .9rem;

        cursor: pointer;

        transition:
            transform .25s ease,
            box-shadow .25s ease,
            opacity .25s ease;
    }

    .search-button:hover {
        transform: translateY(-2px);

        box-shadow:
            0 10px 25px rgba(0,0,0,.22);
    }

    .search-button:disabled {
        opacity: .65;

        cursor: wait;

        transform: none;

        box-shadow: none;
    }


    /* =========================================================
       SUGERENCIAS
       ========================================================= */

    .search-suggestions {
        width: min(720px,100%);

        display: flex;

        flex-wrap: wrap;

        gap: 8px;

        margin-bottom: 25px;
    }

    .suggestion-chip {
        border:
            1px solid rgba(255,255,255,.13);

        background:
            rgba(255,255,255,.055);

        color:
            rgba(255,255,255,.75);

        border-radius: 999px;

        padding: 7px 12px;

        font-size: .72rem;

        cursor: pointer;

        transition:
            color .2s ease,
            background .2s ease,
            border-color .2s ease,
            transform .2s ease;

        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .suggestion-chip:hover {
        color: #fff;

        background:
            rgba(255,77,166,.17);

        border-color:
            rgba(255,114,182,.40);

        transform: translateY(-1px);
    }


    /* =========================================================
       BOTONES HERO
       ========================================================= */

    .hero-actions {
        display: flex;

        flex-wrap: wrap;

        gap: 11px;

        margin-bottom: 34px;
    }

    .btn-premium {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 9px;

        min-height: 52px;

        padding: 0 21px;

        border-radius: 15px;

        text-decoration: none;

        font-size: .9rem;

        font-weight: 700;

        transition:
            transform .25s ease,
            box-shadow .25s ease,
            background .25s ease;
    }

    .btn-primary-premium {
        color: #fff;

        background:
            linear-gradient(
                135deg,
                #ff4da6,
                #d62978
            );

        box-shadow:
            0 15px 35px rgba(214,41,120,.27);
    }

    .btn-primary-premium:hover {
        color: #fff;

        transform: translateY(-3px);

        box-shadow:
            0 20px 42px rgba(214,41,120,.40);
    }

    .btn-glass-premium {
        color: #fff;

        background:
            rgba(255,255,255,.07);

        border:
            1px solid rgba(255,255,255,.18);

        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }

    .btn-glass-premium:hover {
        color: #fff;

        background:
            rgba(255,255,255,.13);

        transform: translateY(-3px);
    }


    /* =========================================================
       CONFIANZA
       ========================================================= */

    .trust-row {
        display: flex;

        flex-wrap: wrap;

        gap: 22px;

        color:
            rgba(255,255,255,.65);

        font-size: .78rem;

        font-weight: 500;
    }

    .trust-item {
        display: flex;

        align-items: center;

        gap: 7px;
    }

    .trust-item i {
        color: #ff9ccc;
    }


    /* =========================================================
       RESULTADOS
       ========================================================= */

    .search-results-section {
        display: none;

        position: relative;

        z-index: 30;

        width: 100%;

        padding: 70px 0 90px;

        background:
            linear-gradient(
                180deg,
                #0c0910,
                #110b13
            );

        color: #fff;
    }

    .search-results-section.visible {
        display: block;
    }

    .results-container {
        width: 100%;

        max-width: 1450px;

        margin: auto;

        padding: 0 50px;
    }

    .results-header {
        display: flex;

        align-items: flex-end;

        justify-content: space-between;

        gap: 20px;

        margin-bottom: 30px;
    }

    .results-kicker {
        color: #ff82bc;

        font-size: .75rem;

        font-weight: 700;

        text-transform: uppercase;

        letter-spacing: 1.4px;

        margin-bottom: 8px;
    }

    .results-title {
        margin: 0;

        color: #fff;

        font-size:
            clamp(1.8rem,3vw,3rem);

        font-weight: 800;

        letter-spacing: -1.5px;
    }

    .results-count {
        color:
            rgba(255,255,255,.55);

        font-size: .85rem;
    }


    /* =========================================================
   GRID PROFESIONALES — TROPINAILS BEAUTY PROFILE CARDS
   ========================================================= */

.professionals-grid {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 22px;

    width: 100%;
}


/* =========================================================
   TARJETA PRINCIPAL
   ========================================================= */

.professional-card {
    position: relative;

    min-width: 0;

    overflow: hidden;

    border-radius: 26px;

    background:
        linear-gradient(
            180deg,
            rgba(255,255,255,.075),
            rgba(255,255,255,.035)
        );

    border:
        1px solid rgba(255,255,255,.12);

    box-shadow:
        0 25px 65px rgba(0,0,0,.28),
        inset 0 1px rgba(255,255,255,.08);

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    transition:
        transform .35s cubic-bezier(.2,.8,.2,1),
        border-color .35s ease,
        box-shadow .35s ease;
}

.professional-card:hover {
    transform: translateY(-8px);

    border-color:
        rgba(255,114,182,.42);

    box-shadow:
        0 35px 80px rgba(0,0,0,.38),
        0 0 0 1px rgba(255,114,182,.05);
}


/* =========================================================
   PORTADA
   ========================================================= */

.professional-cover {
    position: relative;

    height: 245px;

    overflow: hidden;

    background:
        radial-gradient(
            circle at 80% 15%,
            rgba(255,77,166,.35),
            transparent 38%
        ),
        linear-gradient(
            135deg,
            #321326,
            #160d17 55%,
            #09070c
        );
}


/* Imagen de portada */

.professional-cover img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
        transform .7s cubic-bezier(.2,.8,.2,1);
}

.professional-card:hover
.professional-cover img {
    transform: scale(1.06);
}


/* =========================================================
   CAPA OSCURA DE PORTADA
   ========================================================= */

.professional-cover::after {
    content: "";

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            180deg,
            rgba(0,0,0,.05) 0%,
            rgba(0,0,0,.10) 35%,
            rgba(5,3,8,.78) 100%
        );

    pointer-events: none;
}


/* =========================================================
   PORTADA SIN IMAGEN
   ========================================================= */

.professional-cover-placeholder {
    position: absolute;

    inset: 0;

    display: flex;

    align-items: center;
    justify-content: center;

    background:
        radial-gradient(
            circle at 75% 20%,
            rgba(255,104,181,.28),
            transparent 35%
        ),
        radial-gradient(
            circle at 20% 80%,
            rgba(155,92,255,.20),
            transparent 38%
        ),
        linear-gradient(
            135deg,
            #321326,
            #140b15
        );

    color:
        rgba(255,255,255,.20);

    font-size: 4rem;
}


/* =========================================================
   BADGE SUPERIOR
   ========================================================= */

.professional-top-badge {
    position: absolute;

    top: 14px;
    left: 14px;

    z-index: 5;

    display: inline-flex;

    align-items: center;

    gap: 7px;

    padding: 7px 11px;

    border-radius: 999px;

    color: #fff;

    background:
        rgba(12,8,14,.64);

    border:
        1px solid rgba(255,255,255,.16);

    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);

    box-shadow:
        0 8px 25px rgba(0,0,0,.20);

    font-size: .65rem;

    font-weight: 750;

    letter-spacing: .2px;
}

.professional-top-badge i {
    color: #ff79b8;

    font-size: .72rem;
}


/* =========================================================
   INDICADOR DE PERFIL
   ========================================================= */

.professional-status {
    position: absolute;

    top: 15px;
    right: 15px;

    z-index: 5;

    width: 31px;
    height: 31px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background:
        rgba(12,8,14,.70);

    border:
        1px solid rgba(255,255,255,.17);

    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);

    color: #ff78b8;

    font-size: .82rem;

    box-shadow:
        0 8px 25px rgba(0,0,0,.22);
}


/* =========================================================
   INFORMACIÓN SUPERPUESTA EN PORTADA
   ========================================================= */

.professional-cover-info {
    position: absolute;

    left: 18px;
    right: 18px;
    bottom: 17px;

    z-index: 4;

    padding-left: 88px;

    pointer-events: none;
}

.professional-cover-category {
    display: inline-block;

    margin-bottom: 4px;

    color:
        rgba(255,255,255,.70);

    font-size: .66rem;

    font-weight: 650;

    text-transform: uppercase;

    letter-spacing: .8px;
}

.professional-cover-name {
    color: #fff;

    font-size: 1.22rem;

    line-height: 1.05;

    font-weight: 800;

    letter-spacing: -.5px;

    overflow-wrap: anywhere;

    text-shadow:
        0 4px 18px rgba(0,0,0,.45);
}


/* =========================================================
   FOTO DE PERFIL
   ========================================================= */

.professional-avatar {
    position: absolute;

    left: 18px;
    bottom: -38px;

    z-index: 8;

    width: 92px;
    height: 92px;

    padding: 4px;

    border-radius: 50%;

    background:
        linear-gradient(
            135deg,
            #fff,
            #ffd4e8,
            #ff72b6
        );

    box-shadow:
        0 12px 30px rgba(0,0,0,.35),
        0 0 0 4px rgba(8,6,12,.72);
}

.professional-avatar img {
    display: block;

    width: 100%;
    height: 100%;

    border-radius: 50%;

    object-fit: cover;

    background:
        linear-gradient(
            135deg,
            #291321,
            #100a12
        );
}

.professional-avatar-placeholder {
    width: 100%;
    height: 100%;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background:
        linear-gradient(
            135deg,
            #291321,
            #100a12
        );

    color:
        rgba(255,255,255,.38);

    font-size: 2rem;
}


/* =========================================================
   CHECK / VERIFICADO
   ========================================================= */

.professional-verified {
    position: absolute;

    right: -1px;
    bottom: 3px;

    width: 25px;
    height: 25px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background:
        linear-gradient(
            135deg,
            #ff4da6,
            #9b5cff
        );

    border:
        3px solid #100a12;

    color: #fff;

    font-size: .65rem;

    box-shadow:
        0 5px 15px rgba(0,0,0,.28);
}


/* =========================================================
   CONTENIDO
   ========================================================= */

.professional-content {
    position: relative;

    padding:
        50px 18px 18px;
}


/* =========================================================
   UBICACIÓN
   ========================================================= */

.professional-location {
    display: flex;

    align-items: center;

    gap: 6px;

    min-width: 0;

    margin-bottom: 16px;

    color:
        rgba(255,255,255,.52);

    font-size: .73rem;
}

.professional-location i {
    flex: 0 0 auto;

    color: #ff82bc;

    font-size: .78rem;
}

.professional-location span {
    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
}


/* =========================================================
   ESTADÍSTICAS
   ========================================================= */

.professional-stats {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 7px;

    margin-bottom: 17px;
}

.professional-stat {
    min-width: 0;

    padding:
        9px 6px;

    text-align: center;

    border-radius: 12px;

    background:
        rgba(255,255,255,.045);

    border:
        1px solid rgba(255,255,255,.07);
}

.professional-stat strong {
    display: block;

    color: #fff;

    font-size: .82rem;

    font-weight: 800;

    line-height: 1.1;

    margin-bottom: 3px;
}

.professional-stat span {
    display: block;

    color:
        rgba(255,255,255,.42);

    font-size: .58rem;

    line-height: 1.1;
}


/* =========================================================
   BOTONES
   ========================================================= */

.professional-actions {
    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 8px;
}

.professional-action {
    min-width: 0;

    min-height: 43px;

    display: flex;

    align-items: center;
    justify-content: center;

    gap: 6px;

    border-radius: 12px;

    text-decoration: none;

    font-size: .70rem;

    font-weight: 750;

    transition:
        transform .22s ease,
        background .22s ease,
        box-shadow .22s ease,
        border-color .22s ease;
}

.professional-action.primary {
    color: #fff;

    background:
        linear-gradient(
            135deg,
            #ff4da6,
            #d62978
        );

    box-shadow:
        0 9px 25px rgba(214,41,120,.22);
}

.professional-action.primary:hover {
    color: #fff;

    transform: translateY(-2px);

    box-shadow:
        0 14px 30px rgba(214,41,120,.34);
}

.professional-action.secondary {
    color:
        rgba(255,255,255,.88);

    background:
        rgba(255,255,255,.055);

    border:
        1px solid rgba(255,255,255,.11);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
}

.professional-action.secondary:hover {
    color: #fff;

    transform: translateY(-2px);

    background:
        rgba(255,255,255,.11);

    border-color:
        rgba(255,114,182,.25);
}


/* =========================================================
   RESPONSIVE — 1200px
   ========================================================= */

@@media (max-width: 1200px) {

