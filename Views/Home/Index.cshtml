@{
    ViewData["Title"] = "TropiNails";
    Layout = "_Layout";
}

<style>
    /* =========================================================
       TROPINAILS — PREMIUM PUBLIC HOME
       ========================================================= */

    .public-home {
        position: relative;
        min-height: calc(100vh - 56px);
        display: flex;
        align-items: center;
        overflow: hidden;
        color: #fff;

        background:
            linear-gradient(
                90deg,
                rgba(8, 6, 12, 0.94) 0%,
                rgba(8, 6, 12, 0.82) 30%,
                rgba(8, 6, 12, 0.48) 62%,
                rgba(8, 6, 12, 0.12) 100%
            ),
            url('/images/tropinails-public-hero.png')
            center center / cover no-repeat;
    }

    .public-home::before {
        content: "";
        position: absolute;
        inset: 0;

        background:
            radial-gradient(
                circle at 72% 45%,
                rgba(255, 105, 180, 0.18),
                transparent 30%
            ),
            radial-gradient(
                circle at 35% 20%,
                rgba(255, 255, 255, 0.05),
                transparent 25%
            );

        pointer-events: none;
        z-index: 1;
    }

    .public-home::after {
        content: "";
        position: absolute;
        inset: 0;

        background:
            linear-gradient(
                180deg,
                rgba(0,0,0,0.20) 0%,
                transparent 35%,
                rgba(0,0,0,0.40) 100%
            );

        pointer-events: none;
        z-index: 1;
    }

    /* =========================================================
       CONTENIDO
       ========================================================= */

    .public-content {
        position: relative;
        z-index: 3;
        width: 100%;
        padding: 80px 0 90px;
    }

    .premium-container {
        max-width: 1400px;
        margin: auto;
        padding: 0 50px;
    }

    /* =========================================================
       BADGE
       ========================================================= */

    .brand-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;

        padding: 9px 15px;

        border-radius: 999px;

        background: rgba(255,255,255,0.07);
        border: 1px solid rgba(255,255,255,0.15);

        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);

        color: rgba(255,255,255,0.92);

        font-size: 0.78rem;
        font-weight: 600;

        letter-spacing: 0.8px;

        margin-bottom: 27px;

        box-shadow:
            0 10px 35px rgba(0,0,0,0.18);
    }

    .brand-dot {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: #ff72b6;

        box-shadow:
            0 0 0 5px rgba(255,114,182,0.08),
            0 0 20px rgba(255,114,182,0.9);
    }

    /* =========================================================
       TITULO PRINCIPAL
       ========================================================= */

    .hero-title {
        color: #fff;

        font-size: clamp(3.8rem, 6.4vw, 7rem);

        line-height: 0.91;

        font-weight: 800;

        letter-spacing: -4.5px;

        margin: 0 0 30px;

        max-width: 820px;

        text-shadow:
            0 10px 40px rgba(0,0,0,0.22);
    }

    .hero-title span {
        background:
            linear-gradient(
                100deg,
                #ffffff 10%,
                #ffd4e8 45%,
                #ff75b8 100%
            );

        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* =========================================================
       DESCRIPCIÓN
       ========================================================= */

    .hero-description {
        color: rgba(255,255,255,0.76);

        font-size: 1.12rem;

        line-height: 1.7;

        max-width: 590px;

        margin-bottom: 31px;
    }

    /* =========================================================
       BUSCADOR
       ========================================================= */

    .hero-search {
        width: min(680px, 100%);

        min-height: 68px;

        padding: 8px;

        display: flex;
        align-items: center;

        gap: 7px;

        border-radius: 20px;

        background:
            rgba(255,255,255,0.085);

        border: 1px solid rgba(255,255,255,0.18);

        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);

        box-shadow:
            0 25px 70px rgba(0,0,0,0.25),
            inset 0 1px rgba(255,255,255,0.10);

        margin-bottom: 24px;
    }

    .search-icon {
        width: 49px;
        height: 49px;

        flex: 0 0 49px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 15px;

        color: rgba(255,255,255,0.85);

        background: rgba(255,255,255,0.06);

        font-size: 1rem;
    }

    .hero-search input {
        flex: 1;

        min-width: 0;

        border: 0;
        outline: 0;

        background: transparent;

        color: #fff;

        font-size: 0.98rem;

        padding: 12px 8px;
    }

    .hero-search input::placeholder {
        color: rgba(255,255,255,0.54);
    }

    .search-button {
        border: 0;

        min-height: 50px;

        padding: 0 22px;

        border-radius: 15px;

        background: #fff;

        color: #171017;

        font-weight: 700;

        font-size: 0.9rem;

        cursor: pointer;

        transition:
            transform .25s ease,
            box-shadow .25s ease;
    }

    .search-button:hover {
        transform: translateY(-2px);

        box-shadow:
            0 10px 25px rgba(0,0,0,0.22);
    }

    /* =========================================================
       BOTONES
       ========================================================= */

    .hero-actions {
        display: flex;
        flex-wrap: wrap;

        gap: 11px;

        margin-bottom: 34px;
    }

    .btn-premium {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 9px;

        min-height: 52px;

        padding: 0 21px;

        border-radius: 15px;

        text-decoration: none;

        font-size: 0.9rem;

        font-weight: 700;

        transition:
            transform .25s ease,
            box-shadow .25s ease,
            background .25s ease;
    }

    .btn-primary-premium {
        color: #fff;

        background:
            linear-gradient(
                135deg,
                #ff4da6,
                #d62978
            );

        box-shadow:
            0 15px 35px rgba(214,41,120,0.27);
    }

    .btn-primary-premium:hover {
        color: #fff;

        transform: translateY(-3px);

        box-shadow:
            0 20px 42px rgba(214,41,120,0.40);
    }

    .btn-glass-premium {
        color: #fff;

        background:
            rgba(255,255,255,0.07);

        border:
            1px solid rgba(255,255,255,0.18);

        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }

    .btn-glass-premium:hover {
        color: #fff;

        background:
            rgba(255,255,255,0.13);

        transform: translateY(-3px);
    }

    /* =========================================================
       CONFIANZA
       ========================================================= */

    .trust-row {
        display: flex;

        flex-wrap: wrap;

        gap: 22px;

        color: rgba(255,255,255,0.65);

        font-size: 0.78rem;

        font-weight: 500;
    }

    .trust-item {
        display: flex;

        align-items: center;

        gap: 7px;
    }

    .trust-item i {
        color: #ff9ccc;

        font-size: 0.8rem;
    }

    /* =========================================================
       LOGIN PREMIUM
       ========================================================= */

    .login-link {
        position: absolute;

        top: 25px;
        right: 30px;

        z-index: 8;

        display: inline-flex;

        align-items: center;

        gap: 9px;

        padding: 11px 17px;

        border-radius: 14px;

        color: rgba(255,255,255,0.92);

        text-decoration: none;

        font-size: 0.82rem;

        font-weight: 700;

        background:
            rgba(255,255,255,0.065);

        border:
            1px solid rgba(255,255,255,0.17);

        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);

        box-shadow:
            0 12px 35px rgba(0,0,0,0.18),
            inset 0 1px rgba(255,255,255,0.08);

        transition:
            all .25s ease;
    }

    .login-link::before {
        content: "";

        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: #ff79b8;

        box-shadow:
            0 0 12px rgba(255,121,184,0.8);
    }

    .login-link:hover {
        color: #fff;

        background:
            rgba(255,255,255,0.12);

        border-color:
            rgba(255,255,255,0.28);

        transform:
            translateY(-2px);

        box-shadow:
            0 15px 40px rgba(0,0,0,0.25);
    }

    /* =========================================================
       GLOW INFERIOR
       ========================================================= */

    .hero-bottom-glow {
        position: absolute;

        left: 0;
        bottom: 0;

        width: 100%;
        height: 120px;

        z-index: 2;

        pointer-events: none;

        background:
            linear-gradient(
                180deg,
                transparent,
                rgba(0,0,0,0.25)
            );
    }

    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 992px) {

        .premium-container {
            padding: 0 30px;
        }

        .public-home {
            background-position: 64% center;
        }

        .hero-title {
            font-size: clamp(3.3rem, 8vw, 5rem);
        }
    }

    /* =========================================================
       MÓVIL
       ========================================================= */

    @@media (max-width: 768px) {

        .public-home {
            min-height: calc(100vh - 56px);

            align-items: flex-end;

            background:
                linear-gradient(
                    180deg,
                    rgba(8,6,12,0.38) 0%,
                    rgba(8,6,12,0.75) 45%,
                    rgba(8,6,12,0.96) 100%
                ),
                url('/images/tropinails-public-hero.png')
                62% center / cover no-repeat;
        }

        .premium-container {
            padding: 0 18px;
        }

        .public-content {
            padding: 80px 0 40px;
        }

        .brand-badge {
            margin-bottom: 19px;
            font-size: 0.72rem;
        }

        .hero-title {
            font-size: 3.25rem;

            letter-spacing: -2.5px;

            line-height: 0.94;

            margin-bottom: 22px;
        }

        .hero-description {
            font-size: 0.98rem;

            line-height: 1.6;

            margin-bottom: 24px;
        }

        .hero-search {
            min-height: auto;

            flex-wrap: wrap;

            padding: 7px;

            border-radius: 17px;
        }

        .hero-search input {
            width: calc(100% - 60px);
            padding-right: 5px;
        }

        .search-button {
            width: 100%;
            min-height: 48px;
        }

        .hero-actions {
            gap: 9px;
        }

        .btn-premium {
            flex: 1;

            min-width: 150px;

            min-height: 50px;
        }

        .trust-row {
            gap: 12px 17px;

            font-size: 0.72rem;
        }

        .login-link {
            top: 17px;

            right: 17px;

            padding: 9px 13px;

            font-size: 0.76rem;
        }
    }

    /* =========================================================
       MÓVILES PEQUEÑOS
       ========================================================= */

    @@media (max-width: 420px) {

        .hero-title {
            font-size: 2.85rem;
        }

        .hero-actions {
            flex-direction: column;
        }

        .btn-premium {
            width: 100%;
        }
    }
</style>


<div class="public-home">

    <!-- =====================================================
         LOGIN
         ===================================================== -->

    <a asp-controller="Auth"
       asp-action="Login"
       class="login-link">

        Iniciar sesión

    </a>


    <!-- =====================================================
         CONTENIDO PRINCIPAL
         ===================================================== -->

    <div class="public-content">

        <div class="premium-container">

            <div class="row">

                <div class="col-lg-8">

                    <!-- BADGE -->

                    <div class="brand-badge">

                        <span class="brand-dot"></span>

                        La nueva forma de encontrar belleza

                    </div>


                    <!-- TITULO -->

                    <h1 class="hero-title">

                        Tu belleza.
                        <br />

                        <span>Tu estilo.</span>

                        <br />

                        Tu profesional.

                    </h1>


                    <!-- DESCRIPCION -->

                    <p class="hero-description">

                        Descubre manicuristas y profesionales de belleza,
                        explora sus trabajos y encuentra el servicio perfecto
                        para ti, todo desde un solo lugar.

                    </p>


                    <!-- BUSCADOR -->

                    <div class="hero-search">

                        <div class="search-icon">

                            <i class="bi bi-search"></i>

                        </div>


                        <input type="text"
                               placeholder="¿Qué servicio estás buscando?" />


                        <button type="button"
                                class="search-button">

                            Buscar

                        </button>

                    </div>


                    <!-- BOTONES -->

                    <div class="hero-actions">

                        <a href="#profesionales"
                           class="btn-premium btn-primary-premium">

                            <i class="bi bi-stars"></i>

                            Encontrar profesionales

                        </a>


                        <a href="#cerca"
                           class="btn-premium btn-glass-premium">

                            <i class="bi bi-geo-alt"></i>

                            Cerca de mí

                        </a>

                    </div>


                    <!-- CONFIANZA -->

                    <div class="trust-row">

                        <div class="trust-item">

                            <i class="bi bi-check-circle-fill"></i>

                            Profesionales reales

                        </div>


                        <div class="trust-item">

                            <i class="bi bi-images"></i>

                            Portafolios

                        </div>


                        <div class="trust-item">

                            <i class="bi bi-calendar-check"></i>

                            Agenda tu cita

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="hero-bottom-glow"></div>

</div>