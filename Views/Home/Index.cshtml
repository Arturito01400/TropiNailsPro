<!-- =========================================================
     DESCUBRIMIENTO
     ========================================================= -->

<section class="discovery-section">

    <div class="discovery-grid">


        <div class="discovery-card">

            <div class="discovery-icon">

                <i class="bi bi-images"></i>

            </div>

            <h3>

                Inspírate con trabajos reales.

            </h3>

            <p>

                Descubre estilos, tendencias y portafolios
                de profesionales de belleza. Encuentra una idea
                que te guste y descubre quién puede hacerla realidad.

            </p>

        </div>


        <div class="discovery-card">

            <div class="discovery-icon">

                <i class="bi bi-calendar-heart"></i>

            </div>

            <h3>

                Del descubrimiento a tu cita.

            </h3>

            <p>

                Cuando encuentres al profesional ideal,
                podrás conocer sus servicios, disponibilidad
                y continuar con tu reserva.

            </p>

        </div>


    </div>

