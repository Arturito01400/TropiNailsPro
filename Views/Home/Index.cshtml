                </div>

                <strong>Maquillaje</strong>

                <small>Eventos · Novias · Social</small>

            </button>


            <button type="button"
                    class="beauty-category"
                    data-category-search="Spa y estética">

                <div class="category-icon">

                    <i class="bi bi-flower1"></i>

