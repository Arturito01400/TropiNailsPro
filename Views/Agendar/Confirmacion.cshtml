@{
    ViewData["Title"] = "Reserva Confirmada";
}

<style>

body{
    background:linear-gradient(
        135deg,
        #ffe6f5,
        #eee1ff
    );
}

.confirmacion-box{

    max-width:650px;
    margin:60px auto;
    background:white;
    padding:40px;
    border-radius:25px;
    text-align:center;
    box-shadow:0 10px 30px rgba(0,0,0,.15);

}

.icono{

    font-size:70px;

}

.titulo{

    color:#d63384;
    font-weight:800;

}

.texto{

    font-size:18px;
    line-height:1.7;

}

.aviso{

    margin-top:20px;
    padding:18px;
    border-radius:15px;
    background:#fff8e6;
    border:1px solid #ffe08a;
    color:#8a6d3b;
    font-weight:600;

}

.btn-whatsapp{

    display:inline-block;
    margin-top:25px;
    padding:15px 35px;
    background:#25D366;
    color:white;
    border-radius:30px;
    text-decoration:none;
    font-weight:bold;
    transition:.25s;

}

.btn-whatsapp:hover{

    background:#1ebe5d;
    color:white;

}

.btn-inicio{

    display:inline-block;
    margin-top:15px;
    padding:12px 30px;
    background:#d63384;
    color:white;
    border-radius:30px;
    text-decoration:none;

}

.btn-inicio:hover{

    color:white;
    background:#bd2d74;

}

</style>

<div class="confirmacion-box">

    <div class="icono">
        💅✨
    </div>

    <h1 class="titulo">
        ¡Ya casi terminas tu reserva!
    </h1>

    <p class="texto">

        Tu solicitud de cita está preparada correctamente. 🎉

        <br><br>

        Solo falta un último paso para que la manicurista la reciba.

    </p>

    <div class="aviso">

        📲 Presiona el botón de <strong>WhatsApp</strong> que aparece debajo.

        <br><br>

        Al enviarlo, la manicurista recibirá toda la información de tu cita y podrá comunicarse contigo para confirmarla.

    </div>

    @if(TempData["WhatsApp"] != null)
    {
        <a href="@TempData["WhatsApp"]"
           target="_blank"
           class="btn-whatsapp">

            💬 Enviar solicitud por WhatsApp

        </a>
    }

    <br />

    <a asp-controller="Dashboard"
   asp-action="ClientasDashboard"
   class="btn-inicio">

    🏠 Volver al inicio

</a>

</div>