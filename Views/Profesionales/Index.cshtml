@using TropiNailsPro.Controllers
@model List<CategoriaCatalogo>

@{
    ViewData["Title"] = "Profesionales | TropiNails";

    var totalProfesionales = ViewBag.TotalProfesionales ?? 0;
    var totalServicios = ViewBag.TotalServicios ?? 0;
    var categoriasActivas = ViewBag.CategoriasActivas ?? 0;
}

<style>
    /* ============================================================
       TROPINAILS
       DIRECTORIO PÚBLICO DE PROFESIONALES
       ============================================================ */

    :root {
        --tn-pink: #ff3d9a;
        --tn-pink-dark: #d91f75;
        --tn-purple: #7c3aed;
        --tn-dark: #15121a;
        --tn-text: #24202a;
        --tn-muted: #77717e;
        --tn-soft: #fff4fa;
        --tn-border: rgba(30, 20, 40, .09);
        --tn-shadow: 0 18px 50px rgba(30, 20, 40, .10);
        --tn-radius: 24px;
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: #fff;
        color: var(--tn-text);
    }

    .tn-directory {
        min-height: 100vh;
        background:
            radial-gradient(circle at 10% 0%, rgba(255, 61, 154, .10), transparent 30%),
            radial-gradient(circle at 90% 5%, rgba(124, 58, 237, .09), transparent 28%),
            #fff;
        padding-bottom: 80px;
    }

    /* ============================================================
       HERO
       ============================================================ */

    .tn-hero {
        position: relative;
        overflow: hidden;
        padding: 72px 20px 62px;
        background:
            radial-gradient(circle at 15% 30%, rgba(255,255,255,.18), transparent 24%),
            radial-gradient(circle at 85% 10%, rgba(255,255,255,.13), transparent 24%),
            linear-gradient(135deg, #d91f75 0%, #ff3d9a 48%, #7c3aed 100%);
        color: white;
    }

    .tn-hero::before {
        content: "";
        position: absolute;
        width: 380px;
        height: 380px;
        border-radius: 50%;
        background: rgba(255,255,255,.08);
        top: -190px;
        right: -80px;
    }

    .tn-hero::after {
        content: "";
        position: absolute;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        background: rgba(255,255,255,.06);
        bottom: -180px;
        left: -80px;
    }

    .tn-hero-inner {
        position: relative;
        z-index: 2;
        max-width: 1180px;
        margin: auto;
        text-align: center;
    }

    .tn-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 15px;
        border-radius: 999px;
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.22);
        backdrop-filter: blur(12px);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .5px;
        margin-bottom: 20px;
    }

    .tn-hero h1 {
        font-size: clamp(38px, 6vw, 72px);
        line-height: .98;
        font-weight: 900;
        letter-spacing: -2.5px;
        margin: 0 auto 20px;
        max-width: 900px;
    }

    .tn-hero h1 span {
        display: block;
        opacity: .92;
    }

    .tn-hero-description {
        max-width: 700px;
        margin: 0 auto 30px;
        font-size: clamp(16px, 2vw, 20px);
        line-height: 1.6;
        color: rgba(255,255,255,.92);
    }

    /* ============================================================
       SEARCH
       ============================================================ */

    .tn-search {
        max-width: 720px;
        margin: 0 auto;
        position: relative;
    }

    .tn-search-box {
        display: flex;
        align-items: center;
        gap: 12px;
        background: white;
        border-radius: 18px;
        padding: 8px;
        box-shadow: 0 20px 55px rgba(0,0,0,.20);
    }

    .tn-search-icon {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        background: var(--tn-soft);
        color: var(--tn-pink);
        font-size: 21px;
    }

    .tn-search input {
        border: 0;
        outline: none;
        flex: 1;
        min-width: 0;
        font-size: 16px;
        color: var(--tn-text);
        background: transparent;
        padding: 12px 4px;
    }

    .tn-search input::placeholder {
        color: #aaa3ad;
    }

    .tn-search button {
        border: 0;
        border-radius: 14px;
        padding: 14px 23px;
        background: var(--tn-dark);
        color: white;
        font-weight: 800;
        cursor: pointer;
        transition: .2s ease;
    }

    .tn-search button:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0,0,0,.18);
    }

    /* ============================================================
       STATS
       ============================================================ */

    .tn-stats {
        max-width: 1000px;
        margin: -30px auto 0;
        padding: 0 20px;
        position: relative;
        z-index: 5;
    }

    .tn-stats-card {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        background: white;
        border: 1px solid var(--tn-border);
        border-radius: 22px;
        box-shadow: var(--tn-shadow);
        overflow: hidden;
    }

    .tn-stat {
        padding: 25px;
        text-align: center;
        border-right: 1px solid var(--tn-border);
    }

    .tn-stat:last-child {
        border-right: 0;
    }

    .tn-stat-number {
        font-size: 30px;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 7px;
    }

    .tn-stat-label {
        color: var(--tn-muted);
        font-size: 13px;
        font-weight: 600;
    }

    /* ============================================================
       CATEGORY NAVIGATION
       ============================================================ */

    .tn-content {
        max-width: 1200px;
        margin: 55px auto 0;
        padding: 0 20px;
    }

    .tn-section-heading {
        text-align: center;
        margin-bottom: 28px;
    }

    .tn-section-heading .small {
        color: var(--tn-pink);
        font-size: 13px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 1.4px;
        margin-bottom: 8px;
    }

    .tn-section-heading h2 {
        font-size: clamp(28px, 4vw, 42px);
        font-weight: 900;
        letter-spacing: -1.3px;
        margin: 0 0 8px;
    }

    .tn-section-heading p {
        color: var(--tn-muted);
        margin: 0;
    }

    .tn-category-nav {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding: 4px 2px 15px;
        scrollbar-width: thin;
        margin-bottom: 50px;
    }

    .tn-category-nav a {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 11px 17px;
        border: 1px solid var(--tn-border);
        background: white;
        border-radius: 999px;
        color: var(--tn-text);
        text-decoration: none;
        font-size: 14px;
        font-weight: 800;
        transition: .2s ease;
    }

    .tn-category-nav a:hover {
        color: var(--tn-pink);
        border-color: rgba(255,61,154,.35);
        transform: translateY(-2px);
        box-shadow: 0 8px 22px rgba(30,20,40,.07);
    }

    /* ============================================================
       CATEGORY SECTION
       ============================================================ */

    .tn-category {
        margin-bottom: 68px;
        scroll-margin-top: 90px;
    }

    .tn-category-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
    }

    .tn-category-title {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .tn-category-icon {
        width: 52px;
        height: 52px;
        flex: 0 0 52px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        background: var(--tn-soft);
        font-size: 25px;
    }

    .tn-category-title h2 {
        margin: 0 0 5px;
        font-size: clamp(23px, 3vw, 31px);
        font-weight: 900;
        letter-spacing: -.7px;
    }

    .tn-category-title p {
        margin: 0;
        color: var(--tn-muted);
        font-size: 14px;
    }

    .tn-category-count {
        color: var(--tn-muted);
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
    }

    /* ============================================================
       PROFESSIONAL CARDS
       ============================================================ */

    .tn-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
    }

    .tn-card {
        position: relative;
        overflow: hidden;
        background: white;
        border: 1px solid var(--tn-border);
        border-radius: var(--tn-radius);
        box-shadow: 0 8px 30px rgba(30,20,40,.07);
        transition: transform .25s ease, box-shadow .25s ease;
    }

    .tn-card:hover {
        transform: translateY(-7px);
        box-shadow: 0 22px 50px rgba(30,20,40,.14);
    }

    .tn-card-image {
        position: relative;
        height: 245px;
        background:
            linear-gradient(135deg, #fff0f7, #f0e9ff);
        overflow: hidden;
    }

    .tn-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform .5s ease;
    }

    .tn-card:hover .tn-card-image img {
        transform: scale(1.055);
    }

    .tn-no-photo {
        width: 100%;
        height: 100%;
        display: grid;
        place-items: center;
        color: var(--tn-pink);
        font-size: 55px;
    }

    .tn-card-overlay {
        position: absolute;
        inset: auto 0 0 0;
        height: 80px;
        background: linear-gradient(transparent, rgba(0,0,0,.45));
        pointer-events: none;
    }

    .tn-card-location {
        position: absolute;
        left: 13px;
        bottom: 13px;
        color: white;
        font-size: 12px;
        font-weight: 700;
        text-shadow: 0 2px 8px rgba(0,0,0,.35);
    }

    .tn-card-body {
        padding: 17px;
    }

    .tn-card-name {
        margin: 0 0 5px;
        font-size: 18px;
        font-weight: 900;
        letter-spacing: -.3px;
    }

    .tn-card-name a {
        color: inherit;
        text-decoration: none;
    }

    .tn-card-name a:hover {
        color: var(--tn-pink);
    }

    .tn-card-subtitle {
        min-height: 20px;
        color: var(--tn-muted);
        font-size: 13px;
        margin-bottom: 13px;
    }

    .tn-service-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        min-height: 31px;
        margin-bottom: 15px;
    }

    .tn-service {
        display: inline-flex;
        align-items: center;
        padding: 6px 9px;
        border-radius: 999px;
        background: #f7f5f8;
        color: #625b66;
        font-size: 11px;
        font-weight: 700;
    }

    .tn-card-button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 43px;
        border-radius: 13px;
        background: var(--tn-dark);
        color: white;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
        transition: .2s ease;
    }

    .tn-card-button:hover {
        color: white;
        background: var(--tn-pink);
    }

    /* ============================================================
       EMPTY CATEGORY
       ============================================================ */

    .tn-empty-category {
        padding: 30px;
        border-radius: 20px;
        background: #faf8fb;
        border: 1px dashed #ded7e1;
        text-align: center;
        color: var(--tn-muted);
    }

    /* ============================================================
       SEARCH FILTER
       ============================================================ */

    .tn-hidden {
        display: none !important;
    }

    .tn-no-results {
        display: none;
        text-align: center;
        padding: 70px 20px;
    }

    .tn-no-results.show {
        display: block;
    }

    .tn-no-results-icon {
        font-size: 55px;
        margin-bottom: 12px;
    }

    .tn-no-results h3 {
        font-size: 25px;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .tn-no-results p {
        color: var(--tn-muted);
        margin: 0;
    }

    /* ============================================================
       RESPONSIVE
       ============================================================ */

    @@media (max-width: 1050px) {
        .tn-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 760px) {

        .tn-hero {
            padding: 52px 16px 58px;
        }

        .tn-hero h1 {
            letter-spacing: -1.5px;
        }

        .tn-search-box {
            padding: 6px;
        }

        .tn-search button {
            padding: 13px 15px;
        }

        .tn-stats {
            margin-top: -22px;
        }

        .tn-stat {
            padding: 18px 10px;
        }

        .tn-stat-number {
            font-size: 24px;
        }

        .tn-stat-label {
            font-size: 11px;
        }

        .tn-content {
            margin-top: 40px;
        }

        .tn-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 13px;
        }

        .tn-card-image {
            height: 210px;
        }

        .tn-card-body {
            padding: 13px;
        }

        .tn-card-name {
            font-size: 16px;
        }

        .tn-category-head {
            align-items: flex-start;
        }

        .tn-category-count {
            display: none;
        }
    }

    @@media (max-width: 480px) {

        .tn-hero h1 {
            font-size: 39px;
        }

        .tn-hero-description {
            font-size: 15px;
        }

        .tn-search-box {
            flex-wrap: wrap;
        }

        .tn-search-icon {
            width: 42px;
            height: 42px;
            flex-basis: 42px;
        }

        .tn-search input {
            width: calc(100% - 65px);
        }

        .tn-search button {
            width: 100%;
        }

        .tn-grid {
            grid-template-columns: 1fr;
        }

        .tn-card-image {
            height: 270px;
        }

        .tn-category {
            margin-bottom: 48px;
        }
    }
</style>

<div class="tn-directory">

    <!-- =========================================================
         HERO
         ========================================================= -->

    <section class="tn-hero">

        <div class="tn-hero-inner">

            <div class="tn-eyebrow">
                ✨ DESCUBRE EL TALENTO DE TROPINAILS
            </div>

            <h1>
                Tu próxima experiencia de belleza
                <span>empieza aquí.</span>
            </h1>

            <p class="tn-hero-description">
                Descubre profesionales de belleza, explora sus servicios
                y encuentra el lugar perfecto para consentirte.
            </p>

            <div class="tn-search">

                <div class="tn-search-box">

                    <div class="tn-search-icon">
                        🔎
                    </div>

                    <input
                        type="text"
                        id="tnSearchInput"
                        placeholder="Busca una profesional, servicio o especialidad..."
                        autocomplete="off" />

                    <button type="button" id="tnSearchButton">
                        Buscar
                    </button>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         STATS
         ========================================================= -->

    <section class="tn-stats">

        <div class="tn-stats-card">

            <div class="tn-stat">
                <div class="tn-stat-number">
                    @totalProfesionales
                </div>

                <div class="tn-stat-label">
                    Profesionales
                </div>
            </div>

            <div class="tn-stat">
                <div class="tn-stat-number">
                    @totalServicios
                </div>

                <div class="tn-stat-label">
                    Servicios disponibles
                </div>
            </div>

            <div class="tn-stat">
                <div class="tn-stat-number">
                    @categoriasActivas
                </div>

                <div class="tn-stat-label">
                    Especialidades
                </div>
            </div>

        </div>

    </section>


    <!-- =========================================================
         CONTENIDO
         ========================================================= -->

    <main class="tn-content">

        <div class="tn-section-heading">

            <div class="small">
                EXPLORE TROPINAILS
            </div>

            <h2>
                Encuentra tu especialista
            </h2>

            <p>
                Belleza, estilo y bienestar en un solo lugar.
            </p>

        </div>


        <!-- =====================================================
             NAVEGACIÓN DE CATEGORÍAS
             ===================================================== -->

        <nav class="tn-category-nav">

            @foreach (var categoria in Model.Where(c => c.Profesionales.Any()))
            {
                <a href="#categoria-@categoria.Clave">
                    <span>@categoria.Icono</span>
                    @categoria.Nombre
                </a>
            }

        </nav>


        <!-- =====================================================
             RESULTADO DE BÚSQUEDA VACÍO
             ===================================================== -->

        <div id="tnNoResults" class="tn-no-results">

            <div class="tn-no-results-icon">
                🔍
            </div>

            <h3>
                No encontramos resultados
            </h3>

            <p>
                Prueba con otro nombre, servicio o especialidad.
            </p>

        </div>


        <!-- =====================================================
             CATEGORÍAS
             ===================================================== -->

        @foreach (var categoria in Model.Where(c => c.Profesionales.Any()))
        {
            <section
                class="tn-category"
                id="categoria-@categoria.Clave">

                <div class="tn-category-head">

                    <div class="tn-category-title">

                        <div class="tn-category-icon">
                            @categoria.Icono
                        </div>

                        <div>

                            <h2>
                                @categoria.Nombre
                            </h2>

                            <p>
                                @categoria.Descripcion
                            </p>

                        </div>

                    </div>

                    <div class="tn-category-count">
                        @categoria.Profesionales.Count
                        @(categoria.Profesionales.Count == 1
                            ? "profesional"
                            : "profesionales")
                    </div>

                </div>


                <div class="tn-grid">

                    @foreach (var profesional in categoria.Profesionales)
                    {
                        var serviciosMostrar = profesional.Servicios
                            .Take(3)
                            .ToList();

                        var ubicacion = "";

                        if (!string.IsNullOrWhiteSpace(profesional.Ciudad))
                        {
                            ubicacion = profesional.Ciudad;

                            if (!string.IsNullOrWhiteSpace(profesional.Provincia))
                            {
                                ubicacion += ", " + profesional.Provincia;
                            }
                        }
                        else if (!string.IsNullOrWhiteSpace(profesional.Provincia))
                        {
                            ubicacion = profesional.Provincia;
                        }

                        <article
                            class="tn-card"
                            data-search="
                                @profesional.Nombre
                                @ubicacion
                                @string.Join(" ", profesional.Servicios.Select(s => s.Nombre))
                                @string.Join(" ", profesional.Categorias)
                            ">

                            <div class="tn-card-image">

                                @if (!string.IsNullOrWhiteSpace(profesional.Foto))
                                {
                                    <img
                                        src="@profesional.Foto"
                                        alt="@profesional.Nombre"
                                        loading="lazy"
                                        onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />

                                    <div
                                        class="tn-no-photo"
                                        style="display:none;">
                                        💎
                                    </div>
                                }
                                else
                                {
                                    <div class="tn-no-photo">
                                        💎
                                    </div>
                                }

                                <div class="tn-card-overlay"></div>

                                @if (!string.IsNullOrWhiteSpace(ubicacion))
                                {
                                    <div class="tn-card-location">
                                        📍 @ubicacion
                                    </div>
                                }

                            </div>


                            <div class="tn-card-body">

                                <h3 class="tn-card-name">

                                    <a href="@profesional.UrlPerfil">
                                        @profesional.Nombre
                                    </a>

                                </h3>


                                <div class="tn-card-subtitle">

                                    @if (profesional.Servicios.Any())
                                    {
                                        @($"{profesional.Servicios.Count} " +
                                            (profesional.Servicios.Count == 1
                                                ? "servicio disponible"
                                                : "servicios disponibles"))
                                    }
                                    else
                                    {
                                        @:Profesional de belleza
                                    }

                                </div>


                                <div class="tn-service-list">

                                    @foreach (var servicio in serviciosMostrar)
                                    {
                                        <span class="tn-service">
                                            @servicio.Nombre
                                        </span>
                                    }

                                    @if (profesional.Servicios.Count > 3)
                                    {
                                        <span class="tn-service">
                                            +@(profesional.Servicios.Count - 3)
                                        </span>
                                    }

                                </div>


                                <a
                                    class="tn-card-button"
                                    href="@profesional.UrlPerfil">

                                    Ver perfil
                                    <span style="margin-left:7px;">
                                        →
                                    </span>

                                </a>

                            </div>

                        </article>
                    }

                </div>

            </section>
        }

    </main>

</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const input = document.getElementById("tnSearchInput");
        const button = document.getElementById("tnSearchButton");
        const cards = Array.from(document.querySelectorAll(".tn-card"));
        const sections = Array.from(document.querySelectorAll(".tn-category"));
        const noResults = document.getElementById("tnNoResults");

        function normalizar(texto) {
            return (texto || "")
                .toLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "");
        }

        function buscar() {

            const termino = normalizar(input.value.trim());

            let encontrados = 0;

            cards.forEach(function (card) {

                const contenido = normalizar(
                    card.getAttribute("data-search")
                );

                const coincide =
                    termino === "" ||
                    contenido.includes(termino);

                card.classList.toggle(
                    "tn-hidden",
                    !coincide
                );

                if (coincide) {
                    encontrados++;
                }
            });

            sections.forEach(function (section) {

                const visibles = section.querySelectorAll(
                    ".tn-card:not(.tn-hidden)"
                );

                section.style.display =
                    visibles.length > 0 ? "" : "none";
            });

            noResults.classList.toggle(
                "show",
                encontrados === 0
            );
        }

        input.addEventListener("input", buscar);

        button.addEventListener("click", buscar);

        input.addEventListener("keydown", function (event) {

            if (event.key === "Enter") {
                event.preventDefault();
                buscar();
            }

        });

    });
</script>