@using System.Globalization
@using System.Linq
@using TropiNailsPro.Models

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    // ============================================================
    // TROPINAILS PRO
    // VITRINA PÚBLICA PREMIUM
    // BELLEZA · ESTÉTICA · CUIDADO PERSONAL
    // ============================================================

    var manicurista =
        ViewBag.Manicurista as Manicurista;

    var modelos =
        ViewBag.Modelos as List<ModeloUnas>
        ?? new List<ModeloUnas>();

    var feed =
        ViewBag.Feed as List<Publicacion>
        ?? new List<Publicacion>();

    var usuario =
        manicurista?.Usuario;

    // ============================================================
    // FOTOS
    // ============================================================

    var fotoNegocio =
        ViewBag.FotoNegocio as string
        ?? manicurista?.FotoNegocio
        ?? "/img/user-default.png";

    var fotoPerfil =
        ViewBag.FotoPerfil as string
        ?? usuario?.FotoPerfilUrl
        ?? usuario?.FotoPerfil
        ?? "/img/user-default.png";

    if (string.IsNullOrWhiteSpace(fotoNegocio))
    {
        fotoNegocio = fotoPerfil;
    }

    if (string.IsNullOrWhiteSpace(fotoPerfil))
    {
        fotoPerfil = "/img/user-default.png";
    }

    // ============================================================
    // WHATSAPP
    // ============================================================

    var telefonoWhatsApp =
        manicurista?.TelefonoNegocio
        ?? usuario?.WhatsApp
        ?? usuario?.Telefono;

    string? whatsappUrl = null;

    if (!string.IsNullOrWhiteSpace(telefonoWhatsApp))
    {
        var numeroWhatsApp =
            new string(
                telefonoWhatsApp
                    .Where(char.IsDigit)
                    .ToArray()
            );

        if (numeroWhatsApp.Length == 10)
        {
            numeroWhatsApp = "1" + numeroWhatsApp;
        }

        if (!string.IsNullOrWhiteSpace(numeroWhatsApp))
        {
            whatsappUrl =
                "https://wa.me/" + numeroWhatsApp;
        }
    }

    // ============================================================
    // UBICACIÓN
    // ============================================================

    bool ubicacionActiva =
        ViewBag.UbicacionActiva != null &&
        (bool)ViewBag.UbicacionActiva;

    decimal? latitud =
        ViewBag.Latitud as decimal?;

    decimal? longitud =
        ViewBag.Longitud as decimal?;

    var direccion =
        ViewBag.DireccionNegocio as string
        ?? manicurista?.DireccionNegocio;

    var ciudad =
        ViewBag.Ciudad as string
        ?? manicurista?.Ciudad;

    var provincia =
        ViewBag.Provincia as string
        ?? manicurista?.Provincia;

    // ============================================================
    // IDENTIDAD
    // ============================================================

    var nombreNegocio =
        !string.IsNullOrWhiteSpace(
            manicurista?.NombreNegocio)
            ? manicurista!.NombreNegocio
            : "Espacio de belleza";

    var nombreProfesional =
        !string.IsNullOrWhiteSpace(
            usuario?.Nombre)
            ? usuario!.Nombre
            : "Profesional de belleza";

    var ubicacionTexto =
        !string.IsNullOrWhiteSpace(ciudad)
            ? ciudad
            : !string.IsNullOrWhiteSpace(provincia)
                ? provincia
                : "República Dominicana";

    // ============================================================
    // CONTADORES
    // ============================================================

    var totalModelos =
        modelos.Count;

    var totalPublicaciones =
        feed.Count;

    // ============================================================
    // SLUG / AGENDAR
    // ============================================================

    var slug =
        manicurista?.Slug;

    string? agendarUrl = null;

    if (!string.IsNullOrWhiteSpace(slug))
    {
        agendarUrl =
            "/Agendar?slug=" +
            Uri.EscapeDataString(slug);
    }

    // ============================================================
    // SERVICIOS
    // ============================================================

    var servicios =
        manicurista?.Servicios?
            .Where(s =>
                s != null &&
                s.Activo &&
                !string.IsNullOrWhiteSpace(s.Nombre))
            .OrderBy(s => s.Nombre)
            .ToList()
        ?? new List<Servicio>();

    var totalServicios =
        servicios.Count;

    // ============================================================
    // CATEGORÍA VISUAL
    //
    // No limitamos la plataforma a uñas.
    // Si el modelo todavía no tiene una categoría profesional,
    // utilizamos una descripción universal.
    // ============================================================

    var especialidad =
        "Profesional de belleza";

    // ============================================================
    // GOOGLE MAPS
    // ============================================================

    string? mapaUrl = null;

    if (ubicacionActiva &&
        latitud.HasValue &&
        longitud.HasValue)
    {
        mapaUrl =
            "https://www.google.com/maps/search/?api=1&query=" +
            latitud.Value.ToString(
                CultureInfo.InvariantCulture) +
            "," +
            longitud.Value.ToString(
                CultureInfo.InvariantCulture);
    }
}

<style>

/* ============================================================
   TROPINAILS PRO
