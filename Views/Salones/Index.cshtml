/* ============================================================
   PORTFOLIO
   ============================================================ */

.portfolio-grid {

    display: grid;

    grid-template-columns:
        repeat(
            4,
            minmax(0,1fr)
        );

    gap: 15px;
}

.portfolio-card {

    position: relative;

    overflow: hidden;

    aspect-ratio:
        4 / 5;

    border-radius: 21px;

    background:
        #17121d;

    box-shadow:
        0 12px 35px
        rgba(35,15,50,.09);
}

.portfolio-media {

    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

    transition:
        transform .4s ease;
}

.portfolio-card:hover
.portfolio-media {

    transform:
        scale(1.055);
}

.portfolio-overlay {

    position: absolute;

    inset: 0;

    display: flex;

    align-items: flex-end;

    padding: 17px;

    background:
        linear-gradient(
            180deg,
            transparent 50%,
            rgba(0,0,0,.78)
        );

    pointer-events: none;
}

.portfolio-info {

    color: white;
}

.portfolio-name {

    font-size: 14px;

    font-weight: 950;
}

.portfolio-description {

    margin-top: 4px;

    color:
        rgba(255,255,255,.76);

    font-size: 11px;

    line-height: 1.4;
}

.portfolio-badge {

    position: absolute;

    top: 12px;
    left: 12px;

    padding:
        7px 10px;

    border-radius: 999px;

    color: white;

    background:
        rgba(0,0,0,.46);

    border:
        1px solid
        rgba(255,255,255,.16);

    backdrop-filter:
        blur(10px);

    font-size: 10px;

    font-weight: 900;
}

.portfolio-price {

    position: absolute;

    right: 12px;
    top: 12px;

    padding:
        7px 9px;

    border-radius: 10px;

    color:
        var(--tn-pink);

    background:
        rgba(255,255,255,.94);

    font-size: 10px;

    font-weight: 950;
}

/* ============================================================
   FEED
   ============================================================ */

.feed-layout {

    width:
        min(
            780px,
            100%
        );

    margin:
        0 auto;
}

.post-card {

    overflow: hidden;

    margin-bottom: 21px;

    border:
        1px solid
        var(--tn-border);

    border-radius:
        var(--tn-radius);

    background: white;

    box-shadow:
        var(--tn-shadow);
}

.post-header {

    display: flex;

    align-items: center;

    gap: 12px;

    padding:
        17px 18px;
}

.post-avatar {

    width: 49px;
    height: 49px;

    object-fit: cover;

    border-radius: 50%;

    border:
        2px solid white;

    box-shadow:
        0 0 0 2px
        #ff69aa;
}

.post-user {

    color:
        var(--tn-dark);

    font-size: 14px;

    font-weight: 950;
}

.post-business {

    margin-top: 2px;

    color:
        var(--tn-muted);

    font-size: 12px;

    font-weight: 600;
}

.post-media-wrap {

    background:
        #111;
}

.post-media {

    width: 100%;

    max-height: 720px;

    object-fit: cover;

    display: block;
}

.post-video {

    width: 100%;

    max-height: 720px;

    display: block;

    background:
        #000;
}

.post-body {

    padding:
        18px 19px 21px;
}

.post-text {

    margin: 0;

    color:
        #413847;

    font-size: 14px;

    line-height: 1.7;

    white-space: pre-line;
}

/* ============================================================
   MAP
   ============================================================ */

.map-card {

    padding: 0;

    overflow: hidden;
}

.map-header {

    padding:
        22px 23px 17px;
}

.map-frame {

    width: 100%;

    height: 370px;

    display: block;

    border: 0;
}

.map-actions {

    display: flex;

    justify-content: center;

    padding:
        14px 20px 20px;
}

.map-open {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    padding:
        11px 17px;

    border-radius: 999px;

    color:
        var(--tn-purple) !important;

    background:
        #f5efff;

    text-decoration: none !important;

    font-size: 12px;

    font-weight: 900;
}

.map-placeholder {

    min-height: 260px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    padding: 35px;

    text-align: center;

    background:
        radial-gradient(
            circle at center,
            #fff3f8,
            #f7f3fa
        );
}

.map-placeholder-icon {

    width: 74px;
    height: 74px;

    display: flex;

    align-items: center;
    justify-content: center;

    margin-bottom: 15px;

    border-radius: 50%;

    background: white;

    box-shadow:
        0 12px 30px
        rgba(40,20,55,.08);

    font-size: 30px;
}

.map-placeholder h4 {

    margin:
        0 0 6px;

    color:
        var(--tn-dark);

    font-size: 18px;

    font-weight: 950;
}

.map-placeholder p {

    max-width: 460px;

    margin: 0;

    color:
        var(--tn-muted);

    font-size: 14px;

    line-height: 1.6;
}

/* ============================================================
   EMPTY
   ============================================================ */

.empty-state {

    padding:
        50px 25px;

    text-align: center;

    border:
        1px dashed
        #ddd5e1;

    border-radius:
        var(--tn-radius);

    background:
        rgba(255,255,255,.68);

    color:
        var(--tn-muted);
}

.empty-icon {

    width: 72px;
    height: 72px;

    display: flex;

    align-items: center;
    justify-content: center;

    margin:
        0 auto 15px;

    border-radius: 50%;

    background:
        #fff0f7;

    font-size: 30px;
}

.empty-state h4 {

    margin:
        0 0 7px;

    color:
        var(--tn-dark);

    font-size: 18px;

    font-weight: 950;
}

.empty-state p {

    margin: 0;

    font-size: 14px;
}

/* ============================================================
   FINAL CTA
   ============================================================ */

.final-cta {

    position: relative;

    overflow: hidden;

    margin-top: 65px;

    padding:
        58px 30px;

    text-align: center;

    color: white;

    border-radius:
        34px;

    background:

        radial-gradient(
            circle at 15% 15%,
            rgba(255,255,255,.20),
            transparent 25%
        ),

        radial-gradient(
            circle at 85% 80%,
            rgba(255,255,255,.14),
            transparent 30%
        ),

        linear-gradient(
            135deg,
            #ff3d91,
            #8c42ff
        );

    box-shadow:
        0 25px 65px
        rgba(111,39,190,.25);
}

.final-cta h3 {

    position: relative;

    z-index: 2;

    margin:
        0 0 10px;

    font-size:
        clamp(
            26px,
            4vw,
            38px
        );

    font-weight: 950;

    letter-spacing:
        -1px;
}

.final-cta p {

    position: relative;

    z-index: 2;

    max-width: 650px;

    margin:
        0 auto 25px;

    color:
        rgba(255,255,255,.87);

    font-size: 14px;

    line-height: 1.65;
}

.final-cta-button {

    position: relative;

    z-index: 2;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    min-height: 52px;

    padding:
        13px 24px;

    border-radius: 999px;

    color:
        #7627d7 !important;

    background:
        white;

    text-decoration: none !important;

    font-size: 13px;

    font-weight: 950;

    box-shadow:
        0 12px 30px
        rgba(0,0,0,.13);

    transition:
        transform .2s ease,
        box-shadow .2s ease;
}

.final-cta-button:hover {

    transform:
        translateY(-3px);

    box-shadow:
        0 18px 35px
        rgba(0,0,0,.18);
}

/* ============================================================
   MOBILE FLOATING ACTION
   ============================================================ */

.mobile-book-bar {

    display: none;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */

@@media (max-width: 1000px) {

    .services-grid {

        grid-template-columns:
            repeat(
                2,
                minmax(0,1fr)
            );
    }

    .portfolio-grid {

        grid-template-columns:
            repeat(3, minmax(0,1fr));
    }

    .intro-grid {

        grid-template-columns: 1fr;
    }
}

@@media (max-width: 800px) {

    .about-grid {

        grid-template-columns: 1fr;
    }

    .portfolio-grid {

        grid-template-columns:
            repeat(2, minmax(0,1fr));
    }

    .business-hero {

        min-height: 590px;
    }

    .hero-content {

        padding:
            35px 30px 45px;
    }

    .hero-profile-row {

        align-items: center;

        flex-direction: column;

        text-align: center;
    }

    .hero-info {

        width: 100%;
    }

    .hero-meta {

        justify-content: center;
    }

    .action-grid {

        grid-template-columns: 1fr;
    }

    .action-button {

        min-height: 55px;
    }
}

@@media (max-width: 600px) {

    .public-profile {

        width:
            min(
                100% - 12px,
                600px
            );
    }

    .business-hero {

        min-height: 620px;

        border-radius:
            0 0 30px 30px;
    }

    .profile-floating-brand {

        left: 14px;
        top: 14px;

        padding:
            8px 11px;

        font-size: 11px;
    }

    .profile-floating-brand-icon {

        width: 22px;
        height: 22px;
    }

    .hero-location {

        right: 14px;
        top: 14px;

        max-width: 150px;

        overflow: hidden;

        white-space: nowrap;

        text-overflow: ellipsis;

        padding:
            8px 11px;

        font-size: 10px;
    }

    .hero-content {

        padding:
            25px 18px 38px;
    }

    .profile-avatar {

        width: 105px;
        height: 105px;
    }

    .hero-title {

        font-size: 35px;

        letter-spacing:
            -1.4px;
    }

    .hero-subtitle {

        font-size: 13px;
    }

    .action-panel {

        width:
            calc(100% - 14px);

        margin-top:
            -20px;

        padding: 9px;

        border-radius: 21px;
    }

    .profile-content {

        padding-top: 28px;
    }

    .section {

        margin-top: 40px;
    }

    .section-title {

        font-size: 23px;
    }

    .section-heading {

        align-items: flex-start;

        flex-direction: column;

        margin-bottom: 16px;
    }

    .services-grid {

        grid-template-columns: 1fr;

        gap: 14px;
    }

    .service-card {

        padding: 20px;
    }

    .portfolio-grid {

        grid-template-columns:
            repeat(2, minmax(0,1fr));

        gap: 9px;
    }

    .portfolio-card {

        border-radius: 16px;
    }

    .portfolio-overlay {

        padding: 11px;
    }

    .portfolio-name {

        font-size: 11px;
    }

    .portfolio-description {

        display: none;
    }

    .about-grid {

        gap: 13px;
    }

    .info-card {

        padding: 20px;
    }

    .social-buttons {

        grid-template-columns: 1fr;
    }

    .map-frame {

        height: 300px;
    }

    .final-cta {

        margin-top: 45px;

        padding:
            42px 20px;

        border-radius:
            27px;
    }

    .mobile-book-bar {

        position: fixed;

        left: 10px;
        right: 10px;
        bottom: 10px;

        z-index: 100;

        display: flex;

        padding: 8px;

        border-radius: 19px;

        background:
            rgba(255,255,255,.94);

        border:
            1px solid
            rgba(255,255,255,.9);

        box-shadow:
            0 15px 45px
            rgba(30,10,40,.18);

        backdrop-filter:
            blur(18px);

        -webkit-backdrop-filter:
            blur(18px);
    }

    .mobile-book-button {

        width: 100%;

        min-height: 49px;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 8px;

        border-radius: 14px;

        color: white !important;

        background:
            linear-gradient(
                135deg,
                var(--tn-pink),
                var(--tn-purple)
            );

        text-decoration: none !important;

        font-size: 13px;

        font-weight: 950;
    }
}

@@media (max-width: 390px) {

    .hero-title {

        font-size: 31px;
    }

    .portfolio-grid {

        grid-template-columns: 1fr 1fr;
    }

    .service-name {

        font-size: 16px;
    }
}

</style>


<div class="public-profile-page">

    <!-- ========================================================
         HERO
    ========================================================= -->

    <section class="business-hero">

        <img
            src="@fotoNegocio"
            class="hero-image"
            alt="@nombreNegocio"
            loading="eager"
            onerror="this.onerror=null;this.src='/img/user-default.png';"
        />

        <div class="hero-cover"></div>

        <div class="hero-glow"></div>


        <div class="profile-floating-brand">

            <span class="profile-floating-brand-icon">
                ✨
            </span>

            TropiNails Pro

        </div>


        <div class="hero-location">

            📍

            <span>
                @ubicacionTexto
            </span>

        </div>


        <div class="hero-content">

            <div class="hero-profile-row">

                <div class="profile-avatar-wrap">

                    <img
                        src="@fotoPerfil"
                        class="profile-avatar"
                        alt="@nombreProfesional"
                        loading="eager"
                        onerror="this.onerror=null;this.src='/img/user-default.png';"
                    />

                    <div class="verified-badge">
                        ✓
                    </div>

                </div>


                <div class="hero-info">

                    <div class="hero-eyebrow">
                        ✨ Profesional de belleza
                    </div>

                    <h1 class="hero-title">
                        @nombreNegocio
                    </h1>

                    <p class="hero-subtitle">
                        @nombreProfesional
                        ·
                        @especialidad
                    </p>


                    <div class="hero-meta">

                        @if (!string.IsNullOrWhiteSpace(ciudad))
                        {
                            <span class="hero-pill">
                                📍 @ciudad
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(provincia))
                        {
                            <span class="hero-pill">
                                🗺️ @provincia
                            </span>
                        }

                        @if (totalServicios > 0)
                        {
                            <span class="hero-pill">
                                ✨ @totalServicios servicios
                            </span>
                        }

                        @if (totalModelos > 0)
                        {
                            <span class="hero-pill">
                                💎 @totalModelos trabajos
                            </span>
                        }

                        @if (totalPublicaciones > 0)
                        {
                            <span class="hero-pill">
                                🔥 @totalPublicaciones publicaciones
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ========================================================
         ACCIONES
    ========================================================= -->

    <div class="action-panel">

        <div class="action-grid">

            @if (!string.IsNullOrWhiteSpace(agendarUrl))
            {
                <a
                    href="@agendarUrl"
                    class="action-button action-primary">

                    💬

                    <span>
                        Hablar y agendar
                    </span>

                </a>
            }
            else
            {
                <div class="action-button action-secondary">

                    💬

                    <span>
                        Contactar profesional
                    </span>

                </div>
            }


            @if (!string.IsNullOrWhiteSpace(whatsappUrl))
            {
                <a
                    href="@whatsappUrl"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="action-button action-whatsapp">

                    💚

                    <span>
                        WhatsApp
                    </span>

                </a>
            }


            @if (ubicacionActiva &&
                 latitud.HasValue &&
                 longitud.HasValue)
            {
                <a
                    href="#ubicacion"
                    class="action-button action-secondary">

                    📍

                    <span>
                        Ver ubicación
                    </span>

                </a>
            }
            else
            {
                <a
                    href="#informacion"
                    class="action-button action-secondary">

                    ✨

                    <span>
                        Conocer espacio
                    </span>

                </a>
            }

        </div>

    </div>


    <main class="public-profile profile-content">


        <!-- ====================================================
             INTRO
        ===================================================== -->

        <section class="section">

            <div class="intro-card">

                <div class="intro-grid">

                    <div>

                        <div class="section-kicker">
                            ✨ Belleza en un solo lugar
                        </div>

                        <h2 class="intro-title">
                            Conoce @nombreNegocio
                        </h2>

                        <p class="intro-text">
                            Descubre los servicios, trabajos,
                            novedades y formas de contacto de
                            @nombreProfesional. Todo lo que necesitas
                            para elegir tu próxima experiencia de
                            belleza está aquí.
                        </p>

                    </div>


                    <div class="intro-stat">

                        <span class="intro-stat-number">
                            @totalServicios
                        </span>

                        <span class="intro-stat-label">
                            servicios disponibles
                        </span>

                    </div>

                </div>

            </div>

        </section>


        <!-- ====================================================
             SERVICIOS
        ===================================================== -->

        <section class="section">

            <div class="section-heading">

                <div>

                    <div class="section-kicker">
                        💖 Lo que ofrece
                    </div>

                    <h2 class="section-title">
                        Servicios de belleza
                    </h2>

                    <div class="section-subtitle">
                        Elige lo que deseas y comienza a conversar
                        con tu profesional.
                    </div>

                </div>


                @if (totalServicios > 0)
                {
                    <div class="section-count">
                        @totalServicios servicios
                    </div>
                }

            </div>


            @if (servicios.Any())
            {
                <div class="services-grid">

                    @foreach (var servicio in servicios)
                    {
                        <article class="service-card">

                            <div class="service-top">

                                <div class="service-icon">
                                    ✨
                                </div>

                                <span class="service-active">
                                    DISPONIBLE
                                </span>

                            </div>


                            <div class="service-name">
                                @servicio.Nombre
                            </div>


                            <div class="service-description">

                                @if (!string.IsNullOrWhiteSpace(
                                    servicio.Descripcion))
                                {
                                    @servicio.Descripcion
                                }
                                else
                                {
                                    <span>
                                        Servicio profesional
                                        de belleza.
                                    </span>
                                }

                            </div>


                            <div class="service-meta">

                                @if (servicio.DuracionMinutos.HasValue &&
                                     servicio.DuracionMinutos.Value > 0)
                                {
                                    <span class="service-meta-pill">

                                        ⏱
                                        @servicio.DuracionMinutos
                                        min

                                    </span>
                                }

                                <span class="service-meta-pill">
                                    💬 Consulta disponibilidad
                                </span>

                            </div>


                            @if (servicio.Precio.HasValue)
                            {
                                <div class="service-price">

                                    RD$
                                    @servicio.Precio.Value.ToString(
                                        "N2",
                                        CultureInfo.InvariantCulture)

                                </div>
                            }
                            else
                            {
                                <div class="service-price">

                                    <small>
                                        PRECIO
                                    </small>

                                    A consultar

                                </div>
                            }


                            @if (!string.IsNullOrWhiteSpace(agendarUrl))
                            {
                                <a
                                    href="@agendarUrl"
                                    class="service-book">

                                    💬

                                    Hablar y agendar

                                </a>
                            }

                        </article>
                    }

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        ✨
                    </div>

                    <h4>
                        Próximamente
                    </h4>

                    <p>
                        Esta profesional todavía está
                        preparando sus servicios.
                    </p>

                </div>
            }

        </section>


        <!-- ====================================================
             INFORMACIÓN
        ===================================================== -->

        <section
            id="informacion"
            class="section">

            <div class="section-heading">

                <div>

                    <div class="section-kicker">
                        ✨ Descubre más
                    </div>

                    <h2 class="section-title">
                        Conoce el espacio
                    </h2>

                    <div class="section-subtitle">
                        Todo lo que necesitas saber antes de
                        contactar o reservar.
                    </div>

                </div>

            </div>


            <div class="about-grid">


                <!-- INFORMACIÓN -->

                <div class="info-card">

                    <div class="info-card-title">
                        💎 Información
                    </div>


                    <div class="info-row">

                        <div class="info-icon">
                            ✨
                        </div>

                        <div>

                            <div class="info-label">
                                Negocio
                            </div>

                            <div class="info-value">
                                @nombreNegocio
                            </div>

                        </div>

                    </div>


                    <div class="info-row">

                        <div class="info-icon">
                            👤
                        </div>

                        <div>

                            <div class="info-label">
                                Profesional
                            </div>

                            <div class="info-value">
                                @nombreProfesional
                            </div>

                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(
                        manicurista?.TelefonoNegocio))
                    {
                        <div class="info-row">

                            <div class="info-icon">
                                📞
                            </div>

                            <div>

                                <div class="info-label">
                                    Contacto
                                </div>

                                <div class="info-value">
                                    @manicurista.TelefonoNegocio
                                </div>

                            </div>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(direccion))
                    {
                        <div class="info-row">

                            <div class="info-icon">
                                📍
                            </div>

                            <div>

                                <div class="info-label">
                                    Dirección
                                </div>

                                <div class="info-value">
                                    @direccion
                                </div>

                            </div>

                        </div>
                    }

                </div>


                <!-- REDES -->

                <div class="info-card social-card">

                    <div class="info-card-title">
                        💖 Encuéntrala también
                    </div>


                    <div class="social-buttons">

                        @if (!string.IsNullOrWhiteSpace(
                            usuario?.Instagram))
                        {
                            <a
                                href="@usuario.Instagram"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="social-button">

                                📸

                                Instagram

                            </a>
                        }


                        @if (!string.IsNullOrWhiteSpace(
                            usuario?.TikTok))
                        {
                            <a
                                href="@usuario.TikTok"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="social-button">

                                🎵

                                TikTok

                            </a>
                        }


                        @if (!string.IsNullOrWhiteSpace(
                            usuario?.Facebook))
                        {
                            <a
                                href="@usuario.Facebook"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="social-button">

                                📘

                                Facebook

                            </a>
                        }


                        @if (!string.IsNullOrWhiteSpace(
                            whatsappUrl))
                        {
                            <a
                                href="@whatsappUrl"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="social-button">

                                💬

                                WhatsApp

                            </a>
                        }

                    </div>

                </div>

            </div>

        </section>


        <!-- ====================================================
             PORTAFOLIO
        ===================================================== -->

        <section class="section">

            <div class="section-heading">

                <div>

                    <div class="section-kicker">
                        💎 Trabajo real
                    </div>

                    <h2 class="section-title">
                        Portafolio
                    </h2>

                    <div class="section-subtitle">
                        Inspírate con algunos de los trabajos
                        publicados por esta profesional.
                    </div>

                </div>


                @if (totalModelos > 0)
                {
                    <div class="section-count">
                        @totalModelos trabajos
                    </div>
                }

            </div>


            @if (modelos.Any())
            {
                <div class="portfolio-grid">

                    @foreach (var m in modelos)
                    {
                        <article class="portfolio-card">

                            @if (m.EsVideo)
                            {
                                <video
                                    class="portfolio-media"
                                    controls
                                    preload="metadata"
                                    playsinline>

                                    <source
                                        src="@m.ImagenSegura"
                                        type="video/mp4" />

                                </video>

                                <div class="portfolio-badge">
                                    🎬 VIDEO
                                </div>
                            }
                            else
                            {
                                <img
                                    src="@m.ImagenSegura"
                                    class="portfolio-media"
                                    alt="@m.Nombre"
                                    loading="lazy"
                                    onerror="this.onerror=null;this.src='/uploads/default-modelo.png';"
                                />

                                <div class="portfolio-badge">
                                    ✨ TRABAJO
                                </div>
                            }


                            @if (m.Precio.HasValue)
                            {
                                <div class="portfolio-price">

                                    RD$
                                    @m.Precio.Value.ToString(
                                        "N0",
                                        CultureInfo.InvariantCulture)

                                </div>
                            }


                            <div class="portfolio-overlay">

                                <div class="portfolio-info">

                                    <div class="portfolio-name">
                                        @m.Nombre
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                        m.Descripcion))
                                    {
                                        <div class="portfolio-description">
                                            @m.Descripcion
                                        </div>
                                    }

                                </div>

                            </div>

                        </article>
                    }

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        💎
                    </div>

                    <h4>
                        El portafolio está creciendo
                    </h4>

                    <p>
                        Aquí aparecerán los próximos trabajos
                        publicados por esta profesional.
                    </p>

                </div>
            }

        </section>


        <!-- ====================================================
             PUBLICACIONES
        ===================================================== -->

        <section class="section">

            <div class="section-heading">

                <div>

                    <div class="section-kicker">
                        🔥 Actualizaciones
                    </div>

                    <h2 class="section-title">
                        Últimas publicaciones
                    </h2>

                    <div class="section-subtitle">
                        Mira lo más reciente de
                        @nombreNegocio.
                    </div>

                </div>


                @if (totalPublicaciones > 0)
                {
                    <div class="section-count">
                        @totalPublicaciones posts
                    </div>
                }

            </div>


            @if (feed.Any())
            {
                <div class="feed-layout">

                    @foreach (var p in feed)
                    {
                        var postFoto =
                            p.Usuario?.FotoPerfilUrl
                            ?? fotoPerfil
                            ?? "/img/user-default.png";


                        <article class="post-card">

                            <div class="post-header">

                                <img
                                    src="@postFoto"
                                    class="post-avatar"
                                    alt="@nombreProfesional"
                                    loading="lazy"
                                    onerror="this.onerror=null;this.src='/img/user-default.png';"
                                />

                                <div>

                                    <div class="post-user">
                                        @(p.Usuario?.Nombre
                                            ?? nombreProfesional)
                                    </div>

                                    <div class="post-business">
                                        ✨ @nombreNegocio
                                    </div>

                                </div>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(
                                p.MediaUrl))
                            {
                                <div class="post-media-wrap">

                                    @if ((p.TipoMedia ?? "")
                                        .ToLower()
                                        .Contains("video"))
                                    {
                                        <video
                                            class="post-video"
                                            controls
                                            preload="metadata"
                                            playsinline>

                                            <source
                                                src="@p.MediaUrl"
                                                type="video/mp4" />

                                        </video>
                                    }
                                    else
                                    {
                                        <img
                                            src="@p.MediaUrl"
                                            class="post-media"
                                            alt="Publicación de @nombreNegocio"
                                            loading="lazy"
                                            onerror="this.style.display='none';"
                                        />
                                    }

                                </div>
                            }


                            @if (!string.IsNullOrWhiteSpace(
                                p.Texto))
                            {
                                <div class="post-body">

                                    <p class="post-text">
                                        @p.Texto
                                    </p>

                                </div>
                            }

                        </article>
                    }

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        📸
                    </div>

                    <h4>
                        Aquí comenzará la historia
                    </h4>

                    <p>
                        Las próximas novedades de
                        @nombreNegocio aparecerán aquí.
                    </p>

                </div>
            }

        </section>


        <!-- ====================================================
             UBICACIÓN
        ===================================================== -->

        <section
            id="ubicacion"
            class="section">

            <div class="section-heading">

                <div>

                    <div class="section-kicker">
                        📍 Encuentra tu próximo lugar favorito
                    </div>

                    <h2 class="section-title">
                        Ubicación
                    </h2>

                    <div class="section-subtitle">
                        Visita @nombreNegocio.
                    </div>

                </div>

            </div>


            <div class="info-card map-card">

                @if (ubicacionActiva &&
                     latitud.HasValue &&
                     longitud.HasValue)
                {
                    <div class="map-header">

                        <div class="info-card-title">
                            📍 Estamos aquí
                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                            direccion))
                        {
                            <div class="section-subtitle">
                                @direccion
                            </div>
                        }

                    </div>


                    <iframe
                        class="map-frame"
                        loading="lazy"
                        allowfullscreen
                        referrerpolicy="no-referrer-when-downgrade"
                        src="https://www.google.com/maps?q=@latitud.Value.ToString(CultureInfo.InvariantCulture),@longitud.Value.ToString(CultureInfo.InvariantCulture)&output=embed">
                    </iframe>


                    @if (!string.IsNullOrWhiteSpace(mapaUrl))
                    {
                        <div class="map-actions">

                            <a
                                href="@mapaUrl"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="map-open">

                                🧭
                                Abrir en Google Maps

                            </a>

                        </div>
                    }
                }
                else
                {
                    <div class="map-placeholder">

                        <div class="map-placeholder-icon">
                            📍
                        </div>

                        <h4>
                            Ubicación privada
                        </h4>

                        <p>
                            Este espacio de belleza todavía
                            no ha habilitado su ubicación pública.
                        </p>

                    </div>
                }

            </div>

        </section>


        <!-- ====================================================
             CTA FINAL
        ===================================================== -->

        @if (!string.IsNullOrWhiteSpace(agendarUrl))
        {
            <section class="final-cta">

                <h3>
                    ✨ ¿Lista para tu próxima experiencia?
                </h3>

                <p>
                    Habla directamente con
                    @nombreProfesional,
                    conoce la disponibilidad y coordina
                    tu próxima cita de belleza.
                </p>

                <a
                    href="@agendarUrl"
                    class="final-cta-button">

                    💬

                    Hablar y agendar

                </a>

            </section>
        }

    </main>


    <!-- ========================================================
         MOBILE CTA
    ========================================================= -->

   @if (!string.IsNullOrWhiteSpace(whatsappUrl))
{
    <div class="mobile-book-bar">

        <a
            href="@whatsappUrl"
            class="mobile-book-button"
            target="_blank"
            rel="noopener noreferrer">

            <span class="mobile-book-icon">💬</span>

            <span>
                <strong>Hablar y agendar</strong>
                <small>Chatea directamente con la profesional</small>
            </span>

            <span class="mobile-book-arrow">→</span>

        </a>

    </div>
}